---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import exams from '../../data/exams.json';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.data.category === 'exam-details')
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const categories = [
  { key: 'central', label: 'SSC & Central' },
  { key: 'entrance', label: 'NTA & Entrance' },
  { key: 'railway', label: 'Railway' },
  { key: 'banking', label: 'Banking' },
  { key: 'state', label: 'State' },
  { key: 'judiciary', label: 'Court & Judiciary' },
  { key: 'police', label: 'Police & Defence' }
];

const firstRelated = (p) => p.data.relatedExam
  || (p.data.relatedExams && p.data.relatedExams.length ? p.data.relatedExams[0] : null);
const catOf = (p) => {
  const e = exams.find((x) => x.slug === firstRelated(p));
  return e ? e.category : 'other';
};

const grouped = categories
  .map((c) => ({ ...c, items: posts.filter((p) => catOf(p) === c.key) }))
  .filter((c) => c.items.length > 0);

const key = (p) => [p.data.title, p.data.description, p.data.relatedExam]
  .concat(p.data.relatedExams || []).filter(Boolean).join(' ').toLowerCase();
---
<BaseLayout
  title="Exam Details: Syllabus, Pattern, Salary & Eligibility | Form Setu"
  description="Full details for Indian government exams, including syllabus, exam pattern, salary, eligibility and competition.">

  <nav class="mb-4 text-xs text-muted">
    <a href="/" class="hover:text-navy-700">Home</a>
    <span class="mx-1">/</span>
    <span class="text-ink">Exams</span>
  </nav>

  <h1 class="text-2xl font-bold text-navy-900 sm:text-3xl">Exam details</h1>
  <p class="mt-2 text-sm text-muted">
    Syllabus, exam pattern, salary, eligibility and how tough the competition is,
    for each exam we cover.
  </p>

  {posts.length > 3 && (
    <div class="relative mt-5">
      <input type="search" id="edSearch" placeholder="Search exams..."
        class="w-full rounded-lg border-2 border-navy-600 bg-white px-4 py-2.5 pr-11 text-base shadow-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-100" />
      <svg viewBox="0 0 24 24" class="pointer-events-none absolute right-3.5 top-1/2 h-5 w-5 -translate-y-1/2 fill-none stroke-navy-600" stroke-width="2.2" aria-hidden="true">
        <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" stroke-linecap="round" />
      </svg>
    </div>
  )}

  {posts.length === 0 && (
    <div class="mt-8 rounded-lg border-2 border-amber-500 bg-amber-100 px-4 py-4">
      <p class="text-sm font-bold text-navy-900">Nothing published yet.</p>
      <p class="mt-1 text-sm text-ink">Detailed exam guides are on the way. Meanwhile, every exam page has the photo and signature requirements.</p>
      <a href="/exams/" class="mt-3 inline-block rounded-md bg-amber-600 px-4 py-2 text-sm font-bold text-white hover:bg-amber-500">Browse exams →</a>
    </div>
  )}

  {grouped.map((c) => (
    <section class="mt-8 ed-group">
      <h2 class="mb-3 text-lg font-bold text-navy-900">{c.label}</h2>
      <div class="space-y-2">
        {c.items.map((p) => (
          <a href={"/blog/" + p.id + "/"} data-search={key(p)}
             class="ed-card block rounded-lg border-2 border-line bg-white px-4 py-3 shadow-sm transition hover:border-amber-500 hover:bg-amber-100">
            <span class="block text-base font-bold leading-snug text-navy-900">{p.data.title}</span>
            <span class="mt-1 block text-sm text-muted">{p.data.description}</span>
            <span class="mt-1.5 inline-block text-xs font-bold text-amber-600">Read the full details →</span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <p id="edNone" class="mt-6 text-sm text-muted" hidden>No exam matched that search.</p>

</BaseLayout>

<script>
  const s = document.getElementById('edSearch');
  if (s) {
    const cards = document.querySelectorAll('.ed-card');
    const groups = document.querySelectorAll('.ed-group');
    const none = document.getElementById('edNone');
    s.addEventListener('input', () => {
      const term = s.value.trim().toLowerCase();
      let vis = 0;
      cards.forEach((c) => {
        const hay = c.getAttribute('data-search') || '';
        const match = term.split(/\s+/).filter(Boolean).every((w) => hay.includes(w));
        c.hidden = !match;
        if (match) vis++;
      });
      groups.forEach((g) => { g.hidden = g.querySelectorAll('.ed-card:not([hidden])').length === 0; });
      none.hidden = vis > 0;
    });
  }
</script>