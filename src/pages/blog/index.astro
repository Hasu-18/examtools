---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const labels = {
  notification: 'Notification',
  guide: 'How to apply',
  problem: 'Common problems',
  books: 'Books'
};

const groups = ['notification', 'guide', 'problem', 'books'].map((key) => ({
  key,
  label: labels[key],
  items: posts.filter((p) => p.data.category === key)
}));

const fmt = (d) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
const isOpen = (p) => p.data.closes && p.data.closes.getTime() >= Date.now();
const openNow = posts.filter(isOpen);
---
<BaseLayout
  title="Exam Notifications, Guides & Updates | FormSetu"
  description="Latest Indian government exam notifications, application guides, and answers to common form filling problems.">

  <nav class="mb-4 text-xs text-muted">
    <a href="/" class="hover:text-navy-700">Home</a>
    <span class="mx-1">/</span>
    <span class="text-ink">Notifications</span>
  </nav>

  <h1 class="text-2xl font-bold text-navy-900 sm:text-3xl">Notifications &amp; guides</h1>
  <p class="mt-2 text-sm text-muted">
    Exam notifications, application walkthroughs, and fixes for the problems that
    get forms rejected.
  </p>

  {posts.length === 0 && (
    <div class="mt-8 rounded-lg border-2 border-amber-500 bg-amber-100 px-4 py-4">
      <p class="text-sm font-bold text-navy-900">Nothing published yet.</p>
      <p class="mt-1 text-sm text-ink">
        Our first notification guides are on the way. In the meantime, the exam
        pages have the photo and signature requirements you need.
      </p>
      <a href="/exams/" class="mt-3 inline-block rounded-md bg-amber-600 px-4 py-2 text-sm font-bold text-white hover:bg-amber-500">
        Browse exams →
      </a>
    </div>
  )}

  {openNow.length > 0 && (
    <section class="mt-8">
      <h2 class="mb-3 text-lg font-bold text-navy-900">Forms open right now</h2>
      <div class="space-y-2">
        {openNow.map((p) => (
          <a href={"/blog/" + p.id + "/"}
             class="block rounded-lg border-2 border-pass bg-pass-bg px-4 py-3 transition hover:border-amber-500">
            <span class="inline-block rounded bg-pass px-2 py-0.5 text-xs font-bold text-white">
              {p.data.status || 'Form open'}
            </span>
            <span class="mt-1.5 block text-base font-bold leading-snug text-navy-900">{p.data.title}</span>
            <span class="mt-1 block text-xs font-semibold text-pass">
              Closes {fmt(p.data.closes)}
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  {groups.map((g) => g.items.length > 0 && (
    <section class="mt-10">
      <h2 class="mb-3 text-lg font-bold text-navy-900">{g.label}</h2>
      <div class="space-y-3">
        {g.items.map((p) => (
          <a href={"/blog/" + p.id + "/"}
             class="block rounded-lg border-2 border-line bg-white px-4 py-4 shadow-sm transition hover:border-amber-500 hover:bg-amber-100">
            <span class="block text-base font-bold leading-snug text-navy-900">{p.data.title}</span>
            <span class="mt-1.5 block text-sm leading-snug text-muted">{p.data.description}</span>
            <span class="mt-2 block text-xs text-muted">
              {fmt(p.data.date)}
              {p.data.updated && <span class="font-semibold text-navy-700"> · updated {fmt(p.data.updated)}</span>}
            </span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="mt-10 rounded-lg border-2 border-amber-500 bg-amber-100 px-4 py-4">
    <p class="text-sm font-bold text-navy-900">Need a photo or signature resized?</p>
    <p class="mt-1 text-sm text-ink">
      Free, works in your browser, nothing is uploaded.
    </p>
    <a href="/tools/photo-resizer/" class="mt-3 inline-block rounded-md bg-amber-600 px-4 py-2 text-sm font-bold text-white hover:bg-amber-500">
      Open the resizer →
    </a>
  </section>

</BaseLayout>