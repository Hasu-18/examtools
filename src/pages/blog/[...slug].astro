---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageResizer from '../../components/ImageResizer.astro';
import AffiliateBlock from '../../components/AffiliateBlock.astro';
import { getCollection, render } from 'astro:content';
import exams from '../../data/exams.json';
import products from '../../data/products.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const fmt = (x) => x.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

const labels = {
  notification: 'Notification',
  guide: 'How to apply',
  problem: 'Common problems',
  books: 'Books'
};

const exam = d.relatedExam ? exams.find((e) => e.slug === d.relatedExam) : null;
const postProducts = d.productKey ? (products[d.productKey] || []) : [];
const pageUrl = Astro.url.href;

const all = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const maxVac = d.vacancyHistory
  ? Math.max(...d.vacancyHistory.map((v) => v.vacancies))
  : 0;

const stillOpen = d.closes && d.closes.getTime() >= Date.now();
---
<BaseLayout title={d.title + ' | FormSetu'} description={d.description}>

  <nav class="mb-4 text-xs text-muted">
    <a href="/" class="hover:text-navy-700">Home</a>
    <span class="mx-1">/</span>
    <a href="/blog/" class="hover:text-navy-700">Notifications</a>
    <span class="mx-1">/</span>
    <span class="text-ink">{labels[d.category]}</span>
  </nav>

  <article>

    <span class="inline-block rounded bg-navy-100 px-2.5 py-1 text-xs font-bold text-navy-700">
      {labels[d.category]}
    </span>

    <h1 class="mt-3 text-2xl font-bold leading-tight text-navy-900 sm:text-3xl">{d.title}</h1>
    <p class="mt-2 text-base text-muted">{d.description}</p>

    <p class="mt-3 text-xs text-muted">
      Published {fmt(d.date)}
      {d.updated && <span class="font-semibold text-navy-700"> · updated {fmt(d.updated)}</span>}
    </p>

    {stillOpen && (
      <div class="mt-4 rounded-lg border-2 border-pass bg-pass-bg px-4 py-3">
        <span class="inline-block rounded bg-pass px-2 py-0.5 text-xs font-bold text-white">
          {d.status || 'Form open'}
        </span>
        <p class="mt-1.5 text-sm font-bold text-navy-900">
          Applications close on {fmt(d.closes)}
        </p>
      </div>
    )}

    {d.importantDates && d.importantDates.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-3 text-lg font-bold text-navy-900">Important dates</h2>
        <table class="w-full border-collapse text-sm">
          <tbody>
            {d.importantDates.map((row) => (
              <tr class="border-b border-line">
                <th class="w-1/2 py-2.5 text-left font-medium text-muted">{row.label}</th>
                <td class="py-2.5 font-bold text-navy-900">
                  {row.link
                    ? <a href={row.link} rel="nofollow noopener" target="_blank" class="text-amber-600 underline">{row.value} ↗</a>
                    : row.value}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}

    {d.officialLinks && d.officialLinks.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-3 text-lg font-bold text-navy-900">Official links</h2>
        <div class="grid gap-2 sm:grid-cols-2">
          {d.officialLinks.map((l) => (
            <a href={l.url} rel="nofollow noopener" target="_blank"
               class="rounded-lg border-2 border-line bg-white px-3 py-3 text-sm font-bold text-navy-800 shadow-sm transition hover:border-amber-500 hover:bg-amber-100">
              {l.label} ↗
            </a>
          ))}
        </div>
        <p class="mt-2 text-xs text-muted">
          These links go to the official website. Always confirm details there.
        </p>
      </section>
    )}

    {d.vacancyHistory && d.vacancyHistory.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-1 text-lg font-bold text-navy-900">Vacancy history</h2>
        <p class="mb-4 text-sm text-muted">How this year compares with previous cycles.</p>

        <div class="space-y-3">
          {d.vacancyHistory.map((v) => (
            <div>
              <div class="flex items-baseline justify-between text-sm">
                <span class="font-bold text-navy-900">{v.year}</span>
                <span class="font-bold text-navy-900">{v.vacancies.toLocaleString('en-IN')}</span>
              </div>
              <div class="mt-1 h-6 w-full overflow-hidden rounded bg-navy-100">
                <div class="h-full rounded bg-amber-500"
                     style={`width:${Math.max(3, Math.round((v.vacancies / maxVac) * 100))}%`}></div>
              </div>
              {v.applicants && (
                <p class="mt-1 text-xs text-muted">
                  {v.applicants.toLocaleString('en-IN')} applicants ·
                  about {Math.round(v.applicants / v.vacancies).toLocaleString('en-IN')} per vacancy
                </p>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <div class="post-body mt-8">
      <Content />
    </div>

    {exam && (
      <section class="mt-10">
        <h2 class="mb-3 text-lg font-bold text-navy-900">
          Resize your {exam.name} documents
        </h2>

        {exam.photo && (
          <div class="mb-6">
            <ImageResizer label="Photo" fileName="photo"
              widthPx={exam.photo.widthPx} heightPx={exam.photo.heightPx}
              minKB={exam.photo.minKB} maxKB={exam.photo.maxKB} />
          </div>
        )}

        {exam.signature && (
          <ImageResizer label="Signature" fileName="signature"
            widthPx={exam.signature.widthPx} heightPx={exam.signature.heightPx}
            minKB={exam.signature.minKB} maxKB={exam.signature.maxKB} />
        )}

        <a href={"/exams/" + exam.slug + "/"}
           class="mt-4 inline-block rounded-md bg-navy-800 px-4 py-2 text-sm font-bold text-white hover:bg-navy-700">
          Full {exam.name} requirements →
        </a>
      </section>
    )}

    {all.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-3 text-lg font-bold text-navy-900">Related updates</h2>
        <div class="space-y-2">
          {all.map((p) => (
            <a href={"/blog/" + p.id + "/"}
               class="block rounded-lg border-2 border-line bg-white px-4 py-3 shadow-sm transition hover:border-amber-500 hover:bg-amber-100">
              <span class="block text-sm font-bold leading-snug text-navy-900">{p.data.title}</span>
              <span class="mt-1 block text-xs text-muted">{fmt(p.data.date)}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <AffiliateBlock products={postProducts} />

    <section class="mt-10 border-t border-line pt-6">
      <h2 class="mb-3 text-sm font-bold uppercase tracking-wide text-navy-700">Share this</h2>
      <div class="flex flex-wrap gap-2 text-sm">
        <a target="_blank" rel="noopener"
           href={`https://wa.me/?text=${encodeURIComponent(d.title + ' ' + pageUrl)}`}
           class="rounded-md bg-[#25D366] px-4 py-2 font-semibold text-white">WhatsApp</a>
        <a target="_blank" rel="noopener"
           href={`https://t.me/share/url?url=${encodeURIComponent(pageUrl)}`}
           class="rounded-md bg-[#0088cc] px-4 py-2 font-semibold text-white">Telegram</a>
        <button type="button" data-copy={pageUrl}
           class="copy-link rounded-md border border-line px-4 py-2 font-semibold text-navy-700 hover:bg-surface">
          Copy link
        </button>
      </div>
    </section>

  </article>

</BaseLayout>

<style is:global>
  .post-body { font-size: 1rem; line-height: 1.75; color: #111827; }
  .post-body h2 { font-size: 1.15rem; font-weight: 700; color: #0b1f35; margin: 2rem 0 .75rem; }
  .post-body h3 { font-size: 1rem; font-weight: 700; color: #0b1f35; margin: 1.5rem 0 .5rem; }
  .post-body p { margin: 0 0 1rem; }
  .post-body ul, .post-body ol { margin: 0 0 1rem; padding-left: 1.35rem; }
  .post-body li { margin-bottom: .4rem; }
  .post-body a { color: #d97706; font-weight: 600; text-decoration: underline; }
  .post-body strong { font-weight: 700; color: #0b1f35; }
  .post-body table { width: 100%; border-collapse: collapse; margin: 0 0 1.25rem; font-size: .95rem; }
  .post-body th, .post-body td { border-bottom: 1px solid #e5e7eb; padding: .6rem .4rem; text-align: left; }
  .post-body th { font-weight: 600; color: #4b5563; }
  .post-body blockquote { border-left: 4px solid #f59e0b; background: #fef3c7; padding: .75rem 1rem; margin: 0 0 1.25rem; border-radius: 6px; }
  .post-body blockquote p:last-child { margin: 0; }
</style>

<script>
  document.querySelectorAll('.copy-link').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-copy');
      if (!url) return;
      await navigator.clipboard.writeText(url);
      const original = btn.textContent;
      btn.textContent = 'Copied ✓';
      setTimeout(() => { btn.textContent = original; }, 1500);
    });
  });
</script>