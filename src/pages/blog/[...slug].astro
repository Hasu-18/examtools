---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageResizer from '../../components/ImageResizer.astro';
import AffiliateBlock from '../../components/AffiliateBlock.astro';
import { getCollection, render } from 'astro:content';
import exams from '../../data/exams.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const fmt = (x) => x.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

const labels = {
  'exam-details': 'Exam details',
  notification: 'Notification',
  guide: 'How to apply',
  problem: 'Common problems',
  books: 'Books'
};

const categoryLabel = labels[d.category] || d.category;

const rawRelated = (d.relatedExam ? [d.relatedExam] : []).concat(d.relatedExams || []);
const relatedSlugs = rawRelated.filter((s, i) => rawRelated.indexOf(s) === i);
const relatedExamObjs = relatedSlugs
  .map((s) => exams.find((e) => e.slug === s))
  .filter((e) => !!e);
const exam = relatedExamObjs.length ? relatedExamObjs[0] : null;
const resizerBlocks = relatedExamObjs.map((e) => ({
  slug: e.slug,
  name: e.name,
  heading: 'Resize your ' + e.name + ' documents',
  href: '/exams/' + e.slug + '/',
  linkText: 'Open the full ' + e.name + ' resizer page →',
  photo: e.photo,
  signature: e.signature,
  photoUnit: (e.photo && e.photo.unit) || 'px',
  photoDpi: (e.photo && e.photo.dpi) || 300,
  signUnit: (e.signature && e.signature.unit) || 'px',
  signDpi: (e.signature && e.signature.dpi) || 300
}));

const fallbackProducts = (d.products && d.products.length)
  ? d.products
  : relatedSlugs;

const pageUrl = Astro.url.href;

const all = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const sameExam = relatedSlugs.length
  ? all.filter((p) => {
      const other = (p.data.relatedExam ? [p.data.relatedExam] : []).concat(p.data.relatedExams || []);
      return other.some((s) => relatedSlugs.indexOf(s) !== -1);
    })
  : [];

const wantCategory = d.category === 'notification' ? 'exam-details' : 'notification';

const crossPosts = sameExam
  .filter((p) => p.data.category === wantCategory)
  .map((p) => {
    const isOpen = !!(p.data.closes && p.data.closes.getTime() >= Date.now());
    return {
      href: '/blog/' + p.id + '/',
      title: p.data.title,
      description: p.data.description,
      isOpen: isOpen,
      status: p.data.status || 'Form open',
      cls: isOpen
        ? 'block rounded-lg border-2 border-pass bg-pass-bg px-4 py-3 shadow-sm transition hover:border-amber-500'
        : 'block rounded-lg border-2 border-line bg-white px-4 py-3 shadow-sm transition hover:border-amber-500'
    };
  });

const crossHeading = exam
  ? (wantCategory === 'notification'
      ? exam.name + ' notifications'
      : 'Full ' + exam.name + ' exam details')
  : 'Related';

const crossHrefs = crossPosts.map((c) => c.href);

const otherPosts = all
  .filter((p) => crossHrefs.indexOf('/blog/' + p.id + '/') === -1)
  .slice(0, 4)
  .map((p) => ({
    href: '/blog/' + p.id + '/',
    title: p.data.title,
    label: labels[p.data.category] || p.data.category,
    dateText: fmt(p.data.date)
  }));

const maxVac = d.vacancyHistory ? Math.max(...d.vacancyHistory.map((v) => v.vacancies)) : 0;
const salaryVals = (d.salary && d.salary.posts || []).map((p) => p.amount || 0);
const maxPay = salaryVals.length ? Math.max(...salaryVals) : 0;

const RECENT_CLOSE_MS = 30 * 86400000;
const nowMs = Date.now();
const stillOpen = d.closes && d.closes.getTime() >= nowMs;
const closedRecently = !!(d.closes && !stillOpen && (nowMs - d.closes.getTime()) < RECENT_CLOSE_MS);
const closedOnLabel = d.closes ? 'Closed on ' + fmt(d.closes) : '';

const waText = encodeURIComponent(d.title + ' ' + pageUrl);
const tgUrl = encodeURIComponent(pageUrl);
---
<BaseLayout title={d.title + ' | Form Setu'} description={d.description}>

  <nav class="mb-4 text-xs text-muted">
    <a href="/" class="hover:text-navy-700">Home</a>
    <span class="mx-1">/</span>
    <a href="/blog/" class="hover:text-navy-700">Blog</a>
    <span class="mx-1">/</span>
    <span class="text-ink">{categoryLabel}</span>
  </nav>

  <article>

    <span class="inline-block rounded bg-navy-100 px-2.5 py-1 text-xs font-bold text-navy-700">
      {categoryLabel}
    </span>

    <h1 class="mt-3 text-2xl font-bold leading-tight text-navy-900 sm:text-3xl">{d.title}</h1>
    <p class="mt-2 text-base text-muted">{d.description}</p>

    <p class="mt-3 text-xs text-muted">
      Published {fmt(d.date)}
      {d.updated && <span class="font-semibold text-navy-700"> · updated {fmt(d.updated)}</span>}
    </p>

    {stillOpen && (
      <div class="mt-4 rounded-lg border-2 border-pass bg-pass-bg px-4 py-3">
        <span class="inline-flex items-center gap-1.5 rounded bg-pass px-2 py-0.5 text-xs font-bold text-white">
          <span class="live-dot"></span>{d.status || 'Form open'}
        </span>
        <p class="mt-1.5 text-sm font-bold text-navy-900">Applications close on {fmt(d.closes)}</p>
      </div>
    )}

    {closedRecently && (
      <p class="mt-4 inline-block rounded-lg border-2 border-amber-500 bg-amber-100 px-3 py-1.5 text-sm font-bold text-navy-900">
        {closedOnLabel}
      </p>
    )}

    {d.cover && (
      <figure class="mt-5">
        <img src={d.cover} alt={d.coverAlt || ''} width="1200" height="630"
             class="w-full rounded-lg border border-line object-cover" />
        {d.coverCredit && <figcaption class="mt-1.5 text-xs text-muted">{d.coverCredit}</figcaption>}
      </figure>
    )}

    {d.quickFacts && d.quickFacts.length > 0 && (
      <div class="mt-6 grid grid-cols-2 gap-2 sm:grid-cols-4 sm:gap-3">
        {d.quickFacts.map((f) => (
          <div class="rounded-lg border border-line bg-surface px-3 py-3 text-center">
            <p class="text-base font-bold leading-tight text-navy-900 sm:text-lg">{f.value}</p>
            <p class="mt-1 text-[11px] font-medium leading-snug text-muted">{f.label}</p>
          </div>
        ))}
      </div>
    )}

    {d.importantDates && d.importantDates.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-3 text-lg font-bold text-navy-900">Important dates</h2>
        <div class="overflow-hidden rounded-lg border border-line">
          {d.importantDates.map((row) => (
            <div class="flex items-baseline justify-between gap-3 border-b border-line px-4 py-2.5 text-sm last:border-0">
              <span class="font-medium text-muted">{row.label}</span>
              <span class="text-right font-bold text-navy-900">{row.value}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {d.officialLinks && d.officialLinks.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-3 text-lg font-bold text-navy-900">Official links</h2>
        <div class="grid gap-2 sm:grid-cols-2">
          {d.officialLinks.map((l) => (
            <a href={l.url} rel="nofollow noopener" target="_blank"
               class="rounded-lg border-2 border-line bg-white px-3 py-3 text-sm font-bold text-navy-800 shadow-sm transition hover:border-amber-500 hover:bg-amber-100">
              {l.label} ↗
            </a>
          ))}
        </div>
        <p class="mt-2 text-xs text-muted">These links go to the official website. Always confirm details there.</p>
      </section>
    )}

    {d.eligibility && d.eligibility.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-3 text-lg font-bold text-navy-900">Eligibility at a glance</h2>
        <div class="grid gap-2 sm:grid-cols-2">
          {d.eligibility.map((e) => (
            <div class="rounded-lg border border-line border-l-4 border-l-navy-600 bg-surface px-3 py-2.5">
              <p class="text-xs font-semibold uppercase tracking-wide text-navy-700">{e.label}</p>
              <p class="mt-0.5 text-sm font-medium text-ink">{e.value}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {d.examPattern && (
      <section class="mt-8">
        <h2 class="mb-1 text-lg font-bold text-navy-900">Exam pattern</h2>
        {d.examPattern.note && <p class="mb-3 text-sm text-muted">{d.examPattern.note}</p>}

        <div class="overflow-hidden rounded-lg border border-line">
          <div class="flex items-center justify-between bg-navy-900 px-4 py-2 text-xs font-bold uppercase tracking-wide text-white">
            <span>Section</span>
            <span class="flex gap-6"><span class="w-16 text-right">Questions</span><span class="w-14 text-right">Marks</span></span>
          </div>
          {d.examPattern.sections.map((s) => (
            <div class="flex items-center justify-between border-b border-line px-4 py-2.5 text-sm last:border-0">
              <span class="font-medium text-ink">{s.name}</span>
              <span class="flex gap-6 font-bold text-navy-900">
                <span class="w-16 text-right">{s.questions}</span>
                <span class="w-14 text-right">{s.marks}</span>
              </span>
            </div>
          ))}
        </div>

        <div class="mt-3 grid grid-cols-3 gap-2">
          {d.examPattern.totalMarks && (
            <div class="rounded-lg bg-navy-100 px-3 py-2.5 text-center">
              <p class="text-sm font-bold text-navy-900">{d.examPattern.totalMarks}</p>
              <p class="text-[11px] text-muted">Total marks</p>
            </div>
          )}
          {d.examPattern.duration && (
            <div class="rounded-lg bg-navy-100 px-3 py-2.5 text-center">
              <p class="text-sm font-bold text-navy-900">{d.examPattern.duration}</p>
              <p class="text-[11px] text-muted">Duration</p>
            </div>
          )}
          {d.examPattern.negativeMarking && (
            <div class="rounded-lg bg-amber-100 px-3 py-2.5 text-center">
              <p class="text-sm font-bold text-navy-900">{d.examPattern.negativeMarking}</p>
              <p class="text-[11px] text-muted">Negative marking</p>
            </div>
          )}
        </div>
      </section>
    )}

    {d.salary && d.salary.posts.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-1 text-lg font-bold text-navy-900">Salary by post</h2>
        {d.salary.note && <p class="mb-3 text-sm text-muted">{d.salary.note}</p>}
        <div class="space-y-3">
          {d.salary.posts.map((p) => (
            <div>
              <div class="flex items-baseline justify-between text-sm">
                <span class="font-medium text-ink">{p.post}</span>
                <span class="font-bold text-navy-900">{p.pay}</span>
              </div>
              {p.amount && maxPay > 0 && (
                <div class="mt-1 h-3 w-full overflow-hidden rounded bg-navy-100">
                  <div class="h-full rounded bg-navy-600" style={'width:' + Math.max(4, Math.round((p.amount / maxPay) * 100)) + '%'}></div>
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    {d.competition && (
      <section class="mt-8">
        <h2 class="mb-3 text-lg font-bold text-navy-900">How tough is it</h2>
        <div class="rounded-lg border-2 border-amber-500 bg-amber-100 px-4 py-4">
          <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
            {d.competition.applicants && (
              <div>
                <p class="text-xl font-bold text-navy-900">{d.competition.applicants}</p>
                <p class="text-xs text-muted">Applicants</p>
              </div>
            )}
            {d.competition.posts && (
              <div>
                <p class="text-xl font-bold text-navy-900">{d.competition.posts}</p>
                <p class="text-xs text-muted">Posts</p>
              </div>
            )}
            {d.competition.ratio && (
              <div>
                <p class="text-xl font-bold text-amber-600">{d.competition.ratio}</p>
                <p class="text-xs text-muted">Competition</p>
              </div>
            )}
          </div>
          {d.competition.note && <p class="mt-3 text-sm text-ink">{d.competition.note}</p>}
        </div>
      </section>
    )}

    {d.vacancyHistory && d.vacancyHistory.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-1 text-lg font-bold text-navy-900">Vacancy history</h2>
        <p class="mb-4 text-sm text-muted">How this year compares with previous cycles.</p>
        <div class="space-y-3">
          {d.vacancyHistory.map((v) => (
            <div>
              <div class="flex items-baseline justify-between text-sm">
                <span class="font-bold text-navy-900">{v.year}</span>
                <span class="font-bold text-navy-900">{v.vacancies.toLocaleString('en-IN')}</span>
              </div>
              <div class="mt-1 h-6 w-full overflow-hidden rounded bg-navy-100">
                <div class="h-full rounded bg-amber-500" style={'width:' + Math.max(3, Math.round((v.vacancies / maxVac) * 100)) + '%'}></div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <div class="post-body mt-8">
      <Content />
    </div>

    {d.faqs && d.faqs.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-4 text-lg font-bold text-navy-900">Common questions</h2>
        <div class="divide-y divide-line rounded-lg border border-line">
          {d.faqs.map((f) => (
            <details class="group px-4 py-3">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-3 text-sm font-bold text-navy-900">
                <span>{f.q}</span>
                <span class="mt-0.5 shrink-0 text-amber-600 transition group-open:rotate-45">+</span>
              </summary>
              <p class="faq-a mt-2 text-sm leading-relaxed text-muted" set:html={f.a}></p>
            </details>
          ))}
        </div>
      </section>
    )}

    {resizerBlocks.map((b) => (
      <section class="mt-10">
        <h2 class="mb-3 text-lg font-bold text-navy-900">{b.heading}</h2>

        {b.photo && (
          <div class="mb-6">
            <ImageResizer label="Photo" fileName="photo"
              widthPx={b.photo.widthPx} heightPx={b.photo.heightPx}
              minKB={b.photo.minKB} maxKB={b.photo.maxKB}
              unit={b.photoUnit} displayW={b.photo.displayWidth}
              displayH={b.photo.displayHeight} dpi={b.photoDpi} />
          </div>
        )}

        {b.signature && (
          <ImageResizer label="Signature" fileName="signature"
            widthPx={b.signature.widthPx} heightPx={b.signature.heightPx}
            minKB={b.signature.minKB} maxKB={b.signature.maxKB}
            unit={b.signUnit} displayW={b.signature.displayWidth}
            displayH={b.signature.displayHeight} dpi={b.signDpi} />
        )}

        <a href={b.href}
           class="mt-4 inline-block rounded-md bg-navy-800 px-4 py-2 text-sm font-bold text-white hover:bg-navy-700">
          {b.linkText}
        </a>
      </section>
    ))}

    <AffiliateBlock groups={fallbackProducts} />

    {crossPosts.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-3 text-lg font-bold text-navy-900">{crossHeading}</h2>
        <div class="space-y-2">
          {crossPosts.map((p) => (
            <a href={p.href} class={p.cls}>
              {p.isOpen && (
                <span class="inline-flex items-center gap-1.5 rounded bg-pass px-2 py-0.5 text-xs font-bold text-white">
                  <span class="live-dot"></span>{p.status}
                </span>
              )}
              <span class="mt-1.5 block text-sm font-bold leading-snug text-navy-900">{p.title}</span>
              <span class="mt-1 block text-xs text-muted">{p.description}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {otherPosts.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-3 text-lg font-bold text-navy-900">More updates</h2>
        <div class="space-y-2">
          {otherPosts.map((p) => (
            <a href={p.href} class="block rounded-lg border-2 border-line bg-white px-4 py-3 shadow-sm transition hover:border-amber-500 hover:bg-amber-100">
              <span class="mb-1 inline-block rounded bg-navy-100 px-2 py-0.5 text-[10px] font-bold uppercase text-navy-700">{p.label}</span>
              <span class="block text-sm font-bold leading-snug text-navy-900">{p.title}</span>
              <span class="mt-1 block text-xs text-muted">{p.dateText}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="mt-10 border-t border-line pt-6">
      <h2 class="mb-3 text-sm font-bold uppercase tracking-wide text-navy-700">Share this</h2>
      <div class="flex flex-wrap gap-2 text-sm">
        <a target="_blank" rel="noopener" href={'https://wa.me/?text=' + waText}
           class="rounded-md bg-[#25D366] px-4 py-2 font-semibold text-white">WhatsApp</a>
        <a target="_blank" rel="noopener" href={'https://t.me/share/url?url=' + tgUrl}
           class="rounded-md bg-[#0088cc] px-4 py-2 font-semibold text-white">Telegram</a>
        <button type="button" data-copy={pageUrl}
           class="copy-link rounded-md border border-line px-4 py-2 font-semibold text-navy-700 hover:bg-surface">
          Copy link
        </button>
      </div>
    </section>

  </article>

</BaseLayout>

<style>
  .live-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    animation: livePulse 1.6s ease-in-out infinite;
  }
  @keyframes livePulse {
    0%, 100% { opacity: 1; }
    50% { opacity: .3; }
  }
  @media (prefers-reduced-motion: reduce) {
    .live-dot { animation: none; }
  }
</style>

<style is:global>
  .faq-a a { color: #d97706; font-weight: 600; text-decoration: underline; }

  .post-body { font-size: 1rem; line-height: 1.75; color: #111827; }
  .post-body h2 { font-size: 1.15rem; font-weight: 700; color: #0b1f35; margin: 2rem 0 .75rem; }
  .post-body h3 { font-size: 1rem; font-weight: 700; color: #0b1f35; margin: 1.5rem 0 .5rem; }
  .post-body p { margin: 0 0 1rem; }
  .post-body ul, .post-body ol { margin: 0 0 1rem; padding-left: 0; list-style: none; }
  .post-body ul li { position: relative; margin-bottom: .55rem; padding-left: 1.4rem; }
  .post-body ul li::before {
    content: "";
    position: absolute;
    left: 0;
    top: .55em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: #f59e0b;
  }
  .post-body ol { counter-reset: step; }
  .post-body ol li {
    position: relative;
    margin-bottom: .55rem;
    padding-left: 1.9rem;
    counter-increment: step;
    line-height: 1.75;
  }
  .post-body ol li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: #0b1f35;
    color: #fff;
    font-size: .72rem;
    font-weight: 700;
    line-height: 1.35rem;
    text-align: center;
  }
  .post-body a { color: #d97706; font-weight: 600; text-decoration: underline; }
  .post-body strong { font-weight: 700; color: #0b1f35; }
  .post-body table { width: 100%; border-collapse: collapse; margin: 0 0 1.25rem; font-size: .95rem; }
  .post-body thead th { background: #0b1f35; color: #fff; font-size: .75rem; text-transform: uppercase; letter-spacing: .03em; }
  .post-body th, .post-body td { border-bottom: 1px solid #e5e7eb; padding: .6rem .5rem; text-align: left; }
  .post-body tbody tr:nth-child(even) { background: #f8fafc; }
  .post-body blockquote { border-left: 4px solid #f59e0b; background: #fef3c7; padding: .75rem 1rem; margin: 0 0 1.25rem; border-radius: 6px; }
  .post-body blockquote p:last-child { margin: 0; }
</style>

<script>
  document.querySelectorAll('.copy-link').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-copy');
      if (!url) return;
      await navigator.clipboard.writeText(url);
      const original = btn.textContent;
      btn.textContent = 'Copied';
      setTimeout(() => { btn.textContent = original; }, 1500);
    });
  });
</script>