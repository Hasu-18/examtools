---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageResizer from '../../components/ImageResizer.astro';
import CombinedResizer from '../../components/CombinedResizer.astro';
import AffiliateBlock from '../../components/AffiliateBlock.astro';
import exams from '../../data/exams.json';

export function getStaticPaths() {
  return exams.map((exam) => ({
    params: { slug: exam.slug },
    props: { exam },
  }));
}

const { exam } = Astro.props;
const isLive = exam.captureMode === 'live';

const title = `${exam.name} Photo & Signature Size ${exam.year}, Exact Requirements`;
const description = exam.photo
  ? `${exam.name} ${exam.year}: photo ${exam.photo.widthPx}×${exam.photo.heightPx} px, ${exam.photo.minKB} to ${exam.photo.maxKB} KB. Signature size and free resizer tool.`
  : `${exam.name} ${exam.year} photo and signature upload requirements, with a free tool to match them exactly.`;

const verified = new Date(exam.lastVerified).toLocaleDateString('en-IN', {
  day: 'numeric', month: 'long', year: 'numeric',
});

const shuffle = (arr) => arr
  .map((v) => [Math.random(), v])
  .sort((a, b) => a[0] - b[0])
  .map((p) => p[1]);

const sameCat = shuffle(
  exams.filter((e) => e.slug !== exam.slug && e.category === exam.category)
).slice(0, 2);

const others = shuffle(
  exams.filter((e) => e.slug !== exam.slug && !sameCat.some((s) => s.slug === e.slug))
).slice(0, 6 - sameCat.length);

const related = [...sameCat, ...others];
const pageUrl = Astro.url.href;

const dim = (b) => {
  if (!b.widthPx || !b.heightPx) return 'Not specified in the notification';
  return (b.unit && b.unit !== 'px' && b.displayWidth)
    ? `${b.displayWidth} × ${b.displayHeight} ${b.unit === 'in' ? 'inch' : b.unit}`
    : `${b.widthPx} × ${b.heightPx} px`;
};
const kb = (b) => `${(b.minKB === null || b.minKB === undefined) ? 0 : b.minKB} to ${(b.maxKB === null || b.maxKB === undefined) ? 0 : b.maxKB} KB`;
const pxNote = (b) => (b.widthPx && b.unit && b.unit !== 'px' && b.displayWidth)
  ? `That is ${b.widthPx} × ${b.heightPx} pixels at ${b.dpi || 300} DPI.`
  : null;
---
<BaseLayout title={title} description={description}>

  <nav class="mb-4 text-xs text-muted">
    <a href="/" class="hover:text-navy-700">Home</a>
    <span class="mx-1">/</span>
    <a href="/exams/" class="hover:text-navy-700">Exams</a>
    <span class="mx-1">/</span>
    <span class="text-ink">{exam.name}</span>
  </nav>

  <h1 class="text-2xl font-bold leading-tight text-navy-900 sm:text-3xl">
    {exam.name} Photo &amp; Signature Size {exam.year}
  </h1>
  <p class="mt-1.5 text-sm text-muted">{exam.fullName}</p>

  <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
    <span class="inline-flex items-center gap-1.5 rounded-full bg-pass-bg px-2.5 py-1 font-semibold text-pass">
      <svg viewBox="0 0 20 20" class="h-3.5 w-3.5 shrink-0 fill-none stroke-current" stroke-width="2.5" aria-hidden="true">
        <path d="M4 10.5l4 4 8-8.5" stroke-linecap="square" stroke-linejoin="miter" />
      </svg>
      <span data-verified={exam.lastVerified}>Verified {verified}</span>
    </span>
    <a href={exam.officialUrl} rel="nofollow noopener" target="_blank"
       class="rounded-full bg-navy-100 px-2.5 py-1 font-semibold text-navy-700 hover:bg-navy-600 hover:text-white">
      Official {exam.body} site ↗
    </a>
  </div>

  {(exam.thumb || exam.declaration) && (
    <div class="mt-4 rounded-lg border border-line bg-surface px-4 py-3">
      <p class="text-sm font-bold text-navy-900">This exam needs more than a photo and signature.</p>
      <ul class="mt-2 space-y-1 text-sm text-ink">
        {exam.photo && <li class="flex gap-2"><span class="text-amber-600">•</span><span>Photograph</span></li>}
        {isLive && <li class="flex gap-2"><span class="text-amber-600">•</span><span>Photograph, captured live in the portal</span></li>}
        {exam.combined && <li class="flex gap-2"><span class="text-amber-600">•</span><span>Combined photo and signature image</span></li>}
        {exam.signature && <li class="flex gap-2"><span class="text-amber-600">•</span><span>Signature</span></li>}
        {exam.thumb && <li class="flex gap-2"><span class="text-amber-600">•</span><span>Left thumb impression</span></li>}
        {exam.declaration && <li class="flex gap-2"><span class="text-amber-600">•</span><span>Handwritten declaration</span></li>}
      </ul>
      <p class="mt-2 text-xs text-muted">Prepare all of them before you start the form.</p>
    </div>
  )}

  {isLive && (
    <section class="mt-8">
      <h2 class="mb-3 text-lg font-bold text-navy-900">Photo requirements</h2>
      <div class="rounded-md border border-line bg-surface px-4 py-3 text-sm">
        <strong class="text-navy-900">Your photo is captured live, there is no file to upload.</strong>
        <p class="mt-1 text-ink">
          {exam.name} takes your photograph through your camera during the
          application itself. You cannot upload a saved photo, so there is no
          pixel size or file size to match. Get the capture right instead.
        </p>
      </div>
      {exam.liveCaptureNotes && (
        <div>
          <h3 class="mt-5 mb-2 text-base font-bold text-navy-900">How to get the capture right</h3>
          <ul class="space-y-1.5 text-sm text-ink">
            {exam.liveCaptureNotes.map((n) => (
              <li class="flex gap-2"><span class="text-amber-600">•</span><span>{n}</span></li>
            ))}
          </ul>
        </div>
      )}
    </section>
  )}

  {exam.photo && (
    <section class="mt-8">
      <h2 class="mb-3 text-lg font-bold text-navy-900">Resize your photo</h2>
      <ImageResizer label="Photo" fileName="photo"
        widthPx={exam.photo.widthPx} heightPx={exam.photo.heightPx}
        minKB={exam.photo.minKB} maxKB={exam.photo.maxKB}
        unit={exam.photo.unit || 'px'} displayW={exam.photo.displayWidth}
        displayH={exam.photo.displayHeight} dpi={exam.photo.dpi || 300} />

      <h3 class="mt-6 mb-3 text-base font-bold text-navy-900">Photo requirements</h3>
      <table class="w-full border-collapse text-sm">
        <tbody>
          <tr class="border-b border-line">
            <th class="w-2/5 py-2 text-left font-medium text-muted">Dimensions</th>
            <td class="py-2 font-semibold">
              {dim(exam.photo)}
              {pxNote(exam.photo) && <span class="block text-xs font-normal text-muted">{pxNote(exam.photo)}</span>}
            </td>
          </tr>
          <tr class="border-b border-line">
            <th class="py-2 text-left font-medium text-muted">File size</th>
            <td class="py-2 font-semibold">{kb(exam.photo)}</td>
          </tr>
          <tr class="border-b border-line">
            <th class="py-2 text-left font-medium text-muted">Format</th>
            <td class="py-2 font-semibold">{exam.photo.format.toUpperCase()}</td>
          </tr>
          <tr class="border-b border-line">
            <th class="py-2 text-left font-medium text-muted">Background</th>
            <td class="py-2 font-semibold">{exam.photo.background}</td>
          </tr>
        </tbody>
      </table>
      <ul class="mt-3 space-y-1 text-sm text-ink">
        {exam.photo.notes.map((n) => (
          <li class="flex gap-2"><span class="text-amber-600">•</span><span>{n}</span></li>
        ))}
      </ul>
    </section>
  )}

  {exam.combined && (
    <section class="mt-10">
      <h2 class="mb-3 text-lg font-bold text-navy-900">Combined photo + signature</h2>
      <div class="mb-4 rounded-md bg-navy-100 px-4 py-3 text-sm">
        <strong class="text-navy-900">This exam wants one image containing both.</strong>
        <p class="mt-1 text-ink">
          Your photograph goes on top and your signature underneath, in a single
          file. Upload both below and we will combine them at the right size.
        </p>
      </div>

      <CombinedResizer
        widthPx={exam.combined.widthPx} heightPx={exam.combined.heightPx}
        minKB={exam.combined.minKB} maxKB={exam.combined.maxKB}
        photoRatio={exam.combined.photoRatio || 0.72} />

      <h3 class="mt-6 mb-3 text-base font-bold text-navy-900">Combined image requirements</h3>
      <table class="w-full border-collapse text-sm">
        <tbody>
          <tr class="border-b border-line">
            <th class="w-2/5 py-2 text-left font-medium text-muted">Dimensions</th>
            <td class="py-2 font-semibold">
              {dim(exam.combined)}
              {pxNote(exam.combined) && <span class="block text-xs font-normal text-muted">{pxNote(exam.combined)}</span>}
            </td>
          </tr>
          <tr class="border-b border-line">
            <th class="py-2 text-left font-medium text-muted">File size</th>
            <td class="py-2 font-semibold">{kb(exam.combined)}</td>
          </tr>
          <tr class="border-b border-line">
            <th class="py-2 text-left font-medium text-muted">Format</th>
            <td class="py-2 font-semibold">{exam.combined.format.toUpperCase()}</td>
          </tr>
        </tbody>
      </table>
      <ul class="mt-3 space-y-1 text-sm text-ink">
        {exam.combined.notes.map((n) => (
          <li class="flex gap-2"><span class="text-amber-600">•</span><span>{n}</span></li>
        ))}
      </ul>
    </section>
  )}

  {exam.signature && (
    <section class="mt-10">
      <h2 class="mb-3 text-lg font-bold text-navy-900">Resize your signature</h2>
      <ImageResizer label="Signature" fileName="signature"
        widthPx={exam.signature.widthPx} heightPx={exam.signature.heightPx}
        minKB={exam.signature.minKB} maxKB={exam.signature.maxKB}
        unit={exam.signature.unit || 'px'} displayW={exam.signature.displayWidth}
        displayH={exam.signature.displayHeight} dpi={exam.signature.dpi || 300} />

      <h3 class="mt-6 mb-3 text-base font-bold text-navy-900">Signature requirements</h3>
      <table class="w-full border-collapse text-sm">
        <tbody>
          <tr class="border-b border-line">
            <th class="w-2/5 py-2 text-left font-medium text-muted">Dimensions</th>
            <td class="py-2 font-semibold">
              {dim(exam.signature)}
              {pxNote(exam.signature) && <span class="block text-xs font-normal text-muted">{pxNote(exam.signature)}</span>}
            </td>
          </tr>
          <tr class="border-b border-line">
            <th class="py-2 text-left font-medium text-muted">File size</th>
            <td class="py-2 font-semibold">{kb(exam.signature)}</td>
          </tr>
          <tr class="border-b border-line">
            <th class="py-2 text-left font-medium text-muted">Format</th>
            <td class="py-2 font-semibold">{exam.signature.format.toUpperCase()}</td>
          </tr>
          <tr class="border-b border-line">
            <th class="py-2 text-left font-medium text-muted">Ink colour</th>
            <td class="py-2 font-semibold">{exam.signature.ink}</td>
          </tr>
        </tbody>
      </table>
      <ul class="mt-3 space-y-1 text-sm text-ink">
        {exam.signature.notes.map((n) => (
          <li class="flex gap-2"><span class="text-amber-600">•</span><span>{n}</span></li>
        ))}
      </ul>
    </section>
  )}

  {exam.thumb && (
    <section class="mt-10">
      <h2 class="mb-3 text-lg font-bold text-navy-900">Resize your thumb impression</h2>

      <div class="mb-4 rounded-md bg-navy-100 px-4 py-3 text-sm">
        <strong class="text-navy-900">Use your left thumb.</strong>
        <p class="mt-1 text-ink">
          Press your left thumb onto a stamp pad, then onto plain white paper.
          If you have no left thumb, use your right, and note that on the form.
        </p>
      </div>

      <ImageResizer label="Thumb impression" fileName="thumb"
        widthPx={exam.thumb.widthPx} heightPx={exam.thumb.heightPx}
        minKB={exam.thumb.minKB} maxKB={exam.thumb.maxKB}
        unit={exam.thumb.unit || 'px'} displayW={exam.thumb.displayWidth}
        displayH={exam.thumb.displayHeight} dpi={exam.thumb.dpi || 300} />

      <h3 class="mt-6 mb-3 text-base font-bold text-navy-900">Thumb impression requirements</h3>
      <table class="w-full border-collapse text-sm">
        <tbody>
          <tr class="border-b border-line">
            <th class="w-2/5 py-2 text-left font-medium text-muted">Dimensions</th>
            <td class="py-2 font-semibold">
              {dim(exam.thumb)}
              {pxNote(exam.thumb) && <span class="block text-xs font-normal text-muted">{pxNote(exam.thumb)}</span>}
            </td>
          </tr>
          <tr class="border-b border-line">
            <th class="py-2 text-left font-medium text-muted">File size</th>
            <td class="py-2 font-semibold">{kb(exam.thumb)}</td>
          </tr>
          <tr class="border-b border-line">
            <th class="py-2 text-left font-medium text-muted">Format</th>
            <td class="py-2 font-semibold">{exam.thumb.format.toUpperCase()}</td>
          </tr>
          <tr class="border-b border-line">
            <th class="py-2 text-left font-medium text-muted">Ink colour</th>
            <td class="py-2 font-semibold">{exam.thumb.ink}</td>
          </tr>
        </tbody>
      </table>
      <ul class="mt-3 space-y-1 text-sm text-ink">
        {exam.thumb.notes.map((n) => (
          <li class="flex gap-2"><span class="text-amber-600">•</span><span>{n}</span></li>
        ))}
      </ul>
    </section>
  )}

  {exam.declaration && (
    <section class="mt-10">
      <h2 class="mb-3 text-lg font-bold text-navy-900">Handwritten declaration</h2>

      <div class="mb-4 rounded-md bg-amber-100 px-4 py-3 text-sm">
        <strong class="text-navy-900">This must be written by hand, not typed.</strong>
        <p class="mt-1 text-ink">
          Write it on plain white paper in your own running handwriting, in English,
          using a black or blue pen. Capital letters are not accepted, and a typed
          or printed declaration will be rejected.
        </p>
      </div>

      {exam.declaration.text && (
        <div class="mb-5 rounded-lg border-2 border-navy-600 bg-white p-4">
          <p class="mb-2 text-xs font-bold uppercase tracking-wide text-navy-700">Text to write</p>
          <p class="text-sm leading-relaxed text-ink" id="declText">{exam.declaration.text}</p>
          <button type="button"
                  class="copy-decl mt-3 rounded-md border-2 border-navy-800 px-4 py-2 text-sm font-bold text-navy-800 hover:bg-navy-800 hover:text-white">
            Copy this text
          </button>
        </div>
      )}

      <ImageResizer label="Declaration" fileName="declaration"
        widthPx={exam.declaration.widthPx} heightPx={exam.declaration.heightPx}
        minKB={exam.declaration.minKB} maxKB={exam.declaration.maxKB}
        unit={exam.declaration.unit || 'px'} displayW={exam.declaration.displayWidth}
        displayH={exam.declaration.displayHeight} dpi={exam.declaration.dpi || 300} />

      <h3 class="mt-6 mb-3 text-base font-bold text-navy-900">Declaration requirements</h3>
      <table class="w-full border-collapse text-sm">
        <tbody>
          <tr class="border-b border-line">
            <th class="w-2/5 py-2 text-left font-medium text-muted">Dimensions</th>
            <td class="py-2 font-semibold">
              {dim(exam.declaration)}
              {pxNote(exam.declaration) && <span class="block text-xs font-normal text-muted">{pxNote(exam.declaration)}</span>}
            </td>
          </tr>
          <tr class="border-b border-line">
            <th class="py-2 text-left font-medium text-muted">File size</th>
            <td class="py-2 font-semibold">{kb(exam.declaration)}</td>
          </tr>
          <tr class="border-b border-line">
            <th class="py-2 text-left font-medium text-muted">Format</th>
            <td class="py-2 font-semibold">{exam.declaration.format.toUpperCase()}</td>
          </tr>
        </tbody>
      </table>
      <ul class="mt-3 space-y-1 text-sm text-ink">
        {exam.declaration.notes.map((n) => (
          <li class="flex gap-2"><span class="text-amber-600">•</span><span>{n}</span></li>
        ))}
      </ul>
    </section>
  )}

  <section class="mt-10 rounded-lg bg-surface p-5">
    <h2 class="mb-2 text-lg font-bold text-navy-900">About {exam.name} {exam.year}</h2>
    <p class="text-sm text-muted">
      Full notification details, important dates, vacancy breakdown and application
      steps for {exam.fullName}.
    </p>
    <a href={`/blog/${exam.slug}-${exam.year}-notification/`}
       class="mt-3 inline-block rounded-md bg-navy-800 px-4 py-2 text-sm font-semibold text-white hover:bg-navy-700">
      Read the full notification guide →
    </a>
  </section>

  <AffiliateBlock groups={[exam.slug]} />

  <section class="mt-10 border-t border-line pt-6">
    <h2 class="mb-3 text-sm font-bold uppercase tracking-wide text-navy-700">Share this page</h2>
    <div class="flex flex-wrap gap-2 text-sm">
      <a target="_blank" rel="noopener"
         href={`https://wa.me/?text=${encodeURIComponent(exam.name + ' photo and signature size, ' + pageUrl)}`}
         class="rounded-md bg-[#25D366] px-4 py-2 font-semibold text-white">WhatsApp</a>
      <a target="_blank" rel="noopener"
         href={`https://t.me/share/url?url=${encodeURIComponent(pageUrl)}`}
         class="rounded-md bg-[#0088cc] px-4 py-2 font-semibold text-white">Telegram</a>
      <button type="button" data-copy={pageUrl}
         class="copy-link rounded-md border border-line px-4 py-2 font-semibold text-navy-700 hover:bg-surface">
        Copy link
      </button>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="mb-3 text-lg font-bold text-navy-900">Other exams</h2>
    <div class="grid grid-cols-2 gap-3">
      {related.map((e) => (
        <a href={`/exams/${e.slug}/`}
           class="rounded-lg border-2 border-line bg-white px-3 py-4 shadow-sm transition hover:border-amber-500 hover:bg-amber-100">
          <span class="block text-base font-bold leading-tight text-navy-900">{e.name}</span>
          <span class="mt-1.5 block text-xs text-muted">Resize photo &amp; sign</span>
        </a>
      ))}
    </div>
  </section>

</BaseLayout>

<script>
  document.querySelectorAll('.copy-link').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-copy');
      if (!url) return;
      await navigator.clipboard.writeText(url);
      const original = btn.textContent;
      btn.textContent = 'Copied ✓';
      setTimeout(() => { btn.textContent = original; }, 1500);
    });
  });

  document.querySelectorAll('.copy-decl').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const el = document.getElementById('declText');
      if (!el) return;
      await navigator.clipboard.writeText(el.textContent || '');
      const original = btn.textContent;
      btn.textContent = 'Copied ✓';
      setTimeout(() => { btn.textContent = original; }, 1500);
    });
  });

  document.querySelectorAll('[data-verified]').forEach((el) => {
    const raw = el.getAttribute('data-verified');
    if (!raw) return;
    const days = Math.floor((Date.now() - new Date(raw).getTime()) / 86400000);
    if (days < 0 || days > 60) return;
    if (days === 0) el.textContent = 'Verified today';
    else if (days === 1) el.textContent = 'Verified yesterday';
    else if (days < 30) el.textContent = 'Verified ' + days + ' days ago';
    else el.textContent = 'Verified last month';
  });
</script>