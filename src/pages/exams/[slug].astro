---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageResizer from '../../components/ImageResizer.astro';
import AffiliateBlock from '../../components/AffiliateBlock.astro';
import exams from '../../data/exams.json';
import products from '../../data/products.json';

export function getStaticPaths() {
  return exams.map((exam) => ({
    params: { slug: exam.slug },
    props: { exam },
  }));
}

const { exam } = Astro.props;
const isLive = exam.captureMode === 'live' || !exam.photo;

const title = `${exam.name} Photo & Signature Size ${exam.year} — Exact Requirements`;
const description = isLive
  ? `${exam.name} ${exam.year}: photo is captured live in the portal. Signature ${exam.signature.minKB}–${exam.signature.maxKB} KB. Free signature resizer.`
  : `${exam.name} ${exam.year}: photo ${exam.photo.widthPx}×${exam.photo.heightPx} px, ${exam.photo.minKB}–${exam.photo.maxKB} KB. Signature size and free resizer tool.`;

const verified = new Date(exam.lastVerified).toLocaleDateString('en-IN', {
  day: 'numeric', month: 'long', year: 'numeric',
});

const related = exams.filter((e) => e.slug !== exam.slug).slice(0, 6);
const pageUrl = Astro.url.href;
const examProducts = products[exam.slug] || [];
---
<BaseLayout title={title} description={description}>

  <nav class="mb-4 text-xs text-muted">
    <a href="/" class="hover:text-navy-700">Home</a>
    <span class="mx-1">/</span>
    <a href="/exams/" class="hover:text-navy-700">Exams</a>
    <span class="mx-1">/</span>
    <span class="text-ink">{exam.name}</span>
  </nav>

  <h1 class="text-2xl font-bold leading-tight text-navy-900 sm:text-3xl">
    {exam.name} Photo &amp; Signature Size {exam.year}
  </h1>
  <p class="mt-1.5 text-sm text-muted">{exam.fullName}</p>

  <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
    <span data-verified={exam.lastVerified}
          class="rounded-full bg-pass-bg px-2.5 py-1 font-semibold text-pass">
      ✓ Verified {verified}
    </span>
    <a href={exam.officialUrl} rel="nofollow noopener" target="_blank"
       class="rounded-full bg-navy-100 px-2.5 py-1 font-semibold text-navy-700 hover:bg-navy-600 hover:text-white">
      Official {exam.body} site ↗
    </a>
  </div>

  <section class="mt-8">
    <h2 class="mb-3 text-lg font-bold text-navy-900">Photo requirements</h2>

    {isLive ? (
      <div>
        <div class="rounded-md border-l-4 border-amber-500 bg-amber-100 px-4 py-3 text-sm">
          <strong class="text-navy-900">Your photo is captured live — there is no file to upload.</strong>
          <p class="mt-1 text-ink">
            {exam.name} takes your photograph through your camera during the
            application itself. You cannot upload a saved photo, so there is no
            pixel size or file size to match. Get the capture right instead.
          </p>
        </div>

        <h3 class="mt-5 mb-2 text-base font-bold text-navy-900">How to get the capture right</h3>
        <ul class="space-y-1.5 text-sm text-ink">
          {exam.liveCaptureNotes && exam.liveCaptureNotes.map((n) => (
            <li class="flex gap-2"><span class="text-amber-600">•</span><span>{n}</span></li>
          ))}
        </ul>
      </div>
    ) : (
      <div>
        <table class="w-full border-collapse text-sm">
          <tbody>
            <tr class="border-b border-line">
              <th class="w-2/5 py-2 text-left font-medium text-muted">Dimensions</th>
              <td class="py-2 font-semibold">{exam.photo.widthPx} × {exam.photo.heightPx} px</td>
            </tr>
            <tr class="border-b border-line">
              <th class="py-2 text-left font-medium text-muted">File size</th>
              <td class="py-2 font-semibold">{exam.photo.minKB} – {exam.photo.maxKB} KB</td>
            </tr>
            <tr class="border-b border-line">
              <th class="py-2 text-left font-medium text-muted">Format</th>
              <td class="py-2 font-semibold">{exam.photo.format.toUpperCase()}</td>
            </tr>
            <tr class="border-b border-line">
              <th class="py-2 text-left font-medium text-muted">Background</th>
              <td class="py-2 font-semibold">{exam.photo.background}</td>
            </tr>
          </tbody>
        </table>
        <ul class="mt-3 space-y-1 text-sm text-ink">
          {exam.photo.notes.map((n) => (
            <li class="flex gap-2"><span class="text-amber-600">•</span><span>{n}</span></li>
          ))}
        </ul>
        <div class="mt-5">
          <ImageResizer label="Photo" fileName="photo"
            widthPx={exam.photo.widthPx} heightPx={exam.photo.heightPx}
            minKB={exam.photo.minKB} maxKB={exam.photo.maxKB} />
        </div>
      </div>
    )}
  </section>

  <section class="mt-10">
    <h2 class="mb-3 text-lg font-bold text-navy-900">Signature requirements</h2>
    <table class="w-full border-collapse text-sm">
      <tbody>
        <tr class="border-b border-line">
          <th class="w-2/5 py-2 text-left font-medium text-muted">Dimensions</th>
          <td class="py-2 font-semibold">
            {exam.signature.widthCm
              ? exam.signature.widthCm + ' × ' + exam.signature.heightCm + ' cm'
              : exam.signature.widthPx + ' × ' + exam.signature.heightPx + ' px'}
          </td>
        </tr>
        <tr class="border-b border-line">
          <th class="py-2 text-left font-medium text-muted">File size</th>
          <td class="py-2 font-semibold">{exam.signature.minKB} – {exam.signature.maxKB} KB</td>
        </tr>
        <tr class="border-b border-line">
          <th class="py-2 text-left font-medium text-muted">Format</th>
          <td class="py-2 font-semibold">{exam.signature.format.toUpperCase()}</td>
        </tr>
        <tr class="border-b border-line">
          <th class="py-2 text-left font-medium text-muted">Ink colour</th>
          <td class="py-2 font-semibold">{exam.signature.ink}</td>
        </tr>
      </tbody>
    </table>
    <ul class="mt-3 space-y-1 text-sm text-ink">
      {exam.signature.notes.map((n) => (
        <li class="flex gap-2"><span class="text-amber-600">•</span><span>{n}</span></li>
      ))}
    </ul>

    {exam.signature.widthCm && (
      <p class="mt-3 text-xs text-muted">
        The notification gives {exam.signature.widthCm} × {exam.signature.heightCm} cm.
        Our tool produces {exam.signature.widthPx} × {exam.signature.heightPx} px,
        which is that size at 300 DPI.
      </p>
    )}

    <div class="mt-5">
      <ImageResizer label="Signature" fileName="signature"
        widthPx={exam.signature.widthPx} heightPx={exam.signature.heightPx}
        minKB={exam.signature.minKB} maxKB={exam.signature.maxKB} />
    </div>
  </section>

  <section class="mt-10 rounded-lg bg-surface p-5">
    <h2 class="mb-2 text-lg font-bold text-navy-900">About {exam.name} {exam.year}</h2>
    <p class="text-sm text-muted">
      Full notification details, important dates, vacancy breakdown and application
      steps for {exam.fullName}.
    </p>
    <a href={`/blog/${exam.slug}-${exam.year}-notification/`}
       class="mt-3 inline-block rounded-md bg-navy-800 px-4 py-2 text-sm font-semibold text-white hover:bg-navy-700">
      Read the full notification guide →
    </a>
  </section>

  <AffiliateBlock products={examProducts} />

  <section class="mt-10 border-t border-line pt-6">
    <h2 class="mb-3 text-sm font-bold uppercase tracking-wide text-navy-700">Share this page</h2>
    <div class="flex flex-wrap gap-2 text-sm">
      <a target="_blank" rel="noopener"
         href={`https://wa.me/?text=${encodeURIComponent(exam.name + ' photo & signature size — ' + pageUrl)}`}
         class="rounded-md bg-[#25D366] px-4 py-2 font-semibold text-white">WhatsApp</a>
      <a target="_blank" rel="noopener"
         href={`https://t.me/share/url?url=${encodeURIComponent(pageUrl)}`}
         class="rounded-md bg-[#0088cc] px-4 py-2 font-semibold text-white">Telegram</a>
      <button type="button" data-copy={pageUrl}
         class="copy-link rounded-md border border-line px-4 py-2 font-semibold text-navy-700 hover:bg-surface">
        Copy link
      </button>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="mb-3 text-lg font-bold text-navy-900">Other exams</h2>
    <div class="grid grid-cols-2 gap-2">
      {related.map((e) => (
        <a href={`/exams/${e.slug}/`}
           class="rounded-md border border-line px-3 py-2.5 text-sm hover:border-navy-600 hover:bg-surface">
          <span class="font-semibold text-navy-800">{e.name}</span>
          <span class="block text-xs text-muted">
            {e.photo
              ? e.photo.widthPx + '×' + e.photo.heightPx + ' px · ' + e.photo.minKB + '–' + e.photo.maxKB + ' KB'
              : 'Live photo capture'}
          </span>
        </a>
      ))}
    </div>
  </section>

</BaseLayout>

<script>
  document.querySelectorAll('.copy-link').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-copy');
      if (!url) return;
      await navigator.clipboard.writeText(url);
      const original = btn.textContent;
      btn.textContent = 'Copied ✓';
      setTimeout(() => { btn.textContent = original; }, 1500);
    });
  });

  document.querySelectorAll('[data-verified]').forEach((el) => {
    const raw = el.getAttribute('data-verified');
    if (!raw) return;
    const days = Math.floor((Date.now() - new Date(raw).getTime()) / 86400000);
    if (days < 0 || days > 60) return;
    if (days === 0) el.textContent = '✓ Verified today';
    else if (days === 1) el.textContent = '✓ Verified yesterday';
    else if (days < 30) el.textContent = '✓ Verified ' + days + ' days ago';
    else el.textContent = '✓ Verified last month';
  });
</script>