---
import BaseLayout from '../../layouts/BaseLayout.astro';
import exams from '../../data/exams.json';

const categories = [
  { key: 'central', label: 'SSC & Central' },
  { key: 'railway', label: 'Railway' },
  { key: 'banking', label: 'Banking' },
  { key: 'state', label: 'State PSC' },
  { key: 'police', label: 'Police & Defence' }
];
---
<BaseLayout title="All Exams, Photo & Signature Size Requirements | FormSetu">

  <nav class="mb-4 text-xs text-muted">
    <a href="/" class="hover:text-navy-700">Home</a>
    <span class="mx-1">/</span>
    <span class="text-ink">Exams</span>
  </nav>

  <h1 class="text-2xl font-bold text-navy-900 sm:text-3xl">Exam photo &amp; signature requirements</h1>
  <p class="mt-2 text-sm text-muted">
    Exact photo, signature and document specifications for Indian government exam
    application forms, checked against the official notification.
  </p>

  {categories.map((c) => {
    const items = exams.filter((e) => e.category === c.key);
    return items.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-3 text-lg font-bold text-navy-900">{c.label}</h2>
        <div class="grid grid-cols-2 gap-3">
          {items.slice(0, 4).map((e) => (
            <a href={"/exams/" + e.slug + "/"}
               class="rounded-lg border-2 border-line bg-white px-3 py-4 shadow-sm transition hover:border-amber-500 hover:bg-amber-100 active:scale-[0.98]">
              <span class="block text-base font-bold leading-tight text-navy-900">{e.name}</span>
              <span class="mt-1.5 block text-xs text-muted">Resize photo &amp; sign</span>
              <span class="mt-2 inline-block text-xs font-bold text-amber-600">Open tool →</span>
            </a>
          ))}
        </div>
        {items.length > 4 && (
          <a href={"/exams/category/" + c.key + "/"}
             class="mt-3 inline-block rounded-md border-2 border-navy-800 px-4 py-2 text-sm font-bold text-navy-800 hover:bg-navy-800 hover:text-white">
            See all {items.length} {c.label} exams →
          </a>
        )}
      </section>
    );
  })}

  <section class="mt-10 rounded-lg border-2 border-amber-500 bg-amber-100 px-4 py-4">
    <p class="text-sm font-bold text-navy-900">Exam not listed?</p>
    <p class="mt-1 text-sm text-ink">
      Use the custom resizer and enter the size from your own notification.
    </p>
    <a href="/tools/photo-resizer/" class="mt-3 inline-block rounded-md bg-amber-600 px-4 py-2 text-sm font-bold text-white hover:bg-amber-500">
      Open custom resizer →
    </a>
  </section>

</BaseLayout>