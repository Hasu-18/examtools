---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import exams from '../../../data/exams.json';

const labels = {
  central: 'SSC & Central',
  entrance: 'NTA & Entrance',
  railway: 'Railway',
  banking: 'Banking',
  state: 'State',
  judiciary: 'Court & Judiciary',
  police: 'Police & Defence'
};

export function getStaticPaths() {
  const keys = ['central', 'entrance', 'railway', 'banking', 'state', 'judiciary', 'police'];
  return keys.map((cat) => ({ params: { cat } }));
}

const { cat } = Astro.params;
const label = labels[cat] || cat;
const items = exams.filter((e) => e.category === cat);

const searchKey = (e) => [e.name, e.fullName, e.slug, e.body, e.region]
  .filter(Boolean).join(' ').toLowerCase();
---
<BaseLayout
  title={`All ${label} Exams, Photo & Signature Size | FormSetu`}
  description={`Photo and signature requirements for every ${label} exam, with a free resizer tool.`}>

  <nav class="mb-4 text-xs text-muted">
    <a href="/" class="hover:text-navy-700">Home</a>
    <span class="mx-1">/</span>
    <a href="/exams/" class="hover:text-navy-700">Exams</a>
    <span class="mx-1">/</span>
    <span class="text-ink">{label}</span>
  </nav>

  <h1 class="text-2xl font-bold text-navy-900 sm:text-3xl">All {label} exams</h1>
  <p class="mt-2 text-sm text-muted">
    {items.length} {items.length === 1 ? 'exam' : 'exams'} with verified photo and
    signature requirements.
  </p>

  <div class="relative mt-5">
    <input type="search" id="examSearch"
      placeholder={"Search within " + label + " exams..."}
      class="w-full rounded-lg border-2 border-navy-600 bg-white px-4 py-2.5 pr-11 text-base shadow-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-100" />
    <svg viewBox="0 0 24 24" class="pointer-events-none absolute right-3.5 top-1/2 h-5 w-5 -translate-y-1/2 fill-none stroke-navy-600" stroke-width="2.2" aria-hidden="true">
      <circle cx="11" cy="11" r="7" />
      <path d="M20 20l-3.5-3.5" stroke-linecap="round" />
    </svg>
  </div>

  {items.length > 0 ? (
    <div class="mt-5 grid grid-cols-2 gap-3">
      {items.map((e) => (
        <a href={"/exams/" + e.slug + "/"} data-search={searchKey(e)}
           class="exam-card rounded-lg border-2 border-line bg-white px-3 py-4 shadow-sm transition hover:border-amber-500 hover:bg-amber-100 active:scale-[0.98]">
          <span class="block text-lg font-bold leading-tight text-navy-900">{e.name}</span>
          <span class="mt-1.5 block text-xs text-muted">Resize photo &amp; sign</span>
          <span class="mt-2 inline-block text-xs font-bold text-amber-600">Open tool →</span>
        </a>
      ))}
    </div>
  ) : (
    <p class="mt-6 text-sm text-muted">No exams added in this category yet.</p>
  )}

  <div id="noResults" class="mt-5 rounded-lg border-2 border-amber-500 bg-amber-100 px-4 py-4" hidden>
    <p class="text-sm font-bold text-navy-900">No exam matched that search.</p>
    <p class="mt-1 text-sm text-ink">
      Use the custom resizer and enter the size from your own notification.
    </p>
    <a href="/tools/photo-resizer/" class="mt-3 inline-block rounded-md bg-amber-600 px-4 py-2 text-sm font-bold text-white hover:bg-amber-500">
      Open custom resizer →
    </a>
    <p class="mt-3 text-xs text-muted">
      Want it added?
      <a href="mailto:contact@formsetu.com?subject=Please%20add%20an%20exam" class="font-semibold text-navy-700 underline">Email us the exam name</a>
    </p>
  </div>

  <section class="mt-10 rounded-lg border-2 border-amber-500 bg-amber-100 px-4 py-4">
    <p class="text-sm font-bold text-navy-900">Exam not listed?</p>
    <p class="mt-1 text-sm text-ink">
      Use the custom resizer and enter the size from your own notification.
    </p>
    <a href="/tools/photo-resizer/" class="mt-3 inline-block rounded-md bg-amber-600 px-4 py-2 text-sm font-bold text-white hover:bg-amber-500">
      Open custom resizer →
    </a>
  </section>

  <a href="/exams/" class="mt-6 inline-block text-sm font-bold text-navy-700 hover:text-amber-600">← All categories</a>

</BaseLayout>

<script>
  const search = document.getElementById('examSearch');
  const cards = document.querySelectorAll('.exam-card');
  const noResults = document.getElementById('noResults');

  if (search) {
    search.addEventListener('input', () => {
      const term = search.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const hay = card.getAttribute('data-search') || '';
        const match = term.split(/\s+/).filter(Boolean).every((w) => hay.includes(w));
        card.hidden = !match;
        if (match) visible++;
      });
      noResults.hidden = visible > 0;
    });
  }
</script>