---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.data.category === 'notification')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const now = Date.now();
const open = posts.filter((p) => p.data.closes && p.data.closes.getTime() >= now);
const closed = posts.filter((p) => !p.data.closes || p.data.closes.getTime() < now);

const fmt = (x) => x.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const key = (p) => [p.data.title, p.data.description, p.data.relatedExam].filter(Boolean).join(' ').toLowerCase();
---
<BaseLayout
  title="Latest Exam Notifications | Form Setu"
  description="Latest Indian government exam notifications, application dates, vacancies and how to apply.">

  <nav class="mb-4 text-xs text-muted">
    <a href="/" class="hover:text-navy-700">Home</a>
    <span class="mx-1">/</span>
    <span class="text-ink">Notifications</span>
  </nav>

  <h1 class="text-2xl font-bold text-navy-900 sm:text-3xl">Latest notifications</h1>
  <p class="mt-2 text-sm text-muted">
    Application dates, vacancies and document requirements for Indian government exams.
  </p>

  {posts.length > 3 && (
    <div class="relative mt-5">
      <input type="search" id="notifSearch" placeholder="Search notifications..."
        class="w-full rounded-lg border-2 border-navy-600 bg-white px-4 py-2.5 pr-11 text-base shadow-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-100" />
      <svg viewBox="0 0 24 24" class="pointer-events-none absolute right-3.5 top-1/2 h-5 w-5 -translate-y-1/2 fill-none stroke-navy-600" stroke-width="2.2" aria-hidden="true">
        <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" stroke-linecap="round" />
      </svg>
    </div>
  )}

  {posts.length === 0 && (
    <div class="mt-8 rounded-lg border-2 border-amber-500 bg-amber-100 px-4 py-4">
      <p class="text-sm font-bold text-navy-900">No notifications published yet.</p>
      <p class="mt-1 text-sm text-ink">In the meantime, every exam page has the photo and signature requirements you need.</p>
      <a href="/exams/" class="mt-3 inline-block rounded-md bg-amber-600 px-4 py-2 text-sm font-bold text-white hover:bg-amber-500">Browse exams →</a>
    </div>
  )}

  {open.length > 0 && (
    <section class="mt-8 notif-group">
      <h2 class="mb-3 text-lg font-bold text-navy-900">Forms open right now</h2>
      <div class="space-y-2">
        {open.map((p) => (
          <a href={"/blog/" + p.id + "/"} data-search={key(p)}
             class="notif-card block rounded-lg border-2 border-pass bg-pass-bg px-4 py-3 transition hover:border-amber-500">
            <span class="inline-flex items-center gap-1.5 rounded bg-pass px-2 py-0.5 text-xs font-bold text-white">
              <span class="live-dot"></span>{p.data.status || 'Form open'}
            </span>
            <span class="mt-1.5 block text-base font-bold leading-snug text-navy-900">{p.data.title}</span>
            <span class="mt-1 block text-sm text-muted">{p.data.description}</span>
            <span class="mt-1.5 block text-xs font-bold text-pass">Closes {fmt(p.data.closes)}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {closed.length > 0 && (
    <section class="mt-10 notif-group">
      <h2 class="mb-3 text-lg font-bold text-navy-900">All notifications</h2>
      <div class="space-y-2">
        {closed.map((p) => (
          <a href={"/blog/" + p.id + "/"} data-search={key(p)}
             class="notif-card block rounded-lg border-2 border-line bg-white px-4 py-3 shadow-sm transition hover:border-amber-500 hover:bg-amber-100">
            <span class="block text-base font-bold leading-snug text-navy-900">{p.data.title}</span>
            <span class="mt-1 block text-sm text-muted">{p.data.description}</span>
            <span class="mt-1.5 block text-xs text-muted">{fmt(p.data.date)}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <p id="notifNone" class="mt-6 text-sm text-muted" hidden>No notification matched that search.</p>

</BaseLayout>

<style>
  .live-dot { display:inline-block; width:6px; height:6px; border-radius:50%; background:#fff; animation: livePulse 1.6s ease-in-out infinite; }
  @keyframes livePulse { 0%,100% { opacity:1; } 50% { opacity:.3; } }
  @media (prefers-reduced-motion: reduce) { .live-dot { animation:none; } }
</style>

<script>
  const s = document.getElementById('notifSearch');
  if (s) {
    const cards = document.querySelectorAll('.notif-card');
    const groups = document.querySelectorAll('.notif-group');
    const none = document.getElementById('notifNone');
    s.addEventListener('input', () => {
      const term = s.value.trim().toLowerCase();
      let vis = 0;
      cards.forEach((c) => {
        const hay = c.getAttribute('data-search') || '';
        const match = term.split(/\s+/).filter(Boolean).every((w) => hay.includes(w));
        c.hidden = !match;
        if (match) vis++;
      });
      groups.forEach((g) => { g.hidden = g.querySelectorAll('.notif-card:not([hidden])').length === 0; });
      none.hidden = vis > 0;
    });
  }
</script>