---
import BaseLayout from '../layouts/BaseLayout.astro';
import exams from '../data/exams.json';
import notifications from '../data/notifications.json';

const RESIZES_DONE = null;

const categories = [
  { key: 'central', label: 'SSC & Central' },
  { key: 'entrance', label: 'NTA & Entrance' },
  { key: 'railway', label: 'Railway' },
  { key: 'banking', label: 'Banking' },
  { key: 'state', label: 'State PSC' },
  { key: 'judiciary', label: 'Court & Judiciary' },
  { key: 'police', label: 'Police & Defence' }
];

const latestVerified = exams.map((e) => e.lastVerified).sort().reverse()[0];

const verifiedLabel = new Date(latestVerified).toLocaleDateString('en-IN', {
  day: 'numeric', month: 'short', year: 'numeric'
});

const reasons = [
  {
    title: 'Nothing leaves your phone',
    body: 'Your photo is processed entirely in your browser. We never receive it, store it, or see it, unlike tools that upload to a server first.'
  },
  {
    title: 'Exact pixels and exact KB, together',
    body: 'Most tools do one or the other. Ours lands inside both limits at the highest quality that fits, so the portal accepts it first time.'
  },
  {
    title: 'Position your face properly',
    body: 'Drag and zoom to frame your photo correctly. Bad framing is one of the most common reasons applications get rejected.'
  },
  {
    title: 'Specs we actually check',
    body: 'Every exam page shows the date we last verified it against the official notification. If it is not checked, it is not published.'
  }
];
---
<BaseLayout title="FormSetu, Photo & Signature Size for Indian Government Exam Forms">

  <section class="pb-7">
    <h1 class="text-3xl font-bold leading-tight tracking-tight text-navy-900 sm:text-5xl">
      Stop guessing the photo size<br />for your <span class="text-amber-600">dream exam.</span>
    </h1>
    <p class="mt-4 text-base text-muted sm:text-lg">
      Every exam wants different pixels and KB. We publish the exact numbers and
      resize your file to fit, right here in your browser.
    </p>
  </section>

  <section class="pb-7">
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-lg border border-line bg-surface px-3 py-4 text-center">
        <p class="text-3xl font-bold text-navy-900">{exams.length}</p>
        <p class="mt-1 text-xs font-medium text-muted">Exams covered</p>
      </div>
      <div class="rounded-lg border border-line bg-surface px-3 py-4 text-center">
        <p class="text-3xl font-bold text-navy-900">{RESIZES_DONE ? RESIZES_DONE + '+' : '0'}</p>
        <p class="mt-1 text-xs font-medium text-muted">
          {RESIZES_DONE ? 'Photos resized' : 'Files ever uploaded'}
        </p>
      </div>
      <div class="rounded-lg border border-line bg-surface px-3 py-4 text-center">
        <p class="text-3xl font-bold text-navy-900">Free</p>
        <p class="mt-1 text-xs font-medium text-muted">Always, no signup</p>
      </div>
      <div class="rounded-lg border border-line bg-surface px-3 py-4 text-center">
        <p class="text-lg font-bold text-navy-900 sm:text-xl">{verifiedLabel}</p>
        <p class="mt-1 text-xs font-medium text-muted">Last updated</p>
      </div>
    </div>
  </section>

  <section class="border-t border-line py-7">
    <div class="relative">
      <input
        type="search"
        id="examSearch"
        placeholder="Search your exam, SSC CGL, RRB, IBPS..."
        class="w-full rounded-lg border-2 border-navy-600 bg-white px-4 py-3.5 pr-12 text-base shadow-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-100"
      />
      <svg viewBox="0 0 24 24" class="pointer-events-none absolute right-4 top-1/2 h-5 w-5 -translate-y-1/2 fill-none stroke-navy-600" stroke-width="2.2" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="M20 20l-3.5-3.5" stroke-linecap="round" />
      </svg>
    </div>

    <h2 class="mt-7 mb-4 text-xl font-bold text-navy-900">Find your exam</h2>

    {categories.map((c) => {
      const items = exams.filter((e) => e.category === c.key);
      return items.length > 0 && (
        <div class="mb-6 exam-group">
          <h3 class="mb-2 text-xs font-bold uppercase tracking-wide text-navy-700">{c.label}</h3>
          <div class="grid grid-cols-2 gap-3">
            {items.slice(0, 4).map((e) => (
              <a href={"/exams/" + e.slug + "/"}
                 data-name={e.name.toLowerCase()}
                 class="exam-card rounded-lg border-2 border-line bg-white px-3 py-4 shadow-sm transition hover:border-amber-500 hover:bg-amber-100 active:scale-[0.98]">
                <span class="block text-base font-bold leading-tight text-navy-900">{e.name}</span>
                <span class="mt-1.5 block text-xs leading-snug text-muted">Resize photo &amp; sign</span>
                <span class="mt-2 inline-block text-xs font-bold text-amber-600">Open tool →</span>
              </a>
            ))}
          </div>
          {items.length > 4 && (
            <a href={"/exams/category/" + c.key + "/"}
               class="mt-3 inline-block rounded-md border-2 border-navy-800 px-4 py-2 text-sm font-bold text-navy-800 hover:bg-navy-800 hover:text-white">
              See all {items.length} {c.label} exams →
            </a>
          )}
        </div>
      );
    })}

    <div id="noResults" class="rounded-lg border-2 border-amber-500 bg-amber-100 px-4 py-4" hidden>
      <p class="text-sm font-bold text-navy-900">No exam matched that search.</p>
      <p class="mt-1 text-sm text-ink">
        We add new exams every week. Tell us which one you need and we will add it.
      </p>
      <a href="mailto:contact@formsetu.com?subject=Please%20add%20an%20exam"
         class="mt-3 inline-flex items-center gap-2 rounded-md bg-amber-600 px-4 py-2 text-sm font-bold text-white hover:bg-amber-500">
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current" stroke-width="2" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="M3 7l9 6 9-6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Email us the exam name
      </a>
    </div>

    <div class="mt-6 rounded-lg border-2 border-amber-500 bg-amber-100 px-4 py-4">
      <p class="text-sm font-bold text-navy-900">Exam not listed?</p>
      <p class="mt-1 text-sm text-ink">
        Use the custom resizer and enter the size from your own notification. It
        works for any exam or application.
      </p>
      <a href="/tools/photo-resizer/" class="mt-3 inline-block rounded-md bg-amber-600 px-4 py-2 text-sm font-bold text-white hover:bg-amber-500">
        Open custom resizer →
      </a>
    </div>
  </section>

  {notifications.length > 0 && (
    <section class="border-t border-line py-8">
      <h2 class="mb-4 text-xl font-bold text-navy-900">Forms open right now</h2>
      <div class="space-y-2">
        {notifications.map((n) => (
          <a href={"/blog/" + n.slug + "/"}
             class="block rounded-md border border-line px-4 py-3 hover:border-amber-500 hover:bg-surface">
            <span class="inline-block rounded bg-pass-bg px-2 py-0.5 text-xs font-semibold text-pass">{n.status}</span>
            <span class="mt-1 block text-sm font-semibold text-navy-800">{n.title}</span>
            <span class="text-xs text-muted">Closes {n.closes}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="border-t border-line py-8">
    <h2 class="mb-4 text-xl font-bold text-navy-900">Why FormSetu</h2>
    <div class="space-y-3">
      {reasons.map((r) => (
        <div class="rounded-lg border border-line bg-surface px-4 py-4">
          <h3 class="text-base font-bold text-navy-900">{r.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">{r.body}</p>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>

<script>
  const search = document.getElementById('examSearch');
  const cards = document.querySelectorAll('.exam-card');
  const groups = document.querySelectorAll('.exam-group');
  const noResults = document.getElementById('noResults');

  search.addEventListener('input', () => {
    const term = search.value.trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const match = card.dataset.name.includes(term);
      card.hidden = !match;
      if (match) visible++;
    });

    groups.forEach((group) => {
      group.hidden = group.querySelectorAll('.exam-card:not([hidden])').length === 0;
    });

    noResults.hidden = visible > 0;
  });
</script>