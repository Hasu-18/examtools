---
import BaseLayout from '../layouts/BaseLayout.astro';
import exams from '../data/exams.json';
import notifications from '../data/notifications.json';

// Update this from Cloudflare Analytics once you hit a real milestone.
const RESIZES_DONE = null;

const categories = [
  { key: 'central', label: 'SSC & Central' },
  { key: 'railway', label: 'Railway' },
  { key: 'banking', label: 'Banking' },
  { key: 'state', label: 'State PSC' },
  { key: 'police', label: 'Police & Defence' }
];

const latestVerified = exams
  .map((e) => e.lastVerified)
  .sort()
  .reverse()[0];

const verifiedLabel = new Date(latestVerified).toLocaleDateString('en-IN', {
  day: 'numeric', month: 'short', year: 'numeric'
});

const reasons = [
  {
    title: 'Nothing leaves your phone',
    body: 'Your photo is processed entirely in your browser. We never receive it, store it, or see it — unlike tools that upload to a server first.'
  },
  {
    title: 'Exact pixels and exact KB, together',
    body: 'Most tools do one or the other. Ours lands inside both limits at the highest quality that fits, so the portal accepts it first time.'
  },
  {
    title: 'Position your face properly',
    body: 'Drag and zoom to frame your photo correctly. Bad framing is one of the most common reasons applications get rejected.'
  },
  {
    title: 'Specs we actually check',
    body: 'Every exam page shows the date we last verified it against the official notification. If it is not checked, it is not published.'
  }
];
---
<BaseLayout title="FormSetu — Photo & Signature Size for Indian Government Exam Forms">

  <section class="pb-7">
    <h1 class="text-3xl font-bold leading-tight tracking-tight text-navy-900 sm:text-5xl">
      Get your form photo right<br />the first time.
    </h1>
    <p class="mt-4 text-base text-muted sm:text-lg">
      Exact photo and signature requirements for Indian government exams —
      with a free tool that resizes your file to match. No signup, no upload.
    </p>
  </section>

  <section class="pb-7">
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-lg border border-line bg-surface px-3 py-4 text-center">
        <p class="text-3xl font-bold text-navy-900">{exams.length}</p>
        <p class="mt-1 text-xs font-medium text-muted">Exams covered</p>
      </div>
      <div class="rounded-lg border border-line bg-surface px-3 py-4 text-center">
        <p class="text-3xl font-bold text-navy-900">{RESIZES_DONE ? RESIZES_DONE + '+' : '0'}</p>
        <p class="mt-1 text-xs font-medium text-muted">
          {RESIZES_DONE ? 'Photos resized' : 'Files ever uploaded'}
        </p>
      </div>
      <div class="rounded-lg border border-line bg-surface px-3 py-4 text-center">
        <p class="text-3xl font-bold text-navy-900">Free</p>
        <p class="mt-1 text-xs font-medium text-muted">Always, no signup</p>
      </div>
      <div class="rounded-lg border border-line bg-surface px-3 py-4 text-center">
        <p class="text-lg font-bold text-navy-900 sm:text-xl">{verifiedLabel}</p>
        <p class="mt-1 text-xs font-medium text-muted">Last updated</p>
      </div>
    </div>
  </section>

  <section class="border-t border-line py-7">
    <input
      type="search"
      id="examSearch"
      placeholder="Search your exam — SSC CGL, RRB, IBPS..."
      class="w-full rounded-md border border-line px-4 py-3 text-base focus:border-navy-600 focus:outline-none"
    />

    <h2 class="mt-7 mb-4 text-xl font-bold text-navy-900">Find your exam</h2>

    {categories.map((c) => {
      const items = exams.filter((e) => e.category === c.key);
      return items.length > 0 && (
        <div class="mb-6 exam-group">
          <h3 class="mb-2 text-xs font-bold uppercase tracking-wide text-navy-700">{c.label}</h3>
          <div class="grid grid-cols-2 gap-2">
            {items.map((e) => (
              <a href={"/exams/" + e.slug + "/"}
                 data-name={e.name.toLowerCase()}
                 class="exam-card rounded-md border border-line px-3 py-3 hover:border-navy-600 hover:bg-surface">
                <span class="block text-sm font-bold leading-tight text-navy-800">{e.name}</span>
                <span class="mt-1 block text-xs leading-snug text-muted">
                  {e.photo ? e.photo.widthPx + '×' + e.photo.heightPx + ' px' : 'Live photo capture'}
                </span>
              </a>
            ))}
          </div>
        </div>
      );
    })}

    <p id="noResults" class="text-sm text-muted" hidden>
      No exam matched. We add new exams every week — tell us which one you need.
    </p>
  </section>

  {notifications.length > 0 && (
    <section class="border-t border-line py-8">
      <h2 class="mb-4 text-xl font-bold text-navy-900">Forms open right now</h2>
      <div class="space-y-2">
        {notifications.map((n) => (
          <a href={"/blog/" + n.slug + "/"}
             class="block rounded-md border border-line px-4 py-3 hover:border-navy-600 hover:bg-surface">
            <span class="inline-block rounded bg-pass-bg px-2 py-0.5 text-xs font-semibold text-pass">{n.status}</span>
            <span class="mt-1 block text-sm font-semibold text-navy-800">{n.title}</span>
            <span class="text-xs text-muted">Closes {n.closes}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="border-t border-line py-8">
    <h2 class="mb-4 text-xl font-bold text-navy-900">Why FormSetu</h2>
    <div class="space-y-3">
      {reasons.map((r) => (
        <div class="rounded-lg border border-line border-l-4 border-l-amber-500 bg-surface px-4 py-4">
          <h3 class="text-base font-bold text-navy-900">{r.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">{r.body}</p>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>

<script>
  const search = document.getElementById('examSearch');
  const cards = document.querySelectorAll('.exam-card');
  const groups = document.querySelectorAll('.exam-group');
  const noResults = document.getElementById('noResults');

  search.addEventListener('input', () => {
    const term = search.value.trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const match = card.dataset.name.includes(term);
      card.hidden = !match;
      if (match) visible++;
    });

    groups.forEach((group) => {
      group.hidden = group.querySelectorAll('.exam-card:not([hidden])').length === 0;
    });

    noResults.hidden = visible > 0;
  });
</script>