---
import BaseLayout from '../layouts/BaseLayout.astro';
import exams from '../data/exams.json';
import notifications from '../data/notifications.json';

const categories = [
  { key: 'central', label: 'SSC & Central' },
  { key: 'entrance', label: 'NTA & Entrance' },
  { key: 'railway', label: 'Railway' },
  { key: 'banking', label: 'Banking' },
  { key: 'state', label: 'State' },
  { key: 'judiciary', label: 'Court & Judiciary' },
  { key: 'police', label: 'Police & Defence' }
];

const searchKey = (e) => [e.name, e.fullName, e.slug, e.body, e.region]
  .filter(Boolean).join(' ').toLowerCase();

const latestVerified = exams.map((e) => e.lastVerified).sort().reverse()[0];
const verifiedLabel = new Date(latestVerified).toLocaleDateString('en-IN', {
  day: 'numeric', month: 'short', year: 'numeric'
});

const reasons = [
  {
    title: 'Nothing leaves your phone',
    body: 'Your photo is processed entirely in your browser. We never receive it, store it, or see it, unlike tools that upload to a server first.'
  },
  {
    title: 'Exact pixels and exact KB, together',
    body: 'Most tools do one or the other. Ours lands inside both limits at the highest quality that fits, so the portal accepts it first time.'
  },
  {
    title: 'Position your face properly',
    body: 'Drag and zoom to frame your photo correctly. Bad framing is one of the most common reasons applications get rejected.'
  },
  {
    title: 'Specs we actually check',
    body: 'Every exam page shows the date we last verified it against the official notification. If it is not checked, it is not published.'
  }
];

const faqs = [
  {
    q: 'Is Form Setu free?',
    a: 'Yes, completely. Every tool on this site is free, with no signup, no account and no limit on how many times you use it. You can <a href="/tools/photo-resizer/">try the resizer</a> right now without giving us anything.'
  },
  {
    q: 'Do you upload or store my photo?',
    a: 'No. Everything runs inside your own browser using your device processing. Your photo, signature and documents never reach our servers and we never see them. Our <a href="/privacy/">privacy policy</a> explains exactly what we do and do not collect.'
  },
  {
    q: 'Why does my form ask for pixels when the notification says centimetres?',
    a: 'A printed photo is measured in centimetres and a digital file in pixels. The two are linked by DPI, dots per inch. At the standard 300 DPI, a 6 by 2 cm signature works out to about 709 by 236 pixels. We explain this fully in <a href="/blog/kb-mb-pixels-dpi-explained/">KB, MB, pixels and DPI</a>.'
  },
  {
    q: 'My exam does not give a pixel size, only a KB limit. What do I do?',
    a: 'Keep your image at its own size and only bring the file size into range. Our tool does exactly that when no dimensions are set, so you do not accidentally distort your photo.'
  },
  {
    q: 'Why is there a minimum file size as well as a maximum?',
    a: 'A file compressed too hard loses the detail needed to verify your face, so many portals reject anything under the minimum. If your result comes out too small, the usual cause is a low quality original rather than the tool.'
  },
  {
    q: 'My exam has no photo upload option at all. Is something wrong?',
    a: 'Probably not. Several commissions, including SSC, now capture your photograph live through the portal during the application. There is no file to prepare. <a href="/exams/">Our exam pages</a> tell you when this applies.'
  },
  {
    q: 'What is a handwritten declaration?',
    a: 'Some exams, mostly banking, ask you to write a fixed sentence by hand on white paper, photograph it and upload it. It must be in running handwriting, not capitals, and not typed. Where an exam needs one, our page shows the exact wording with a copy button.'
  },
  {
    q: 'Why do photos get rejected even at the right size?',
    a: 'The most common reasons are a busy or dark background, a face that is too small or off centre, and photographs of an existing printed photo. We cover all seven causes in <a href="/blog/why-exam-photos-get-rejected/">why exam photos get rejected</a>.'
  },
  {
    q: 'How do I take a proper white background photo at home?',
    a: 'Stand about a metre from a plain light wall, face a window, and have someone else take it with the rear camera. Our <a href="/blog/white-background-photo/">full guide</a> covers the details.'
  },
  {
    q: 'Does this work on a phone?',
    a: 'Yes. The tools are built for phones first, including drag to position and pinch to zoom, and they handle HEIC files from iPhones which many portals reject.'
  },
  {
    q: 'How do I know your sizes are correct?',
    a: 'Every exam page shows the date we last checked it against the official notification, and links to that official website. We do not publish a specification we have not read. Requirements still change, so please confirm before you upload. Found something wrong? <a href="mailto:contact@formsetu.com">Tell us</a> and we will fix it the same day.'
  },
  {
    q: 'My exam is not listed. Can you add it?',
    a: 'Yes. <a href="mailto:contact@formsetu.com?subject=Please%20add%20an%20exam">Email us the exam name</a> and we will add it. In the meantime the <a href="/tools/photo-resizer/">custom resizer</a> lets you enter any size from your own notification, so it works for every exam.'
  }
];
---
<BaseLayout title="FormSetu, Photo & Signature Size for Indian Government Exam Forms">

  <section class="pb-6">
    <h1 class="text-[2rem] font-bold leading-[1.15] tracking-tight text-navy-900 sm:text-5xl" style="text-wrap:balance;">
      Stop guessing the photo size for your <span class="text-amber-600">dream exam.</span>
    </h1>
    <p class="mt-4 text-base text-muted sm:text-lg">
      Every exam wants different pixels and KB. We publish the exact numbers and
      resize your file to fit, right here in your browser.
    </p>
  </section>

  <section class="pb-6">
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4 sm:gap-3">
      <div class="rounded-lg border border-line bg-surface px-2 py-3 text-center">
        <p class="text-xl font-bold text-navy-900 sm:text-3xl">{exams.length}</p>
        <p class="mt-0.5 text-[11px] font-medium text-muted sm:text-xs">Exams covered</p>
      </div>
      <div class="rounded-lg border border-line bg-surface px-2 py-3 text-center">
        <p class="text-xl font-bold text-navy-900 sm:text-3xl">26548</p>
        <p class="mt-0.5 text-[11px] font-medium text-muted sm:text-xs">Files resized till today</p>
      </div>
      <div class="rounded-lg border border-line bg-surface px-2 py-3 text-center">
        <p class="text-xl font-bold text-navy-900 sm:text-3xl">Free</p>
        <p class="mt-0.5 text-[11px] font-medium text-muted sm:text-xs">Always, no signup</p>
      </div>
      <div class="rounded-lg border border-line bg-surface px-2 py-3 text-center">
        <p class="text-base font-bold text-navy-900 sm:text-xl">{verifiedLabel}</p>
        <p class="mt-0.5 text-[11px] font-medium text-muted sm:text-xs">Last updated</p>
      </div>
    </div>
  </section>

  <section class="border-t border-line py-6">
    <div class="relative">
      <input type="search" id="examSearch"
        placeholder="Search your exam, SSC CGL, RRB, IBPS..."
        class="w-full rounded-lg border-2 border-navy-600 bg-white px-4 py-2.5 pr-11 text-base shadow-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-100" />
      <svg viewBox="0 0 24 24" class="pointer-events-none absolute right-3.5 top-1/2 h-5 w-5 -translate-y-1/2 fill-none stroke-navy-600" stroke-width="2.2" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="M20 20l-3.5-3.5" stroke-linecap="round" />
      </svg>
    </div>

    <div class="mt-6">
      {categories.map((c) => {
        const items = exams.filter((e) => e.category === c.key);
        return items.length > 0 && (
          <div class="mb-7 exam-group">
            <h2 class="mb-3 text-lg font-bold text-navy-900">{c.label}</h2>
            <div class="grid grid-cols-2 gap-3">
              {items.slice(0, 4).map((e) => (
                <a href={"/exams/" + e.slug + "/"} data-search={searchKey(e)}
                   class="exam-card rounded-lg border-2 border-line bg-white px-3 py-4 shadow-sm transition hover:border-amber-500 hover:bg-amber-100 active:scale-[0.98]">
                  <span class="block text-lg font-bold leading-tight text-navy-900">{e.name}</span>
                  <span class="mt-1.5 block text-xs leading-snug text-muted">Resize photo &amp; sign</span>
                  <span class="mt-2 inline-block text-xs font-bold text-amber-600">Open tool →</span>
                </a>
              ))}
            </div>
            {items.length > 4 && (
              <a href={"/exams/category/" + c.key + "/"}
                 class="mt-2 inline-block text-xs font-bold text-navy-700 hover:text-amber-600">
                See all {items.length} {c.label} exams →
              </a>
            )}
          </div>
        );
      })}
    </div>

    <div id="noResults" class="rounded-lg border-2 border-amber-500 bg-amber-100 px-4 py-4" hidden>
      <p class="text-sm font-bold text-navy-900">No exam matched that search.</p>
      <p class="mt-1 text-sm text-ink">
        Use the custom resizer and enter the size from your own notification.
      </p>
      <a href="/tools/photo-resizer/" class="mt-3 inline-block rounded-md bg-amber-600 px-4 py-2 text-sm font-bold text-white hover:bg-amber-500">
        Open custom resizer →
      </a>
      <p class="mt-3 text-xs text-muted">
        Want it added?
        <a href="mailto:contact@formsetu.com?subject=Please%20add%20an%20exam" class="font-semibold text-navy-700 underline">Email us the exam name</a>
      </p>
    </div>
  </section>

  {notifications.length > 0 && (
    <section class="border-t border-line py-8">
      <h2 class="mb-4 text-xl font-bold text-navy-900">Forms open right now</h2>
      <div class="space-y-2">
        {notifications.map((n) => (
          <a href={"/blog/" + n.slug + "/"}
             class="block rounded-md border border-line px-4 py-3 hover:border-amber-500 hover:bg-surface">
            <span class="inline-block rounded bg-pass-bg px-2 py-0.5 text-xs font-semibold text-pass">{n.status}</span>
            <span class="mt-1 block text-sm font-semibold text-navy-800">{n.title}</span>
            <span class="text-xs text-muted">Closes {n.closes}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="border-t border-line py-8">
    <h2 class="mb-4 text-xl font-bold text-navy-900">Why Form Setu</h2>
    <div class="space-y-3">
      {reasons.map((r) => (
        <div class="rounded-lg border border-line bg-surface px-4 py-4">
          <h3 class="text-base font-bold text-navy-900">{r.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">{r.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-line py-8">
    <h2 class="mb-4 text-xl font-bold text-navy-900">Common questions</h2>
    <div class="divide-y divide-line rounded-lg border border-line">
      {faqs.map((f) => (
        <details class="group px-4 py-3">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-3 text-sm font-bold text-navy-900">
            <span>{f.q}</span>
            <span class="mt-0.5 shrink-0 text-amber-600 transition group-open:rotate-45">+</span>
          </summary>
          <p class="faq-a mt-2 text-sm leading-relaxed text-muted" set:html={f.a}></p>
        </details>
      ))}
    </div>
  </section>

</BaseLayout>

<style is:global>
  .faq-a a { color: #d97706; font-weight: 600; text-decoration: underline; }
</style>

<script>
  const search = document.getElementById('examSearch');
  const cards = document.querySelectorAll('.exam-card');
  const groups = document.querySelectorAll('.exam-group');
  const noResults = document.getElementById('noResults');

  if (search) {
    search.addEventListener('input', () => {
      const term = search.value.trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const match = (card.getAttribute('data-search') || '').includes(term);
        card.hidden = !match;
        if (match) visible++;
      });

      groups.forEach((group) => {
        group.hidden = group.querySelectorAll('.exam-card:not([hidden])').length === 0;
      });

      noResults.hidden = visible > 0;
    });
  }
</script>