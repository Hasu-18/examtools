---
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Exam data builder — FormSetu admin</title>
  <style>
    :root { --ink:#111827; --muted:#4b5563; --line:#e5e7eb; --navy:#0b1f35; --amber:#d97706; --surface:#f8fafc; }
    * { box-sizing: border-box; }
    body { margin:0; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color:var(--ink); background:#fff; line-height:1.5; }
    .wrap { max-width: 900px; margin:0 auto; padding:1.5rem 1rem 4rem; }
    h1 { font-size:1.5rem; margin:0 0 .25rem; color:var(--navy); }
    h2 { font-size:1.05rem; margin:1.75rem 0 .5rem; color:var(--navy); }
    p.sub { color:var(--muted); font-size:.9rem; margin:0 0 1.25rem; }
    fieldset { border:1px solid var(--line); border-radius:8px; padding:1rem; margin:0 0 1rem; }
    legend { font-size:.8rem; font-weight:700; text-transform:uppercase; letter-spacing:.03em; color:var(--navy); padding:0 .4rem; }
    label { display:block; font-size:.8rem; color:var(--muted); margin-bottom:.65rem; }
    label span { display:block; margin-bottom:.2rem; }
    input, select, textarea { width:100%; border:1px solid var(--line); border-radius:6px; padding:.5rem .6rem; font-size:.9rem; font-family:inherit; }
    textarea { min-height:70px; resize:vertical; }
    .row { display:grid; gap:.75rem; }
    .row-2 { grid-template-columns:1fr 1fr; }
    .row-3 { grid-template-columns:1fr 1fr 1fr; }
    .row-4 { grid-template-columns:1fr 1fr 1fr 1fr; }
    button { border:0; border-radius:6px; padding:.7rem 1.1rem; font-size:.9rem; font-weight:700; cursor:pointer; }
    .primary { background:var(--amber); color:#fff; }
    .dark { background:var(--navy); color:#fff; }
    .ghost { background:#fff; color:var(--navy); border:1px solid var(--line); }
    .bar { display:flex; flex-wrap:wrap; gap:.5rem; margin-top:1rem; }
    .note { background:#fef3c7; border-left:4px solid var(--amber); padding:.7rem .9rem; border-radius:6px; font-size:.85rem; margin:1rem 0; }
    #list { list-style:none; padding:0; margin:.5rem 0 0; }
    #list li { display:flex; justify-content:space-between; align-items:center; border:1px solid var(--line); border-radius:6px; padding:.5rem .7rem; margin-bottom:.4rem; font-size:.85rem; }
    #list button { background:none; color:#b91c1c; font-size:.8rem; padding:.2rem .4rem; }
    #out { width:100%; min-height:220px; font-family:ui-monospace, Consolas, monospace; font-size:.75rem; }
    .hint { font-size:.75rem; color:var(--muted); margin:.25rem 0 0; }
    @media (max-width:640px){ .row-2,.row-3,.row-4 { grid-template-columns:1fr; } }
  </style>
</head>
<body>
<button type="button" id="jumpTop" title="Back to Add an exam"
  style="position:fixed;left:16px;bottom:16px;z-index:99;width:46px;height:46px;border-radius:50%;background:#0b1f35;color:#fff;font-size:20px;line-height:1;box-shadow:0 4px 12px rgba(0,0,0,.25);padding:0;">
  &#8593;
</button>
<div class="wrap">

  <h1>Exam data builder</h1>
  <p class="sub">Fill the form, add each exam, then download the finished exams.json and replace the file in src/data/.</p>

  <div class="note">
    Enter sizes in whatever unit the notification uses. The site will show that same
    unit to visitors, so the page matches the notification exactly.
  </div>

  <h2>Step 1 — Load what you already have</h2>
  <label>
    <span style="display:flex;align-items:center;justify-content:space-between;">
      <span>Paste your current src/data/exams.json (or leave empty to start fresh)</span>
      <button type="button" id="lockBtn" style="background:none;border:1px solid var(--line);border-radius:6px;padding:.25rem .55rem;font-size:.75rem;color:var(--navy);">
        &#128274; Locked, click to edit
      </button>
    </span>
    <textarea id="existing" placeholder="[ ... ]" readonly style="background:#f8fafc;"></textarea>
  </label>
  <button class="ghost" id="loadBtn">Load existing exams</button>
  <p class="hint" id="loadMsg"></p>

  <h2>Step 2 — Add an exam</h2>

  <fieldset>
    <legend>Quick fill from JSON (optional)</legend>
    <label>
      <span>Paste an exam object here and the form below will fill itself</span>
      <textarea id="pasteJson" placeholder='{ "name": "SSC CHSL", "slug": "ssc-chsl", "category": "central", ... }'></textarea>
    </label>
    <button type="button" class="ghost" id="fetchBtn">Fill the form from this JSON</button>
    <p class="hint" id="fetchMsg">Nothing is saved until you click Add this exam, so you can check and change anything first.</p>
  </fieldset>

  <fieldset>
    <legend>Basics</legend>
    <div class="row row-2">
      <label><span>Exam name (shown on the page)</span><input id="f_name" placeholder="IBPS PO" /></label>
      <label><span>Slug (URL)</span><input id="f_slug" placeholder="ibps-po" /></label>
    </div>
    <label><span>Full name</span><input id="f_full" placeholder="Institute of Banking Personnel Selection Probationary Officer" /></label>
    <div class="row row-4">
      <label><span>Body</span><input id="f_body" placeholder="IBPS" /></label>
      <label><span>Category</span>
        <select id="f_cat">
          <option value="central">central — SSC, UPSC CSE, other central</option>
          <option value="entrance">entrance — NTA, NEET, JEE, CUET, UGC NET</option>
          <option value="railway">railway — RRB</option>
          <option value="banking">banking — IBPS, SBI, RBI</option>
          <option value="state">state — State PSC and state boards</option>
          <option value="judiciary">judiciary — High Court, District Court</option>
          <option value="police">police — police, NDA, CDS, CAPF, defence</option>
        </select>
      </label>
      <label><span>Year</span><input id="f_year" type="number" value="2026" /></label>
      <label><span>Verified on</span><input id="f_ver" type="date" /></label>
    </div>
    <div class="row row-2">
      <label><span>Official URL</span><input id="f_url" placeholder="https://ibps.in" /></label>
      <label><span>State (leave blank for national exams)</span>
        <input id="f_region" placeholder="West Bengal, Bihar, Maharashtra" list="regionList" />
        <datalist id="regionList">
          <option value="Andhra Pradesh"></option><option value="Assam"></option>
          <option value="Bihar"></option><option value="Chhattisgarh"></option>
          <option value="Delhi"></option><option value="Gujarat"></option>
          <option value="Haryana"></option><option value="Himachal Pradesh"></option>
          <option value="Jharkhand"></option><option value="Karnataka"></option>
          <option value="Kerala"></option><option value="Madhya Pradesh"></option>
          <option value="Maharashtra"></option><option value="Odisha"></option>
          <option value="Punjab"></option><option value="Rajasthan"></option>
          <option value="Tamil Nadu"></option><option value="Telangana"></option>
          <option value="Uttar Pradesh"></option><option value="Uttarakhand"></option>
          <option value="West Bengal"></option>
        </datalist>
      </label>
    </div>
  </fieldset>

  <fieldset>
    <legend>What does this exam ask for?</legend>
    <label>
      <select id="f_pattern">
        <option value="ps">Photo + Signature</option>
        <option value="pst">Photo + Signature + Thumb</option>
        <option value="pstd">Photo + Signature + Thumb + Declaration (IBPS style)</option>
        <option value="psd">Photo + Signature + Declaration</option>
        <option value="live_s">Live photo + Signature</option>
        <option value="live_st">Live photo + Signature + Thumb</option>
        <option value="live_std">Live photo + Signature + Thumb + Declaration</option>
        <option value="live_only">Everything captured live, nothing to upload</option>
        <option value="comb">Combined image only (photo above, signature below)</option>
        <option value="comb_s">Combined image + separate Signature</option>
      </select>
    </label>
    <p class="hint">Only the sections this exam needs will appear below.</p>
  </fieldset>

  <fieldset id="fs_live" hidden>
    <legend>Live capture guidance</legend>
    <label><span>One instruction per line</span><textarea id="f_live">Use a well-lit place with a plain background
Keep the camera at eye level and look straight ahead
No cap, mask or spectacles</textarea></label>
  </fieldset>

  <fieldset id="fs_photo">
    <legend>Photo</legend>
    <div class="row row-4">
      <label><span>Width</span><input id="p_w" type="number" step="any" /></label>
      <label><span>Height</span><input id="p_h" type="number" step="any" /></label>
      <label><span>Unit</span>
        <select id="p_unit"><option>px</option><option>cm</option><option>mm</option><option>in</option></select>
      </label>
      <label><span>DPI (for cm/mm/in)</span><input id="p_dpi" type="number" value="300" /></label>
    </div>
    <div class="row row-3">
      <label><span>Min KB</span><input id="p_min" type="number" /></label>
      <label><span>Max KB</span><input id="p_max" type="number" /></label>
      <label><span>Format</span><input id="p_fmt" value="jpg" /></label>
    </div>
    <label><span>Background</span><input id="p_bg" placeholder="white or light coloured" /></label>
    <label><span>Notes, one per line</span><textarea id="p_notes"></textarea></label>
  </fieldset>

  <fieldset id="fs_combined" hidden>
    <legend>Combined image</legend>
    <div class="row row-4">
      <label><span>Width</span><input id="c_w" type="number" step="any" /></label>
      <label><span>Height</span><input id="c_h" type="number" step="any" /></label>
      <label><span>Unit</span>
        <select id="c_unit"><option>px</option><option>cm</option><option>mm</option><option>in</option></select>
      </label>
      <label><span>DPI</span><input id="c_dpi" type="number" value="300" /></label>
    </div>
    <div class="row row-4">
      <label><span>Min KB</span><input id="c_min" type="number" /></label>
      <label><span>Max KB</span><input id="c_max" type="number" /></label>
      <label><span>Format</span><input id="c_fmt" value="jpg" /></label>
      <label><span>Photo share (0.72 = 72%)</span><input id="c_ratio" type="number" step="0.01" value="0.72" /></label>
    </div>
    <label><span>Notes, one per line</span><textarea id="c_notes">Photograph on top, signature directly below</textarea></label>
  </fieldset>

  <fieldset id="fs_sign">
    <legend>Signature</legend>
    <div class="row row-4">
      <label><span>Width</span><input id="s_w" type="number" step="any" /></label>
      <label><span>Height</span><input id="s_h" type="number" step="any" /></label>
      <label><span>Unit</span>
        <select id="s_unit"><option>px</option><option>cm</option><option>mm</option><option>in</option></select>
      </label>
      <label><span>DPI</span><input id="s_dpi" type="number" value="300" /></label>
    </div>
    <div class="row row-3">
      <label><span>Min KB</span><input id="s_min" type="number" /></label>
      <label><span>Max KB</span><input id="s_max" type="number" /></label>
      <label><span>Format</span><input id="s_fmt" value="jpg" /></label>
    </div>
    <label><span>Ink colour</span>
      <select id="s_ink">
        <option value="">Not specified in the notification</option>
        <option value="black">Black</option>
        <option value="blue">Blue</option>
        <option value="black or blue">Black or blue</option>
      </select>
    </label>
    <label><span>Notes, one per line</span><textarea id="s_notes"></textarea></label>
  </fieldset>

  <fieldset id="fs_thumb" hidden>
    <legend>Left thumb impression</legend>
    <div class="row row-4">
      <label><span>Width</span><input id="t_w" type="number" step="any" /></label>
      <label><span>Height</span><input id="t_h" type="number" step="any" /></label>
      <label><span>Unit</span>
        <select id="t_unit"><option>px</option><option>cm</option><option>mm</option><option>in</option></select>
      </label>
      <label><span>DPI</span><input id="t_dpi" type="number" value="300" /></label>
    </div>
    <div class="row row-3">
      <label><span>Min KB</span><input id="t_min" type="number" /></label>
      <label><span>Max KB</span><input id="t_max" type="number" /></label>
      <label><span>Format</span><input id="t_fmt" value="jpg" /></label>
    </div>
    <label><span>Ink colour</span>
      <select id="t_ink">
        <option value="">Not specified in the notification</option>
        <option value="black">Black</option>
        <option value="blue">Blue</option>
        <option value="black or blue">Black or blue</option>
      </select>
    </label>
    <label><span>Notes, one per line</span><textarea id="t_notes"></textarea></label>
  </fieldset>

  <fieldset id="fs_decl" hidden>
    <legend>Handwritten declaration</legend>
    <div class="row row-4">
      <label><span>Width</span><input id="d_w" type="number" step="any" /></label>
      <label><span>Height</span><input id="d_h" type="number" step="any" /></label>
      <label><span>Unit</span>
        <select id="d_unit"><option>px</option><option>cm</option><option>mm</option><option>in</option></select>
      </label>
      <label><span>DPI</span><input id="d_dpi" type="number" value="300" /></label>
    </div>
    <div class="row row-3">
      <label><span>Min KB</span><input id="d_min" type="number" /></label>
      <label><span>Max KB</span><input id="d_max" type="number" /></label>
      <label><span>Format</span><input id="d_fmt" value="jpg" /></label>
    </div>
    <label>
      <span>The exact text the candidate must write, copied word for word from the notification</span>
      <textarea id="d_text" placeholder="I, _______ (Name of the candidate), hereby declare that all the information submitted by me in the application form is correct, true and valid..."></textarea>
    </label>
    <label><span>Notes, one per line</span><textarea id="d_notes"></textarea></label>
  </fieldset>

  <div class="bar">
    <button class="primary" id="addBtn">Add this exam</button>
    <button class="ghost" id="clearFormBtn">Clear form</button>
  </div>
  <p class="hint" id="addMsg"></p>

  <h2>Step 3 — Your exams (<span id="count">0</span>)</h2>
  <div class="row row-3" style="margin-bottom:.75rem;">
    <label style="margin:0;"><span>Filter by category</span>
      <select id="flt_cat"><option value="">All categories</option></select>
    </label>
    <label style="margin:0;"><span>Filter by body</span>
      <select id="flt_body"><option value="">All bodies</option></select>
    </label>
    <label style="margin:0;"><span>Filter by state</span>
      <select id="flt_region"><option value="">All states</option></select>
    </label>
  </div>
  <label><span>Search by name</span><input id="flt_text" placeholder="Type part of an exam name" /></label>
  <p class="hint" id="showing"></p>
  <ul id="list"></ul>

  <h2>Step 4 — Take the file</h2>
  <textarea id="out" readonly></textarea>
  <div class="bar">
    <button class="dark" id="copyBtn">Copy JSON</button>
    <button class="dark" id="dlBtn">Download exams.json</button>
  </div>
  <p class="hint">Replace src/data/exams.json with this, then commit and push.</p>

</div>

<script>
  var exams = [];
  var editIndex = null;
  var g = function (id) { return document.getElementById(id); };

  var PATTERNS = {
    ps:        { live:false, photo:true,  combined:false, sign:true,  thumb:false, decl:false },
    pst:       { live:false, photo:true,  combined:false, sign:true,  thumb:true,  decl:false },
    pstd:      { live:false, photo:true,  combined:false, sign:true,  thumb:true,  decl:true  },
    psd:       { live:false, photo:true,  combined:false, sign:true,  thumb:false, decl:true  },
    live_s:    { live:true,  photo:false, combined:false, sign:true,  thumb:false, decl:false },
    live_st:   { live:true,  photo:false, combined:false, sign:true,  thumb:true,  decl:false },
    live_std:  { live:true,  photo:false, combined:false, sign:true,  thumb:true,  decl:true  },
    live_only: { live:true,  photo:false, combined:false, sign:false, thumb:false, decl:false },
    comb:      { live:false, photo:false, combined:true,  sign:false, thumb:false, decl:false },
    comb_s:    { live:false, photo:false, combined:true,  sign:true,  thumb:false, decl:false }
  };

  g('f_ver').value = new Date().toISOString().slice(0, 10);

  function toPx(value, unit, dpi) {
    if (!value) return null;
    var v = Number(value);
    var d = Number(dpi) || 300;
    if (unit === 'cm') return Math.round(v / 2.54 * d);
    if (unit === 'mm') return Math.round(v / 25.4 * d);
    if (unit === 'in') return Math.round(v * d);
    return Math.round(v);
  }

  function lines(id) {
    var raw = g(id).value.trim();
    if (!raw) return [];
    return raw.split('\n').map(function (s) { return s.trim(); }).filter(Boolean);
  }

  function num(id) { var v = g(id).value; return v === '' ? null : Number(v); }
  function txt(id) { var v = g(id).value.trim(); return v === '' ? null : v; }

  function block(prefix, kind) {
    var unit = g(prefix + '_unit').value;
    var dpi = Number(g(prefix + '_dpi').value) || 300;
    var rawW = g(prefix + '_w').value;
    var rawH = g(prefix + '_h').value;
    var w = toPx(rawW, unit, dpi);
    var h = toPx(rawH, unit, dpi);
    var minKB = num(prefix + '_min');
    var maxKB = num(prefix + '_max');

    // Nothing at all entered, so this section does not apply to this exam
    if (!w && !h && minKB === null && maxKB === null) return null;

    var hasSize = !!(w && h);

    var o = {
      widthPx: hasSize ? w : null,
      heightPx: hasSize ? h : null,
      unit: hasSize ? unit : null,
      displayWidth: hasSize ? Number(rawW) : null,
      displayHeight: hasSize ? Number(rawH) : null,
      dpi: (hasSize && unit !== 'px') ? dpi : null,
      minKB: minKB,
      maxKB: maxKB,
      format: txt(prefix + '_fmt') || 'jpg'
    };

    if (hasSize && unit === 'cm') { o.widthCm = Number(rawW); o.heightCm = Number(rawH); }
    if (kind === 'photo') o.background = txt(prefix + '_bg') || '';
    if (kind === 'sign' || kind === 'thumb') o.ink = txt(prefix + '_ink') || 'not specified';
    if (kind === 'combined') o.photoRatio = Number(g('c_ratio').value) || 0.72;
    if (kind === 'declaration') o.text = txt(prefix + '_text') || '';

    o.notes = lines(prefix + '_notes');
    return o;
  }

  function fillBlock(prefix, b) {
    if (!b) {
      ['_w','_h','_min','_max','_notes','_bg','_ink','_text'].forEach(function (s) {
        if (g(prefix + s)) g(prefix + s).value = '';
      });
      return;
    }
    g(prefix + '_unit').value = b.unit || 'px';
    g(prefix + '_w').value = (b.displayWidth != null) ? b.displayWidth : (b.widthPx != null ? b.widthPx : '');
    g(prefix + '_h').value = (b.displayHeight != null) ? b.displayHeight : (b.heightPx != null ? b.heightPx : '');
    if (g(prefix + '_dpi')) g(prefix + '_dpi').value = b.dpi || 300;
    g(prefix + '_min').value = (b.minKB != null) ? b.minKB : '';
    g(prefix + '_max').value = (b.maxKB != null) ? b.maxKB : '';
    g(prefix + '_fmt').value = b.format || 'jpg';
    if (g(prefix + '_bg')) g(prefix + '_bg').value = b.background || '';
    if (g(prefix + '_ink')) g(prefix + '_ink').value = (b.ink && b.ink !== 'not specified') ? b.ink : '';
    if (prefix === 'c' && g('c_ratio')) g('c_ratio').value = b.photoRatio || 0.72;
    if (g(prefix + '_text')) g(prefix + '_text').value = b.text || '';
    g(prefix + '_notes').value = (b.notes || []).join('\n');
  }

  function detectPattern(e) {
    var want = {
      live: e.captureMode === 'live', photo: !!e.photo, combined: !!e.combined,
      sign: !!e.signature, thumb: !!e.thumb, decl: !!e.declaration
    };
    var keys = Object.keys(PATTERNS);
    for (var i = 0; i < keys.length; i++) {
      var c = PATTERNS[keys[i]];
      if (c.live === want.live && c.photo === want.photo && c.combined === want.combined &&
          c.sign === want.sign && c.thumb === want.thumb && c.decl === want.decl) return keys[i];
    }
    return 'ps';
  }

  function syncPattern() {
    var cfg = PATTERNS[g('f_pattern').value] || PATTERNS.ps;
    g('fs_live').hidden = !cfg.live;
    g('fs_photo').hidden = !cfg.photo;
    g('fs_combined').hidden = !cfg.combined;
    g('fs_sign').hidden = !cfg.sign;
    g('fs_thumb').hidden = !cfg.thumb;
    g('fs_decl').hidden = !cfg.decl;
  }
  g('f_pattern').addEventListener('change', syncPattern);
  syncPattern();

  function setMode() {
    if (editIndex === null) {
      g('addBtn').textContent = 'Add this exam';
      g('clearFormBtn').textContent = 'Clear form';
    } else {
      g('addBtn').textContent = 'Save changes to ' + exams[editIndex].name;
      g('clearFormBtn').textContent = 'Cancel edit';
    }
  }

  function fillForm(e) {
    g('f_name').value = e.name || '';
    g('f_slug').value = e.slug || '';
    g('f_full').value = e.fullName || '';
    g('f_body').value = e.body || '';
    g('f_cat').value = e.category || 'central';
    g('f_year').value = e.year || 2026;
    g('f_ver').value = e.lastVerified || new Date().toISOString().slice(0, 10);
    g('f_url').value = e.officialUrl || '';
    g('f_region').value = e.region || '';

    g('f_pattern').value = detectPattern(e);
    syncPattern();

    g('f_live').value = (e.liveCaptureNotes || []).join('\n');
    fillBlock('p', e.photo);
    fillBlock('c', e.combined);
    fillBlock('s', e.signature);
    fillBlock('t', e.thumb);
    fillBlock('d', e.declaration);
  }

  function loadIntoForm(i) {
    var e = exams[i];
    editIndex = i;
    fillForm(e);
    setMode();
    g('addMsg').textContent = 'Editing ' + e.name + '. Change anything, then save.';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  g('fetchBtn').addEventListener('click', function () {
    var raw = g('pasteJson').value.trim();
    if (!raw) { g('fetchMsg').textContent = 'Paste some JSON first.'; return; }
    try {
      var obj = JSON.parse(raw);
      if (Array.isArray(obj)) obj = obj[0];
      if (!obj || typeof obj !== 'object') throw new Error('bad shape');
      editIndex = null;
      fillForm(obj);
      setMode();
      g('fetchMsg').textContent = 'Form filled. Check every value against the notification, then click Add this exam.';
      window.scrollTo({ top: g('f_name').getBoundingClientRect().top + window.scrollY - 80, behavior: 'smooth' });
    } catch (err) {
      g('fetchMsg').textContent = 'That is not valid JSON. Check for a missing comma or bracket.';
    }
  });

  function fillFilter(id, values) {
    var sel = g(id);
    var current = sel.value;
    var first = sel.options[0].textContent;
    sel.innerHTML = '';
    var o0 = document.createElement('option');
    o0.value = ''; o0.textContent = first;
    sel.appendChild(o0);
    values.sort().forEach(function (v) {
      var o = document.createElement('option');
      o.value = v; o.textContent = v;
      sel.appendChild(o);
    });
    sel.value = current;
  }

  function refreshFilters() {
    var cats = [], bodies = [], regions = [];
    exams.forEach(function (e) {
      if (e.category && cats.indexOf(e.category) === -1) cats.push(e.category);
      if (e.body && bodies.indexOf(e.body) === -1) bodies.push(e.body);
      if (e.region && regions.indexOf(e.region) === -1) regions.push(e.region);
    });
    fillFilter('flt_cat', cats);
    fillFilter('flt_body', bodies);
    fillFilter('flt_region', regions);
  }

  function render() {
    g('count').textContent = String(exams.length);
    refreshFilters();

    var fc = g('flt_cat').value;
    var fb = g('flt_body').value;
    var fr = g('flt_region').value;
    var ft = g('flt_text').value.trim().toLowerCase();

    var ul = g('list');
    ul.innerHTML = '';
    var shown = 0;

    exams.forEach(function (e, i) {
      if (fc && e.category !== fc) return;
      if (fb && e.body !== fb) return;
      if (fr && e.region !== fr) return;
      if (ft && (e.name || '').toLowerCase().indexOf(ft) === -1) return;
      shown++;

      var li = document.createElement('li');
      if (i === editIndex) li.style.borderColor = '#d97706';

      var parts = [];
      if (e.photo) parts.push('photo');
      if (e.captureMode === 'live') parts.push('live photo');
      if (e.combined) parts.push('combined');
      if (e.signature) parts.push('signature');
      if (e.thumb) parts.push('thumb');
      if (e.declaration) parts.push('declaration');

      var label = document.createElement('span');
      label.textContent = e.name + '  ·  ' + (e.category || '') +
        (e.region ? ' · ' + e.region : '') + '  ·  ' + parts.join(' + ');

      var btns = document.createElement('span');
      btns.style.display = 'flex';
      btns.style.gap = '.3rem';
      btns.style.flexShrink = '0';

      var edit = document.createElement('button');
      edit.textContent = 'Edit';
      edit.style.color = '#0b1f35';
      edit.addEventListener('click', function () { loadIntoForm(i); render(); });

      var del = document.createElement('button');
      del.textContent = 'Remove';
      del.addEventListener('click', function () {
        exams.splice(i, 1);
        if (editIndex === i) { editIndex = null; setMode(); }
        else if (editIndex !== null && editIndex > i) editIndex--;
        render();
      });

      btns.appendChild(edit);
      btns.appendChild(del);
      li.appendChild(label);
      li.appendChild(btns);
      ul.appendChild(li);
    });

    g('showing').textContent = (shown === exams.length)
      ? 'Showing all ' + exams.length
      : 'Showing ' + shown + ' of ' + exams.length;

    g('out').value = JSON.stringify(exams, null, 2);
  }

  ['flt_cat','flt_body','flt_region'].forEach(function (id) {
    g(id).addEventListener('change', render);
  });
  g('flt_text').addEventListener('input', render);

  g('loadBtn').addEventListener('click', function () {
    var raw = g('existing').value.trim();
    if (!raw) { g('loadMsg').textContent = 'Nothing pasted, starting fresh.'; return; }
    try {
      var parsed = JSON.parse(raw);
      if (!Array.isArray(parsed)) throw new Error('not an array');
      exams = parsed;
      editIndex = null;
      setMode();
      g('loadMsg').textContent = 'Loaded ' + exams.length + ' exams. Use Edit on any of them to change it.';
      render();
    } catch (err) {
      g('loadMsg').textContent = 'That is not valid JSON. Check for a missing or extra comma.';
    }
  });

  g('addBtn').addEventListener('click', function () {
    var name = txt('f_name');
    var slug = txt('f_slug');
    if (!name || !slug) { g('addMsg').textContent = 'Name and slug are required.'; return; }

    var cfg = PATTERNS[g('f_pattern').value] || PATTERNS.ps;

    var exam = {
      slug: slug.toLowerCase().replace(/\s+/g, '-'),
      name: name,
      fullName: txt('f_full') || '',
      body: txt('f_body') || '',
      category: g('f_cat').value,
      region: txt('f_region') || null,
      year: Number(g('f_year').value) || 2026,
      officialUrl: txt('f_url') || '',
      lastVerified: g('f_ver').value,
      captureMode: cfg.live ? 'live' : 'upload',
      photo: cfg.photo ? block('p', 'photo') : null,
      combined: cfg.combined ? block('c', 'combined') : null,
      signature: cfg.sign ? block('s', 'sign') : null,
      thumb: cfg.thumb ? block('t', 'thumb') : null,
      declaration: cfg.decl ? block('d', 'declaration') : null,
      documents: null
    };

    if (cfg.live) exam.liveCaptureNotes = lines('f_live');

    if (editIndex === null) {
      exams.push(exam);
      g('addMsg').textContent = 'Added ' + name + '. You now have ' + exams.length + ' exams.';
    } else {
      exams[editIndex] = exam;
      g('addMsg').textContent = 'Saved changes to ' + name + '.';
      editIndex = null;
      setMode();
    }

    render();
    window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
  });

  g('clearFormBtn').addEventListener('click', function () {
    ['f_name','f_slug','f_full','f_body','f_url','f_region',
     'p_w','p_h','p_min','p_max','p_bg','p_notes',
     'c_w','c_h','c_min','c_max','c_notes',
     's_w','s_h','s_min','s_max','s_notes',
     't_w','t_h','t_min','t_max','t_notes',
     'd_w','d_h','d_min','d_max','d_text','d_notes'].forEach(function (id) {
      if (g(id)) g(id).value = '';
    });
    editIndex = null;
    setMode();
    render();
    g('addMsg').textContent = '';
  });

  g('copyBtn').addEventListener('click', async function () {
    await navigator.clipboard.writeText(g('out').value);
    g('copyBtn').textContent = 'Copied';
    setTimeout(function () { g('copyBtn').textContent = 'Copy JSON'; }, 1500);
  });

  g('dlBtn').addEventListener('click', function () {
    var blob = new Blob([g('out').value], { type: 'application/json' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'exams.json';
    a.click();
    URL.revokeObjectURL(a.href);
  });

  setMode();
  g('jumpTop').addEventListener('click', function () {
    var el = g('pasteJson') || g('f_name');
    window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 90, behavior: 'smooth' });
  });
  var unlocked = false;
  g('lockBtn').addEventListener('click', function () {
    unlocked = !unlocked;
    g('existing').readOnly = !unlocked;
    g('existing').style.background = unlocked ? '#fff' : '#f8fafc';
    g('lockBtn').innerHTML = unlocked ? '&#128275; Unlocked, click to lock' : '&#128274; Locked, click to edit';
    if (unlocked) g('existing').focus();
  });
  render();
</script>
</body>
</html>