---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Free Tools for Exam Form Documents | FormSetu">
  <h1 class="text-2xl font-bold text-navy-900">Tools</h1>
  <p class="mt-2 text-sm text-muted">
    Everything runs in your browser. Nothing is uploaded.
  </p>

  <div class="mt-6 grid gap-3 sm:grid-cols-2">
    <a href="/tools/photo-resizer/"
       class="rounded-lg border border-line px-4 py-4 hover:border-navy-600 hover:bg-surface">
      <span class="block font-bold text-navy-800">Photo &amp; signature resizer</span>
      <span class="mt-1 block text-sm text-muted">
        Any size, in px, cm or inches. Hits your pixel and KB limits together.
      </span>
    </a>
  </div>
</BaseLayout>