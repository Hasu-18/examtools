---
import exams from '../data/exams.json';
const examList = exams.map((e) => ({
  slug: e.slug,
  name: e.name,
  full: e.fullName || '',
  body: e.body || '',
  cat: e.category || ''
}));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Book builder — Form Setu admin</title>
  <style>
    :root { --ink:#111827; --muted:#4b5563; --line:#e5e7eb; --navy:#0b1f35; --amber:#d97706; --pass:#15803d; --fail:#b91c1c; --surface:#f8fafc; }
    * { box-sizing:border-box; }
    body { margin:0; font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; color:var(--ink); background:#fff; line-height:1.5; }
    .wrap { max-width:1000px; margin:0 auto; padding:1.5rem 1rem 5rem; }
    h1 { font-size:1.5rem; margin:0 0 .25rem; color:var(--navy); }
    h2 { font-size:1.05rem; margin:1.75rem 0 .5rem; color:var(--navy); }
    p.sub { color:var(--muted); font-size:.9rem; margin:0 0 1.25rem; }
    fieldset { border:1px solid var(--line); border-radius:8px; padding:1rem; margin:0 0 1rem; }
    legend { font-size:.8rem; font-weight:700; text-transform:uppercase; letter-spacing:.03em; color:var(--navy); padding:0 .4rem; }
    label { display:block; font-size:.8rem; color:var(--muted); margin-bottom:.65rem; }
    label span { display:block; margin-bottom:.2rem; }
    input, select, textarea { width:100%; border:1px solid var(--line); border-radius:6px; padding:.5rem .6rem; font-size:.9rem; font-family:inherit; }
    textarea { min-height:70px; resize:vertical; }
    button { border:0; border-radius:6px; padding:.7rem 1.1rem; font-size:.9rem; font-weight:700; cursor:pointer; }
    .primary { background:var(--amber); color:#fff; }
    .dark { background:var(--navy); color:#fff; }
    .ghost { background:#fff; color:var(--navy); border:1px solid var(--line); }
    .bar { display:flex; flex-wrap:wrap; gap:.5rem; margin-top:1rem; }
    .note { background:#fef3c7; border-left:4px solid var(--amber); padding:.7rem .9rem; border-radius:6px; font-size:.85rem; margin:1rem 0; }
    .books { display:grid; grid-template-columns:repeat(3,1fr); gap:.75rem; }
    .bk { border:1px solid var(--line); border-radius:8px; padding:.85rem; }
    .bk h3 { margin:0 0 .6rem; font-size:.8rem; text-transform:uppercase; letter-spacing:.03em; color:var(--navy); }
    .grp { border:1px solid var(--line); border-radius:8px; padding:.8rem; margin-bottom:.5rem; }
    .grp .top { display:flex; justify-content:space-between; align-items:flex-start; gap:.5rem; }
    .grp h4 { margin:0 0 .1rem; font-size:.92rem; color:var(--navy); }
    .grp .key { font-size:.72rem; color:var(--muted); font-family:ui-monospace,Consolas,monospace; }
    .grp ul { margin:.5rem 0 0; padding-left:1.1rem; font-size:.8rem; color:var(--muted); }
    .btns { display:flex; gap:.3rem; flex-shrink:0; }
    .btns button { background:none; padding:.2rem .45rem; font-size:.78rem; }
    .edit { color:var(--navy); }
    .del { color:var(--fail); }
    #out { width:100%; min-height:200px; font-family:ui-monospace,Consolas,monospace; font-size:.72rem; }
    .hint { font-size:.75rem; color:var(--muted); margin:.25rem 0 0; }
    .ok { color:var(--pass); font-weight:600; }
    .bad { color:var(--fail); font-weight:600; }
    .stats { display:flex; gap:.75rem; flex-wrap:wrap; margin-bottom:1rem; }
    .stat { border:1px solid var(--line); border-radius:8px; padding:.6rem 1rem; text-align:center; }
    .stat b { display:block; font-size:1.2rem; color:var(--navy); }
    .stat span { font-size:.7rem; color:var(--muted); }
    .picked { background:var(--surface); border:1px solid var(--line); border-radius:6px; padding:.5rem .7rem; font-size:.85rem; margin-top:.5rem; }
    #jump { position:fixed; left:16px; bottom:16px; z-index:99; width:46px; height:46px; border-radius:50%; background:var(--navy); color:#fff; font-size:20px; padding:0; box-shadow:0 4px 12px rgba(0,0,0,.25); }
    @media (max-width:760px){ .books { grid-template-columns:1fr; } }
  </style>
</head>
<body>

<button type="button" id="jump" title="Back to top">&#8593;</button>

<div class="wrap">

  <h1>Book builder</h1>
  <p class="sub">Three books at a time. Pick the exam from the list so the group key is always correct.</p>

  <div class="stats">
    <div class="stat"><b id="stGroups">0</b><span>Groups</span></div>
    <div class="stat"><b id="stBooks">0</b><span>Books</span></div>
    <div class="stat"><b id="stCovered">0</b><span>Exams with books</span></div>
    <div class="stat"><b>{examList.length}</b><span>Exams total</span></div>
  </div>

  <h2>Step 1 — Load what you already have</h2>
  <label>
    <span style="display:flex;align-items:center;justify-content:space-between;">
      <span>Paste your current src/data/products.json</span>
      <button type="button" id="lockBtn" class="ghost" style="padding:.25rem .55rem;font-size:.72rem;">&#128274; Locked</button>
    </span>
    <textarea id="existing" placeholder="{ ... }" readonly style="background:#f8fafc;"></textarea>
  </label>
  <button class="ghost" id="loadBtn">Load existing books</button>
  <p class="hint" id="loadMsg"></p>

  <h2>Step 2 — Paste the JSON from your AI</h2>
  <div class="note">
    Ask any AI for the three books in this shape, then paste it here and click Fill.
    Do not let it choose the group key, you pick the exam in Step 3.
    <br /><code>{"{ \"books\": [ { \"title\": \"\", \"publisher\": \"\", \"badge\": \"\", \"note\": \"\", \"url\": \"\" } ] }"}</code>
  </div>
  <label><textarea id="pasteJson" placeholder='{ "books": [ ... ] }'></textarea></label>
  <button type="button" class="ghost" id="fetchBtn">Fill the three books below</button>
  <p class="hint" id="fetchMsg"></p>

  <h2>Step 3 — Which exam are these for?</h2>
  <fieldset>
    <legend>Group</legend>
    <label>
      <span>Search your exams by name, body or slug</span>
      <input id="examSearch" placeholder="Type RRB, SSC, UPSSSC..." autocomplete="off" />
    </label>
    <label style="display:flex;align-items:center;gap:.4rem;font-size:.8rem;margin-bottom:.5rem;">
      <input type="checkbox" id="hideDone" checked style="width:auto;" />
      <span style="margin:0;">Hide exams that already have books</span>
    </label>
    <select id="examPick" size="6" style="font-family:ui-monospace,Consolas,monospace;font-size:.8rem;"></select>
    <p class="hint">Or choose a general group that is not tied to one exam:</p>
    <div class="bar" style="margin-top:.4rem;">
      <button type="button" class="ghost gen" data-key="popular-pyq" data-label="Previous year question papers">popular-pyq</button>
      <button type="button" class="ghost gen" data-key="motivation" data-label="Worth reading alongside preparation">motivation</button>
      <button type="button" class="ghost gen" data-key="general-studies" data-label="General studies books">general-studies</button>
    </div>

    <div class="picked" id="pickedBox">Nothing selected yet.</div>

    <div class="bar" style="margin-top:.75rem;">
      <label style="flex:1;min-width:200px;margin:0;"><span>Group key</span><input id="g_key" placeholder="rrb-group-d" /></label>
      <label style="flex:2;min-width:220px;margin:0;"><span>Heading shown on the page</span><input id="g_label" placeholder="Books for RRB Group D" /></label>
    </div>
    <label style="margin-top:.65rem;"><span>Short line under the heading (optional)</span><input id="g_note" placeholder="Picked for Level 1 preparation." /></label>
    <p class="hint" id="keyMsg"></p>
  </fieldset>

  <h2>Step 4 — The three books</h2>
  <div class="books">
    <div class="bk"><h3>Book 1</h3>
      <label><span>Title</span><input id="b1_title" /></label>
      <label><span>Publisher</span><input id="b1_pub" placeholder="Arihant" /></label>
      <label><span>Badge</span>
        <select id="b1_badge">
          <option value="">No badge</option><option>PYQ</option><option>Practice Sets</option>
          <option>2026 Edition</option><option>Hindi &amp; English</option><option>Complete Guide</option>
        </select>
      </label>
      <label><span>Why this book</span><textarea id="b1_note" style="min-height:52px;"></textarea></label>
      <label><span>Affiliate link</span><input id="b1_url" placeholder="https://amzn.to/..." /></label>
      <label><span>Image path (optional)</span><input id="b1_img" placeholder="/products/x.jpg" /></label>
    </div>
    <div class="bk"><h3>Book 2</h3>
      <label><span>Title</span><input id="b2_title" /></label>
      <label><span>Publisher</span><input id="b2_pub" /></label>
      <label><span>Badge</span>
        <select id="b2_badge">
          <option value="">No badge</option><option>PYQ</option><option>Practice Sets</option>
          <option>2026 Edition</option><option>Hindi &amp; English</option><option>Complete Guide</option>
        </select>
      </label>
      <label><span>Why this book</span><textarea id="b2_note" style="min-height:52px;"></textarea></label>
      <label><span>Affiliate link</span><input id="b2_url" /></label>
      <label><span>Image path (optional)</span><input id="b2_img" /></label>
    </div>
    <div class="bk"><h3>Book 3</h3>
      <label><span>Title</span><input id="b3_title" /></label>
      <label><span>Publisher</span><input id="b3_pub" /></label>
      <label><span>Badge</span>
        <select id="b3_badge">
          <option value="">No badge</option><option>PYQ</option><option>Practice Sets</option>
          <option>2026 Edition</option><option>Hindi &amp; English</option><option>Complete Guide</option>
        </select>
      </label>
      <label><span>Why this book</span><textarea id="b3_note" style="min-height:52px;"></textarea></label>
      <label><span>Affiliate link</span><input id="b3_url" /></label>
      <label><span>Image path (optional)</span><input id="b3_img" /></label>
    </div>
  </div>

  <div class="bar">
    <button class="primary" id="saveBtn">Save this group</button>
    <button class="ghost" id="clearBtn">Clear the form</button>
  </div>
  <p class="hint" id="saveMsg"></p>

  <h2>Step 5 — Your groups</h2>
  <label><span>Filter</span><input id="grpFilter" placeholder="Type to filter groups" /></label>
  <div id="list"></div>

  <h2>Step 6 — Take the file</h2>
  <textarea id="out" readonly></textarea>
  <div class="bar">
    <button class="dark" id="copyBtn">Copy JSON</button>
    <button class="dark" id="dlBtn">Download products.json</button>
  </div>
  <p class="hint">Replace src/data/products.json with this, then commit and push.</p>

</div>

<script define:vars={{ examList }}>
  var data = {};
  var editKey = null;
  var g = function (id) { return document.getElementById(id); };
  var slugs = examList.map(function (e) { return e.slug; });

  function txt(id) { var v = g(id).value.trim(); return v === '' ? null : v; }

    function cleanUrl(u) {
    if (!u) return '';
    u = u.trim();
    var md = u.match(/^\[([^\]]+)\]\(([^)]+)\)$/);
    if (md) u = md[2];
    u = u.replace(/^[<\[("']+/, '').replace(/[>\])"']+$/, '').trim();
    return u;
  }

  function urlProblem(u) {
    if (!/^https?:\/\//i.test(u)) return 'must start with https://';
    if (/[\[\]()<>]/.test(u)) return 'still has brackets in it';
    if (/\s/.test(u)) return 'has a space in it';
    return null;
  }

  // ---- lock toggle ----
  var unlocked = false;
  g('lockBtn').addEventListener('click', function () {
    unlocked = !unlocked;
    g('existing').readOnly = !unlocked;
    g('existing').style.background = unlocked ? '#fff' : '#f8fafc';
    g('lockBtn').innerHTML = unlocked ? '&#128275; Unlocked' : '&#128274; Locked';
    if (unlocked) g('existing').focus();
  });

  // ---- exam picker ----
  function renderPicker() {
    var term = g('examSearch').value.trim().toLowerCase();
    var words = term.split(/\s+/).filter(Boolean);
    var sel = g('examPick');
    sel.innerHTML = '';
    examList
         .filter(function (e) {
        if (g('hideDone').checked && data[e.slug] && (data[e.slug].items || []).length) return false;
        if (!words.length) return true;
        var hay = (e.name + ' ' + e.full + ' ' + e.body + ' ' + e.slug + ' ' + e.cat).toLowerCase();
        return words.every(function (w) { return hay.indexOf(w) !== -1; });
      })
      .slice(0, 200)
      .forEach(function (e) {
        var o = document.createElement('option');
        o.value = e.slug;
        var has = data[e.slug] && data[e.slug].items ? ' (' + data[e.slug].items.length + ' books)' : '';
        o.textContent = e.name + '  —  ' + e.slug + has;
        sel.appendChild(o);
      });
  }
  g('examSearch').addEventListener('input', renderPicker);

    g('hideDone').addEventListener('change', renderPicker);

  g('examPick').addEventListener('change', function () {
    var slug = g('examPick').value;
    var e = examList.find(function (x) { return x.slug === slug; });
    if (!e) return;
    g('g_key').value = e.slug;
    g('g_label').value = 'Books for ' + e.name;
    if (data[e.slug]) loadGroup(e.slug);
    checkKey();
  });

  document.querySelectorAll('.gen').forEach(function (b) {
    b.addEventListener('click', function () {
      g('g_key').value = b.getAttribute('data-key');
      g('g_label').value = b.getAttribute('data-label');
      if (data[b.getAttribute('data-key')]) loadGroup(b.getAttribute('data-key'));
      checkKey();
    });
  });

  function checkKey() {
    var k = g('g_key').value.trim();
    var box = g('pickedBox');
    var msg = g('keyMsg');
    if (!k) { box.textContent = 'Nothing selected yet.'; msg.textContent = ''; return; }
    var e = examList.find(function (x) { return x.slug === k; });
    if (e) {
      box.innerHTML = '<strong>' + e.name + '</strong> — these books will show on /exams/' + k +
        '/ , on its notification and exam details posts, and on /books/';
      msg.innerHTML = '<span class="ok">Matches an exam in exams.json.</span>';
    } else if (['popular-pyq','motivation','general-studies'].indexOf(k) !== -1) {
      box.innerHTML = '<strong>General group</strong> — add <code>products: ["' + k + '"]</code> to any post to show these.';
      msg.innerHTML = '<span class="ok">General group, not tied to an exam.</span>';
    } else {
      box.innerHTML = '<strong>' + k + '</strong>';
      msg.innerHTML = '<span class="bad">This is not a slug in exams.json. These books will only appear where you list the key manually.</span>';
    }
  }
  g('g_key').addEventListener('input', checkKey);

  // ---- fill from AI json ----
  g('fetchBtn').addEventListener('click', function () {
    var raw = g('pasteJson').value.trim();
    if (!raw) { g('fetchMsg').textContent = 'Paste some JSON first.'; return; }
    try {
      var o = JSON.parse(raw);
      var books = Array.isArray(o) ? o : (o.books || o.items || []);
      if (!books.length) throw new Error('no books');
      books.slice(0, 3).forEach(function (b, i) {
        var n = i + 1;
        g('b' + n + '_title').value = b.title || '';
        g('b' + n + '_pub').value = b.publisher || '';
        g('b' + n + '_badge').value = b.badge || '';
        g('b' + n + '_note').value = b.note || '';
                g('b' + n + '_url').value = cleanUrl(b.url || '');
        g('b' + n + '_img').value = b.image || '';
      });
      g('fetchMsg').innerHTML = '<span class="ok">Filled ' + Math.min(books.length, 3) +
        ' books. Now pick the exam in Step 3, then check every link before saving.</span>';
    } catch (err) {
      g('fetchMsg').innerHTML = '<span class="bad">That is not valid JSON. Check for a missing comma or bracket.</span>';
    }
  });

  // ---- load / save groups ----
  function loadGroup(key) {
    var grp = data[key];
    if (!grp) return;
    editKey = key;
    g('g_key').value = key;
    g('g_label').value = grp.label || '';
    g('g_note').value = grp.note || '';
    [0,1,2].forEach(function (i) {
      var b = (grp.items || [])[i] || {};
      var n = i + 1;
      g('b' + n + '_title').value = b.title || '';
      g('b' + n + '_pub').value = b.publisher || '';
      g('b' + n + '_badge').value = b.badge || '';
      g('b' + n + '_note').value = b.note || '';
      g('b' + n + '_url').value = b.url || '';
      g('b' + n + '_img').value = b.image || '';
    });
    g('saveBtn').textContent = 'Save changes to ' + key;
    checkKey();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  g('saveBtn').addEventListener('click', function () {
    var key = (txt('g_key') || '').toLowerCase().replace(/\s+/g, '-');
    if (!key) { g('saveMsg').innerHTML = '<span class="bad">Pick an exam or type a group key first.</span>'; return; }

    var items = [];
    var missing = [];
    [1,2,3].forEach(function (n) {
          var t = txt('b' + n + '_title');
      var u = cleanUrl(g('b' + n + '_url').value);
      if (!t && !u) return;
      if (!t || !u) { missing.push('Book ' + n + ' needs both a title and a link'); return; }
      var prob = urlProblem(u);
      if (prob) { missing.push('Book ' + n + ' link ' + prob); return; }
      g('b' + n + '_url').value = u;
      items.push({
        title: t,
        publisher: txt('b' + n + '_pub') || '',
        badge: g('b' + n + '_badge').value || '',
        note: txt('b' + n + '_note') || '',
        image: txt('b' + n + '_img') || '',
        url: u
      });
    });

    if (missing.length) { g('saveMsg').innerHTML = '<span class="bad">' + missing.join('. ') + '.</span>'; return; }
    if (!items.length) { g('saveMsg').innerHTML = '<span class="bad">Add at least one book.</span>'; return; }

    data[key] = { label: txt('g_label') || key, note: txt('g_note') || '', items: items };

    var warn = items.length === 3 ? '' :
      ' Note: ' + items.length + ' books will leave a gap in the 3-across grid.';
    g('saveMsg').innerHTML = '<span class="ok">Saved ' + key + ' with ' + items.length + ' books.</span>' + warn;

    editKey = null;
    g('saveBtn').textContent = 'Save this group';
    render();
  });

  g('clearBtn').addEventListener('click', function () {
    ['g_key','g_label','g_note','pasteJson','examSearch'].forEach(function (id) { g(id).value = ''; });
    [1,2,3].forEach(function (n) {
      ['title','pub','note','url','img'].forEach(function (f) { g('b' + n + '_' + f).value = ''; });
      g('b' + n + '_badge').value = '';
    });
    editKey = null;
    g('saveBtn').textContent = 'Save this group';
    g('saveMsg').textContent = '';
    g('fetchMsg').textContent = '';
    checkKey();
    renderPicker();
  });

  // ---- list ----
  function render() {
    var keys = Object.keys(data);
    var totalBooks = keys.reduce(function (n, k) { return n + ((data[k].items || []).length); }, 0);
    var covered = keys.filter(function (k) { return slugs.indexOf(k) !== -1; }).length;

    g('stGroups').textContent = keys.length;
    g('stBooks').textContent = totalBooks;
    g('stCovered').textContent = covered;

    var term = g('grpFilter').value.trim().toLowerCase();
    var box = g('list');
    box.innerHTML = '';

    if (!keys.length) { box.innerHTML = '<p class="hint">No groups yet.</p>'; }

    keys.forEach(function (key) {
      var grp = data[key];
      var hay = (key + ' ' + (grp.label || '')).toLowerCase();
      if (term && hay.indexOf(term) === -1) return;

      var isExam = slugs.indexOf(key) !== -1;
      var wrap = document.createElement('div');
      wrap.className = 'grp';

      var top = document.createElement('div');
      top.className = 'top';

      var left = document.createElement('div');
      var h4 = document.createElement('h4');
      h4.textContent = grp.label || key;
      var k = document.createElement('span');
      k.className = 'key';
      k.textContent = key + ' · ' + (grp.items || []).length + ' books' + (isExam ? '' : ' · general');
      left.appendChild(h4); left.appendChild(k);

      var btns = document.createElement('div');
      btns.className = 'btns';
      var ed = document.createElement('button');
      ed.className = 'edit'; ed.textContent = 'Edit';
      ed.addEventListener('click', function () { loadGroup(key); });
      var del = document.createElement('button');
      del.className = 'del'; del.textContent = 'Remove';
      del.addEventListener('click', function () { delete data[key]; render(); renderPicker(); });
      btns.appendChild(ed); btns.appendChild(del);

      top.appendChild(left); top.appendChild(btns);
      wrap.appendChild(top);

      var ul = document.createElement('ul');
      (grp.items || []).forEach(function (b) {
        var li = document.createElement('li');
        li.textContent = b.title + (b.publisher ? ' · ' + b.publisher : '') + (b.badge ? ' · ' + b.badge : '');
        ul.appendChild(li);
      });
      wrap.appendChild(ul);
      box.appendChild(wrap);
    });

    g('out').value = JSON.stringify(data, null, 2);
  }
  g('grpFilter').addEventListener('input', render);

  g('loadBtn').addEventListener('click', function () {
    var raw = g('existing').value.trim();
    if (!raw) { g('loadMsg').textContent = 'Nothing pasted, starting fresh.'; return; }
    try {
      var parsed = JSON.parse(raw);
      if (typeof parsed !== 'object' || Array.isArray(parsed)) throw new Error('bad');
      data = parsed;
      Object.keys(data).forEach(function (k) {
        if (!data[k].items) data[k].items = [];
        if (!data[k].label) data[k].label = k;
      });
      g('loadMsg').innerHTML = '<span class="ok">Loaded ' + Object.keys(data).length + ' groups.</span>';
      render(); renderPicker();
    } catch (err) {
      g('loadMsg').innerHTML = '<span class="bad">That is not valid JSON.</span>';
    }
  });

  g('copyBtn').addEventListener('click', async function () {
    await navigator.clipboard.writeText(g('out').value);
    g('copyBtn').textContent = 'Copied';
    setTimeout(function () { g('copyBtn').textContent = 'Copy JSON'; }, 1500);
  });

  g('dlBtn').addEventListener('click', function () {
    var blob = new Blob([g('out').value], { type: 'application/json' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'products.json';
    a.click();
    URL.revokeObjectURL(a.href);
  });

  g('jump').addEventListener('click', function () {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  ['existing', 'pasteJson', 'out'].forEach(function (id) {
    var ta = g(id);
    if (!ta) return;
    var bar = document.createElement('div');
    bar.style.cssText = 'display:flex;gap:.35rem;margin:.3rem 0 .6rem;';
    function mk(text, fn) {
      var b = document.createElement('button');
      b.type = 'button';
      b.textContent = text;
      b.style.cssText = 'background:#fff;border:1px solid #e5e7eb;border-radius:5px;padding:.25rem .6rem;font-size:.72rem;font-weight:600;color:#0b1f35;';
      b.addEventListener('click', function () { fn(b); });
      bar.appendChild(b);
    }
    function flash(b, m) { var o = b.textContent; b.textContent = m; setTimeout(function () { b.textContent = o; }, 1200); }
    mk('Select all', function (b) { ta.focus(); ta.select(); flash(b, 'Selected'); });
    mk('Copy', async function (b) {
      try { await navigator.clipboard.writeText(ta.value); flash(b, 'Copied'); }
      catch (e) { ta.select(); flash(b, 'Ctrl+C'); }
    });
    mk('Paste', async function (b) {
      if (ta.readOnly) { flash(b, 'Unlock first'); return; }
      try {
        ta.value = await navigator.clipboard.readText();
        ta.dispatchEvent(new Event('input', { bubbles: true }));
        flash(b, 'Pasted');
      } catch (e) { ta.focus(); flash(b, 'Ctrl+V'); }
    });
    ta.parentNode.insertBefore(bar, ta.nextSibling);
  });



  renderPicker();
  render();
  checkKey();
</script>
</body>
</html>