---
import '../styles/global.css';
import exams from '../data/exams.json';

const { title, description = "Exact photo, signature and document requirements for Indian government exam forms." } = Astro.props;

const WHATSAPP_URL = "https://chat.whatsapp.com/REPLACE_ME";

const categories = [
  { key: 'central', label: 'SSC & Central' },
  { key: 'railway', label: 'Railway' },
  { key: 'banking', label: 'Banking' },
  { key: 'state', label: 'State PSC' },
  { key: 'police', label: 'Police & Defence' }
];

const byCategory = categories.map((c) => ({
  key: c.key,
  label: c.label,
  items: exams.filter((e) => e.category === c.key)
}));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0b1f35" />
</head>
<body class="bg-white text-ink">

  <header class="bg-navy-900 text-white">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
      <a href="/" class="text-lg font-bold text-white">FormSetu</a>
      <nav class="flex gap-4 text-sm">
        <a href="/exams/" class="text-white">Exams</a>
        <a href="/blog/" class="text-white">Notifications</a>
        <a href="/tools/" class="text-white">Tools</a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-3xl px-4 pt-6 pb-16">
    <slot />
  </main>

  <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="fixed bottom-5 right-5 z-50 rounded-full bg-green-500 px-5 py-3 text-sm font-semibold text-white shadow-lg">Join community</a>

  <footer class="border-t border-line bg-surface">
    <div class="mx-auto max-w-5xl px-4 py-10">
      <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">
        {byCategory.map((c) => (
          <div>
            <h3 class="mb-2 text-xs font-bold uppercase text-navy-700">{c.label}</h3>
            <ul class="space-y-1 text-sm">
              {c.items.map((e) => (
                <li><a href={"/exams/" + e.slug + "/"} class="text-muted">{e.name}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-8 border-t border-line pt-6 text-sm text-muted">
        <p class="mb-3">FormSetu is an independent website. We are not affiliated with any government body or examination authority. Always verify requirements against the official notification before applying.</p>
        <p class="flex flex-wrap gap-4">
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          <a href="/disclaimer/">Disclaimer</a>
        </p>
        <p class="mt-4 text-xs">© 2026 FormSetu</p>
      </div>
    </div>
  </footer>

</body>
</html>