---
import '../styles/global.css';
import exams from '../data/exams.json';

const { title, description = "Exact photo, signature and document requirements for Indian government exam forms." } = Astro.props;

const WHATSAPP_URL = "https://chat.whatsapp.com/REPLACE_ME";

const categories = [
  { key: 'central', label: 'SSC & Central' },
  { key: 'railway', label: 'Railway' },
  { key: 'banking', label: 'Banking' },
  { key: 'state', label: 'State PSC' },
  { key: 'police', label: 'Police & Defence' }
];

const byCategory = categories.map((c) => ({
  key: c.key,
  label: c.label,
  items: exams.filter((e) => e.category === c.key).slice(0, 6)
}));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0b1f35" />
</head>
<body class="bg-white text-ink">

  <header class="bg-navy-900 text-white">
    <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
      <a href="/" class="text-lg font-bold text-white">Form <span class="text-amber-500">Setu</span></a>
      <nav class="flex gap-4 text-sm">
        <a href="/exams/" class="text-white hover:text-amber-500">Exams</a>
        <a href="/blog/" class="text-white hover:text-amber-500">Notifications</a>
        <a href="/tools/" class="text-white hover:text-amber-500">Tools</a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-3xl px-4 pt-6 pb-16">
    <slot />
  </main>

  <a href={WHATSAPP_URL} target="_blank" rel="noopener"
     class="wa-float fixed bottom-5 right-5 z-50 flex items-center gap-2 rounded-full bg-[#25D366] px-5 py-3 text-sm font-bold text-white shadow-lg transition hover:scale-105 hover:brightness-95">
    <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
      <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4-.1-.5-.1-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.4 2.5 1 3 .8 3.6.8.5 0 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3z"/>
      <path d="M12 2a10 10 0 00-8.5 15.3L2 22l4.8-1.5A10 10 0 1012 2zm0 18.2c-1.6 0-3.2-.4-4.6-1.3l-.3-.2-3 .9.9-2.9-.2-.3A8.2 8.2 0 1112 20.2z"/>
    </svg>
    <span>Join community</span>
  </a>

  <footer class="border-t border-line bg-surface">
    <div class="mx-auto max-w-5xl px-4 py-10">
      <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">
        {byCategory.map((c) => (
          <div>
            <h3 class="mb-2 text-xs font-bold uppercase text-navy-700">{c.label}</h3>
            <ul class="space-y-1 text-sm">
              {c.items.map((e) => (
                <li><a href={"/exams/" + e.slug + "/"} class="text-muted hover:text-navy-700">{e.name}</a></li>
              ))}
              {c.items.length > 0 && (
                <li><a href={"/exams/category/" + c.key + "/"} class="font-semibold text-amber-600 hover:text-amber-500">View all →</a></li>
              )}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-8 border-t border-line pt-6">
        <h3 class="mb-2 text-xs font-bold uppercase text-navy-700">Site information</h3>
        <p class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-bold text-navy-800">
          <a href="/about/" class="hover:text-amber-600">About</a>
          <a href="/contact/" class="hover:text-amber-600">Contact</a>
          <a href="/privacy/" class="hover:text-amber-600">Privacy</a>
          <a href="/terms/" class="hover:text-amber-600">Terms</a>
          <a href="/disclaimer/" class="hover:text-amber-600">Disclaimer</a>
        </p>

        <p class="mt-6 text-sm text-muted">
          <strong class="text-ink">FormSetu is an independent website.</strong>
          We are not affiliated with, endorsed by, or connected to any government
          body or examination authority. Always verify requirements against the
          official notification before applying.
        </p>
        <p class="mt-4 text-xs text-muted">© 2026 FormSetu</p>
      </div>
    </div>
  </footer>

  <style>
    @keyframes waPulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5); }
      50% { box-shadow: 0 0 0 10px rgba(37, 211, 102, 0); }
    }
    .wa-float { animation: waPulse 2.5s infinite; }
    .wa-float:hover { animation: none; }
  </style>

</body>
</html>