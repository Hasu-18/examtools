---
import '../styles/global.css';
import exams from '../data/exams.json';

const {
  title,
  description = "Exact photo and signature size for Indian government exam forms, checked against the official notification. Free resizer that hits both the pixel and KB limits, working entirely in your browser with no upload."
} = Astro.props;

const WHATSAPP_URL = "https://chat.whatsapp.com/J8KB4stpDCTFxAyCL7SNuy";
const GTM_ID = "GTM-PH2KD9K8";

const categories = [
  { key: 'central', label: 'SSC & Central' },
  { key: 'entrance', label: 'NTA & Entrance' },
  { key: 'railway', label: 'Railway' },
  { key: 'banking', label: 'Banking' },
  { key: 'state', label: 'State' },
  { key: 'judiciary', label: 'Court & Judiciary' },
  { key: 'police', label: 'Police & Defence' }
];

const byCategory = categories.map((c) => ({
  key: c.key,
  label: c.label,
  total: exams.filter((e) => e.category === c.key).length,
  items: exams.filter((e) => e.category === c.key).slice(0, 10)
}));

const canonical = Astro.url.href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0b1f35" />
  <link rel="canonical" href={canonical} />

  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Form Setu" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://formsetu.com/og.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Form Setu, exact photo and signature size for every Indian government exam" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://formsetu.com/og.png" />

  <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${GTM_ID}');`} />
</head>
<body class="bg-white text-ink">

  <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${GTM_ID}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />

  <header class="bg-navy-900 text-white">
    <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
      <a href="/" class="flex items-center gap-2" aria-label="Form Setu home">
        <svg viewBox="0 0 64 64" class="h-8 w-8 shrink-0" aria-hidden="true">
          <path d="M12 42c0-11 9-20 20-20s20 9 20 20" fill="none" stroke="#f59e0b" stroke-width="5" stroke-linecap="round"/>
          <path d="M8 42h48" stroke="#ffffff" stroke-width="5" stroke-linecap="round"/>
          <path d="M22 42V33M32 42V29M42 42V33" stroke="#ffffff" stroke-width="3" stroke-linecap="round" opacity=".7"/>
        </svg>
        <span class="text-lg font-bold tracking-tight text-white">Form <span class="text-amber-500">Setu</span></span>
      </a>
      <nav class="flex gap-4 text-sm">
        <a href="/exams/" class="text-white hover:text-amber-500">Exams</a>
        <a href="/blog/" class="text-white hover:text-amber-500">Notifications</a>
        <a href="/tools/" class="text-white hover:text-amber-500">Tools</a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-3xl px-4 pt-6 pb-16">
    <slot />
  </main>

  <a href={WHATSAPP_URL} target="_blank" rel="noopener"
     class="wa-float fixed bottom-5 right-5 z-50 flex items-center gap-2.5 rounded-2xl bg-[#25D366] px-4 py-2.5 text-white shadow-lg transition hover:scale-105 hover:brightness-95">
    <svg viewBox="0 0 24 24" class="h-6 w-6 shrink-0 fill-current" aria-hidden="true">
      <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4-.1-.5-.1-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.4 2.5 1 3 .8 3.6.8.5 0 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3z"/>
      <path d="M12 2a10 10 0 00-8.5 15.3L2 22l4.8-1.5A10 10 0 1012 2zm0 18.2c-1.6 0-3.2-.4-4.6-1.3l-.3-.2-3 .9.9-2.9-.2-.3A8.2 8.2 0 1112 20.2z"/>
    </svg>
    <span class="leading-tight">
      <span class="block text-sm font-bold">Join Private Community</span>
      <span class="block text-[10px] opacity-90">Free notes &amp; exam guidance</span>
    </span>
  </a>

  <footer class="border-t border-line bg-surface">
    <div class="mx-auto max-w-5xl px-4 py-10">

      <div class="grid grid-cols-2 gap-x-5 gap-y-6 sm:grid-cols-3 lg:grid-cols-4">
        {byCategory.map((c) => c.items.length > 0 && (
          <div class="min-w-0">
            <h3 class="mb-2 text-xs font-bold uppercase text-navy-700">{c.label}</h3>
            <ul class="space-y-1 text-sm">
              {c.items.map((e) => (
                <li class="min-w-0">
                  <a href={"/exams/" + e.slug + "/"} title={e.name}
                     class="block truncate text-muted hover:text-navy-700">{e.name}</a>
                </li>
              ))}
              <li>
                <a href={"/exams/category/" + c.key + "/"}
                   class="block font-semibold text-amber-600 hover:text-amber-500">
                  View all {c.total} →
                </a>
              </li>
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-8 border-t border-line pt-6">
        <p class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-bold text-navy-800">
          <a href="/about/" class="hover:text-amber-600">About</a>
          <a href="/contact/" class="hover:text-amber-600">Contact</a>
          <a href="/privacy/" class="hover:text-amber-600">Privacy</a>
          <a href="/terms/" class="hover:text-amber-600">Terms</a>
          <a href="/disclaimer/" class="hover:text-amber-600">Disclaimer</a>
        </p>

        <p class="mt-8 text-sm leading-relaxed text-muted">
          <strong class="text-ink">Form Setu is an independent website.</strong>
          We are not affiliated with, endorsed by, or connected to any government
          body or examination authority. Always verify requirements against the
          official notification before applying.
        </p>
        <p class="mt-4 text-xs text-muted">© 2026 Form Setu</p>
      </div>

    </div>
  </footer>

  <style>
    @keyframes waPulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5); }
      50% { box-shadow: 0 0 0 10px rgba(37, 211, 102, 0); }
    }
    .wa-float { animation: waPulse 2.5s infinite; }
    .wa-float:hover { animation: none; }
    @media (prefers-reduced-motion: reduce) { .wa-float { animation: none; } }
  </style>

<div id="joinPop" class="join-pop" hidden>
    <button type="button" id="joinClose" class="join-close" aria-label="Close">&times;</button>
    <div class="join-row">
      <svg viewBox="0 0 24 24" class="join-wa" aria-hidden="true">
        <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4-.1-.5-.1-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.4 2.5 1 3 .8 3.6.8.5 0 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3z"/>
        <path d="M12 2a10 10 0 00-8.5 15.3L2 22l4.8-1.5A10 10 0 1012 2zm0 18.2c-1.6 0-3.2-.4-4.6-1.3l-.3-.2-3 .9.9-2.9-.2-.3A8.2 8.2 0 1112 20.2z"/>
      </svg>
      <div class="join-text">
        <p class="join-title">Get notification alerts first</p>
        <p class="join-sub">Free notes, form filling help and new notification updates, straight to WhatsApp.</p>
      </div>
    </div>
    <a href={WHATSAPP_URL} target="_blank" rel="noopener" id="joinGo" class="join-btn">
      Join the private community
    </a>
    <button type="button" id="joinLater" class="join-later">Maybe later</button>
  </div>

  <style>
    .join-pop {
      position: fixed;
      left: 12px; right: 12px; bottom: 12px;
      z-index: 60;
      max-width: 380px;
      margin: 0 auto;
      border-radius: 14px;
      border: 1px solid #e5e7eb;
      background: #fff;
      padding: 16px 16px 14px;
      box-shadow: 0 12px 40px rgba(11, 31, 53, .22);
      animation: joinUp .4s cubic-bezier(.2,.8,.3,1);
    }
    @keyframes joinUp {
      from { transform: translateY(24px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .join-pop.closing { animation: joinDown .28s ease forwards; }
    @keyframes joinDown {
      to { transform: translateY(24px); opacity: 0; }
    }

    .join-close {
      position: absolute; top: 8px; right: 10px;
      background: none; border: 0; padding: 2px 6px;
      font-size: 22px; line-height: 1; color: #9ca3af; cursor: pointer;
    }
    .join-close:hover { color: #4b5563; }

    .join-row { display: flex; gap: 12px; align-items: flex-start; }
    .join-wa { width: 34px; height: 34px; flex-shrink: 0; fill: #25D366; }
    .join-title { font-size: 15px; font-weight: 700; color: #0b1f35; margin: 0; padding-right: 18px; }
    .join-sub { font-size: 12.5px; line-height: 1.45; color: #4b5563; margin: 4px 0 0; }

    .join-btn {
      display: block; margin-top: 14px;
      border-radius: 9px; background: #25D366;
      padding: 11px 14px;
      text-align: center; text-decoration: none;
      font-size: 14px; font-weight: 700; color: #fff;
    }
    .join-btn:hover { filter: brightness(.95); }

    .join-later {
      display: block; width: 100%; margin-top: 8px;
      background: none; border: 0; padding: 4px;
      font-size: 12px; font-weight: 600; color: #6b7280; cursor: pointer;
    }
    .join-later:hover { color: #0b1f35; }

    @media (min-width: 640px) {
      .join-pop { left: 20px; right: auto; bottom: 20px; margin: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      .join-pop, .join-pop.closing { animation: none; }
    }
  </style>

  <script is:inline>
    (function () {
      var KEY = 'fs_join_pop';
      var DELAY_SECONDS = 120;
      var SNOOZE_DAYS = 7;

      var pop = document.getElementById('joinPop');
      if (!pop) return;

      var saved = {};
      try { saved = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) {}

      if (saved.joined) return;
      if (saved.dismissedAt && Date.now() - saved.dismissedAt < SNOOZE_DAYS * 86400000) return;

      function save(obj) {
        try { localStorage.setItem(KEY, JSON.stringify(obj)); } catch (e) {}
      }

      function read() {
        try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) { return {}; }
      }

      var shown = false;

      var timer = setInterval(function () {
        if (document.visibilityState !== 'visible') return;

        var s = read();
        s.seconds = (s.seconds || 0) + 1;
        save(s);

        if (!shown && s.seconds >= DELAY_SECONDS) {
          clearInterval(timer);
          show();
        }
      }, 1000);

      function push(event) {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: event });
      }

      function show() {
        shown = true;
        pop.hidden = false;
        var float = document.querySelector('.wa-float');
        if (float) float.style.display = 'none';
        push('join_popup_shown');
      }

      function hide(reason) {
        pop.classList.add('closing');
        setTimeout(function () {
          pop.hidden = true;
          var float = document.querySelector('.wa-float');
          if (float) float.style.display = '';
        }, 280);
        save({ dismissedAt: Date.now() });
        push('join_popup_' + reason);
      }

      document.getElementById('joinClose').addEventListener('click', function () { hide('closed'); });
      document.getElementById('joinLater').addEventListener('click', function () { hide('later'); });
      document.getElementById('joinGo').addEventListener('click', function () {
        save({ joined: true });
        push('join_popup_joined');
      });
    })();
  </script>

</body>
</html>