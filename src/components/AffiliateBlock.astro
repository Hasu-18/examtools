---
import products from '../data/products.json';

const { groups = [] } = Astro.props;

const shown = groups
  .map((key) => products[key])
  .filter((g) => g && g.items && g.items.length > 0);

const shades = [
  'from-navy-900 to-navy-700',
  'from-amber-600 to-amber-500',
  'from-navy-800 to-navy-600',
  'from-[#7c2d12] to-[#c2410c]'
];
---
{shown.length > 0 && (
  <section class="mt-10">
    <p class="mb-4 rounded-md bg-surface px-3 py-2 text-xs text-muted">
      As an Amazon Associate, FormSetu earns from qualifying purchases.
      This costs you nothing extra and does not change what we recommend.
    </p>

    {shown.map((g) => (
      <div class="mb-6">
        <h2 class="text-lg font-bold text-navy-900">{g.label}</h2>
        {g.note && <p class="mt-1 text-sm text-muted">{g.note}</p>}

        <div class={g.items.length === 1 ? 'mt-3' : 'mt-3 grid grid-cols-2 gap-3'}>
          {g.items.map((p, i) => (
            <a href={p.url} target="_blank" rel="nofollow noopener sponsored"
               class="group flex h-full flex-col overflow-hidden rounded-lg border-2 border-line bg-white shadow-sm transition hover:border-amber-500 hover:shadow-lg">

              {p.image ? (
                <div class="flex h-40 items-center justify-center bg-surface p-3">
                  <img src={p.image} alt={p.title} loading="lazy"
                       class="max-h-full w-auto object-contain transition group-hover:scale-105" />
                </div>
              ) : (
                <div class={`relative flex h-40 items-center bg-gradient-to-br ${shades[i % shades.length]} p-4`}>
                  <span class="absolute left-0 top-0 h-full w-2 bg-black/25"></span>
                  <span class="absolute left-3.5 top-0 h-full w-px bg-white/25"></span>
                  <span class="pl-4">
                    {p.publisher && (
                      <span class="mb-1.5 block text-[10px] font-bold uppercase tracking-widest text-white/70">
                        {p.publisher}
                      </span>
                    )}
                    <span class="block text-sm font-bold leading-snug text-white line-clamp-4">
                      {p.title}
                    </span>
                  </span>
                </div>
              )}

              <div class="flex flex-1 flex-col p-3">
                <h3 class="text-sm font-bold leading-snug text-navy-900">{p.title}</h3>
                <p class="mt-1 flex-1 text-xs leading-snug text-muted">{p.note}</p>
                <span class="mt-3 block rounded-md bg-amber-600 px-3 py-2.5 text-center text-xs font-bold text-white transition group-hover:bg-amber-500">
                  Check price on Amazon →
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
)}