---
import products from '../data/products.json';

const { groups = [] } = Astro.props;

const shown = groups
  .map((key) => products[key])
  .filter((g) => g && g.items && g.items.length > 0);

const shades = [
  'linear-gradient(135deg, #0b1f35 0%, #1e4d80 100%)',
  'linear-gradient(135deg, #b45309 0%, #f59e0b 100%)',
  'linear-gradient(135deg, #14532d 0%, #16a34a 100%)',
  'linear-gradient(135deg, #7c2d12 0%, #ea580c 100%)',
  'linear-gradient(135deg, #4c1d95 0%, #7c3aed 100%)',
  'linear-gradient(135deg, #831843 0%, #db2777 100%)'
];
---
{shown.length > 0 && (
  <section class="mt-10">
    <p class="mb-4 rounded-md bg-surface px-3 py-2 text-xs text-muted">
      As an Amazon Associate, Form Setu earns from qualifying purchases.
      This costs you nothing extra and does not change what we recommend.
    </p>

    {shown.map((g) => (
      <div class="mb-8">
        <h2 class="text-lg font-bold text-navy-900">{g.label}</h2>
        {g.note && <p class="mt-1 text-sm text-muted">{g.note}</p>}

        <div class="mt-4 grid grid-cols-3 gap-2 sm:gap-4">
          {g.items.map((p, i) => (
            <a href={p.url} target="_blank" rel="nofollow noopener sponsored" class="bk">

              <div class="bk-cover" style={`background:${shades[i % shades.length]}`}>
                <span class="bk-spine"></span>
                <span class="bk-crease"></span>
                <span class="bk-shine"></span>

                {p.badge && <span class="bk-badge">{p.badge}</span>}

                {p.image ? (
                  <img src={p.image} alt={p.title} loading="lazy" class="bk-img" />
                ) : (
                  <span class="bk-text">
                    {p.publisher && <span class="bk-pub">{p.publisher}</span>}
                    <span class="bk-title">{p.title}</span>
                  </span>
                )}
              </div>

              <div class="bk-body">
                <h3 class="bk-name">{p.title}</h3>
                {p.note && <p class="bk-note">{p.note}</p>}
                <span class="bk-btn">
                  <svg viewBox="0 0 24 24" class="bk-icon" aria-hidden="true">
                    <path d="M3 4h2l2.4 11.2a2 2 0 002 1.6h7.5a2 2 0 002-1.6L21 8H6"
                          fill="none" stroke="currentColor" stroke-width="2"
                          stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="10" cy="20" r="1.4" fill="currentColor"/>
                    <circle cx="17" cy="20" r="1.4" fill="currentColor"/>
                  </svg>
                  <span class="bk-btn-text">Buy from Amazon</span>
                </span>
              </div>

            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
)}

<style>
  .bk {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 10px;
    border: 2px solid #e5e7eb;
    background: #fff;
    text-decoration: none;
    box-shadow: 0 1px 3px rgba(11, 31, 53, 0.08);
    transition: transform .35s cubic-bezier(.2,.8,.3,1), box-shadow .35s, border-color .35s;
  }
  .bk:hover {
    transform: translateY(-6px);
    border-color: #f59e0b;
    box-shadow: 0 14px 28px rgba(11, 31, 53, 0.18);
  }

  .bk-cover {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    display: flex;
    align-items: center;
    padding: 10px 8px 10px 16px;
  }
  .bk-spine {
    position: absolute; left: 0; top: 0;
    width: 7px; height: 100%;
    background: rgba(0,0,0,.3);
  }
  .bk-crease {
    position: absolute; left: 11px; top: 0;
    width: 1px; height: 100%;
    background: rgba(255,255,255,.28);
  }

  .bk-shine {
    position: absolute; top: -60%; left: -70%;
    width: 45%; height: 220%;
    background: linear-gradient(100deg, transparent, rgba(255,255,255,.45), transparent);
    transform: rotate(18deg);
    animation: bkDrift 5.5s ease-in-out infinite;
  }
  .bk:hover .bk-shine { animation: bkSweep .85s ease-out; }

  @keyframes bkDrift {
    0%, 70%, 100% { left: -70%; opacity: .5; }
    35% { left: 130%; opacity: .9; }
  }
  @keyframes bkSweep {
    from { left: -70%; opacity: 1; }
    to { left: 130%; opacity: 1; }
  }

  .bk-badge {
    position: absolute; top: 6px; right: 6px; z-index: 2;
    border-radius: 999px;
    background: #fff;
    color: #0b1f35;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
    padding: 3px 7px;
    box-shadow: 0 2px 6px rgba(0,0,0,.25);
  }

  .bk-img {
    position: relative; z-index: 1;
    max-height: 100%; width: auto; margin: 0 auto;
    object-fit: contain;
    transition: transform .35s;
  }
  .bk:hover .bk-img { transform: scale(1.06); }

  .bk-text { position: relative; z-index: 1; display: block; }
  .bk-pub {
    display: block;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgba(255,255,255,.72);
    margin-bottom: 5px;
  }
  .bk-title {
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 11px;
    font-weight: 800;
    line-height: 1.3;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0,0,0,.35);
  }

  .bk-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 8px;
  }
  .bk-name {
    font-size: 11px;
    font-weight: 700;
    line-height: 1.3;
    color: #0b1f35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }
  .bk-note {
    flex: 1;
    margin: 4px 0 0;
    font-size: 10px;
    line-height: 1.35;
    color: #4b5563;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bk-btn {
    margin-top: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    border-radius: 6px;
    background: linear-gradient(135deg, #d97706, #f59e0b);
    background-size: 180% 180%;
    padding: 7px 4px;
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
    transition: background-position .4s, box-shadow .3s;
  }
  .bk:hover .bk-btn {
    background-position: 100% 0;
    box-shadow: 0 4px 12px rgba(217, 119, 6, .45);
  }
  .bk-icon { width: 12px; height: 12px; flex-shrink: 0; }

  @media (min-width: 640px) {
    .bk-cover { padding: 14px 12px 14px 22px; }
    .bk-spine { width: 10px; }
    .bk-crease { left: 15px; }
    .bk-pub { font-size: 9px; }
    .bk-title { font-size: 14px; -webkit-line-clamp: 6; }
    .bk-body { padding: 12px; }
    .bk-name { font-size: 14px; }
    .bk-note { font-size: 12px; }
    .bk-btn { font-size: 12px; padding: 9px 8px; gap: 6px; }
    .bk-icon { width: 15px; height: 15px; }
    .bk-badge { font-size: 10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bk, .bk-img, .bk-btn { transition: none; }
    .bk-shine { animation: none; opacity: 0; }
    .bk:hover { transform: none; }
  }
</style>