---
const { widthPx, heightPx, minKB, maxKB, photoRatio = 0.72, fileName = "photo-signature" } = Astro.props;
---
<div class="cb rounded-lg border border-line bg-white"
     data-w={widthPx} data-h={heightPx} data-min={minKB} data-max={maxKB}
     data-ratio={photoRatio} data-name={fileName}>

  <div class="border-b border-line bg-navy-100 px-4 py-3">
    <h3 class="text-base font-bold text-navy-900">Combined photo + signature</h3>
    <p class="mt-0.5 text-sm text-muted">{widthPx} × {heightPx} px · {minKB}–{maxKB} KB · JPG</p>
  </div>

  <div class="p-4">
    <div class="grid grid-cols-2 gap-3">
      <label class="block cursor-pointer rounded-lg border-2 border-dashed border-amber-500 bg-amber-100 px-3 py-6 text-center">
        <span class="block text-sm font-bold text-navy-900">1. Photo</span>
        <span class="cb-photo-name mt-1 block text-xs text-navy-700">Tap to choose</span>
        <input type="file" accept="image/*" class="cb-photo sr-only" />
      </label>
      <label class="block cursor-pointer rounded-lg border-2 border-dashed border-amber-500 bg-amber-100 px-3 py-6 text-center">
        <span class="block text-sm font-bold text-navy-900">2. Signature</span>
        <span class="cb-sign-name mt-1 block text-xs text-navy-700">Tap to choose</span>
        <input type="file" accept="image/*" class="cb-sign sr-only" />
      </label>
    </div>

    <p class="mt-3 text-center text-xs text-muted">Processed on your device — nothing is uploaded</p>

    <div class="cb-edit mt-5" hidden>
      <div class="flex justify-center rounded bg-surface p-3">
        <canvas class="cb-stage rounded border border-line" style="max-width:100%;height:auto;"></canvas>
      </div>
      <label class="mt-4 block text-sm">
        <span class="text-muted">Photo zoom</span>
        <input type="range" class="cb-zoom mt-1 w-full" min="100" max="250" value="100" />
      </label>
      <button type="button" class="cb-apply mt-4 w-full rounded-md bg-amber-600 px-5 py-3 text-sm font-semibold text-white">
        Create combined image
      </button>
    </div>

    <div class="cb-done mt-5" hidden>
      <div class="rounded border-2 border-pass p-3 text-center">
        <img class="cb-out mx-auto max-h-64 w-auto rounded" alt="" />
        <p class="cb-meta mt-2 text-xs font-semibold text-pass"></p>
      </div>
      <div class="cb-verdict mt-3 rounded px-3 py-3 text-sm"></div>
      <a class="cb-dl mt-3 block rounded-md bg-amber-600 px-5 py-3 text-center text-sm font-semibold text-white" download>Download</a>
      <button type="button" class="cb-again mt-2 w-full rounded-md border border-line px-4 py-2.5 text-sm font-semibold text-navy-700">Start over</button>
    </div>

    <p class="cb-err mt-3 rounded bg-fail-bg px-3 py-2 text-sm text-fail" hidden></p>
  </div>
</div>

<script>
  function initCb(root) {
    const W = +root.dataset.w;
    const H = +root.dataset.h;
    const MIN = +root.dataset.min;
    const MAX = +root.dataset.max;
    const RATIO = +root.dataset.ratio;
    const NAME = root.dataset.name || 'photo-signature';

    const q = (s) => root.querySelector(s);
    const photoIn = q('.cb-photo'), signIn = q('.cb-sign');
    const photoName = q('.cb-photo-name'), signName = q('.cb-sign-name');
    const edit = q('.cb-edit'), done = q('.cb-done'), err = q('.cb-err');
    const stage = q('.cb-stage'), zoomIn = q('.cb-zoom');
    const applyBtn = q('.cb-apply'), againBtn = q('.cb-again');
    const outImg = q('.cb-out'), meta = q('.cb-meta'), verdict = q('.cb-verdict'), dl = q('.cb-dl');

    const photoH = Math.round(H * RATIO);
    const signH = H - photoH;

    stage.width = W;
    stage.height = H;

    let photoBmp = null, signBmp = null, zoom = 1, outURL = null;

    function paint(canvas) {
      const c = canvas.getContext('2d');
      c.fillStyle = '#ffffff';
      c.fillRect(0, 0, W, H);
      if (photoBmp) {
        const s = Math.max(W / photoBmp.width, photoH / photoBmp.height) * zoom;
        const dw = photoBmp.width * s, dh = photoBmp.height * s;
        c.save();
        c.beginPath();
        c.rect(0, 0, W, photoH);
        c.clip();
        c.drawImage(photoBmp, (W - dw) / 2, (photoH - dh) / 2, dw, dh);
        c.restore();
      }
      if (signBmp) {
        const s = Math.min(W / signBmp.width, signH / signBmp.height) * 0.92;
        const dw = signBmp.width * s, dh = signBmp.height * s;
        c.drawImage(signBmp, (W - dw) / 2, photoH + (signH - dh) / 2, dw, dh);
      }
      c.strokeStyle = '#e5e7eb';
      c.beginPath();
      c.moveTo(0, photoH);
      c.lineTo(W, photoH);
      c.stroke();
    }

    function maybeShow() {
      if (photoBmp && signBmp) {
        edit.hidden = false;
        done.hidden = true;
        paint(stage);
      }
    }

    async function load(input, which, label) {
      const file = input.files && input.files[0];
      if (!file) return;
      err.hidden = true;
      try {
        const bmp = await createImageBitmap(file);
        if (which === 'photo') { photoBmp = bmp; photoName.textContent = 'Photo ready ✓'; }
        else { signBmp = bmp; signName.textContent = 'Signature ready ✓'; }
        maybeShow();
      } catch (ex) {
        err.textContent = 'Could not read that ' + label + '. Try a JPG or PNG file.';
        err.hidden = false;
      }
    }

    photoIn.addEventListener('change', () => load(photoIn, 'photo', 'photo'));
    signIn.addEventListener('change', () => load(signIn, 'sign', 'signature'));

    zoomIn.addEventListener('input', () => {
      zoom = +zoomIn.value / 100;
      paint(stage);
    });

    applyBtn.addEventListener('click', async () => {
      const out = document.createElement('canvas');
      out.width = W; out.height = H;
      paint(out);

      const toBlob = (quality) => new Promise((res) => out.toBlob(res, 'image/jpeg', quality));
      let lo = 0.05, hi = 1, best = null;
      for (let i = 0; i < 12; i++) {
        const mid = (lo + hi) / 2;
        const blob = await toBlob(mid);
        if (blob.size / 1024 > MAX) hi = mid;
        else { best = blob; lo = mid; }
      }
      if (!best) best = await toBlob(0.05);

      const kb = best.size / 1024;
      const ok = kb <= MAX && kb >= MIN;

      if (outURL) URL.revokeObjectURL(outURL);
      outURL = URL.createObjectURL(best);
      outImg.src = outURL;
      meta.textContent = W + ' × ' + H + ' px · ' + kb.toFixed(0) + ' KB';

      if (ok) {
        verdict.className = 'cb-verdict mt-3 rounded bg-pass-bg px-3 py-3 text-sm font-semibold text-pass';
        verdict.textContent = '✓ Perfect match — meets all requirements for this exam.';
      } else if (kb < MIN) {
        verdict.className = 'cb-verdict mt-3 rounded bg-amber-100 px-3 py-3 text-sm';
        verdict.textContent = 'Size is ' + kb.toFixed(0) + ' KB, below the ' + MIN + ' KB minimum. Most portals still accept this.';
      } else {
        verdict.className = 'cb-verdict mt-3 rounded bg-fail-bg px-3 py-3 text-sm text-fail';
        verdict.textContent = 'Could not get under ' + MAX + ' KB. Try a plainer background.';
      }

      dl.href = outURL;
      dl.download = NAME + '.jpg';
      dl.textContent = 'Download ' + NAME + '.jpg';

      edit.hidden = true;
      done.hidden = false;
    });

    againBtn.addEventListener('click', () => {
      photoBmp = null; signBmp = null;
      photoIn.value = ''; signIn.value = '';
      photoName.textContent = 'Tap to choose';
      signName.textContent = 'Tap to choose';
      edit.hidden = true; done.hidden = true; err.hidden = true;
    });
  }

  document.querySelectorAll('.cb').forEach(initCb);
</script>