---
const {
  label = "Photo",
  widthPx = null,
  heightPx = null,
  minKB = 20,
  maxKB = 50,
  fileName = "photo",
  editable = true,
  openByDefault = false,
  unit = "px",
  displayW = null,
  displayH = null,
  dpi = 300
} = Astro.props;

const hasSize = !!(widthPx && heightPx);
const boxW = hasSize ? ((displayW === null || displayW === undefined) ? widthPx : displayW) : '';
const boxH = hasSize ? ((displayH === null || displayH === undefined) ? heightPx : displayH) : '';
const unitLabel = unit === 'in' ? 'inch' : unit;

const targetLine = !hasSize
  ? `Any dimensions · ${minKB} to ${maxKB} KB · JPG`
  : (unit === 'px'
      ? `${widthPx} × ${heightPx} px · ${minKB} to ${maxKB} KB · JPG`
      : `${boxW} × ${boxH} ${unitLabel} · ${minKB} to ${maxKB} KB · JPG`);
---
<div class="rz rounded-lg border border-line bg-white"
     data-w={hasSize ? widthPx : 0} data-h={hasSize ? heightPx : 0}
     data-min={minKB} data-max={maxKB} data-name={fileName}
     data-unit={hasSize ? unit : 'px'} data-dw={boxW || 0} data-dh={boxH || 0} data-dpi={dpi}>

  <div class="border-b border-line bg-navy-100 px-4 py-3">
    <h3 class="text-base font-bold text-navy-900">{label} resizer</h3>
    <p class="rz-target mt-0.5 text-sm text-muted">{targetLine}</p>
    {hasSize && unit !== 'px' && (
      <p class="mt-0.5 text-xs text-muted">That is {widthPx} × {heightPx} pixels at {dpi} DPI.</p>
    )}
    {!hasSize && (
      <p class="mt-1 text-xs text-muted">This exam does not state pixel dimensions, so we keep your image as it is and only bring the file size into range.</p>
    )}
  </div>

  {editable && (
    <div class="border-b border-line bg-surface px-4 py-3">
      <button type="button" class="rz-toggle w-full rounded-md border-2 border-amber-500 bg-white px-4 py-2.5 text-sm font-bold text-amber-600 hover:bg-amber-100">
        Change size or units
      </button>

      <div class="rz-size mt-3" hidden={!openByDefault}>
        <div class="grid grid-cols-3 gap-2">
          <label class="block text-xs">
            <span class="text-muted">Width</span>
            <input type="number" class="rz-in-w mt-1 w-full rounded border border-line px-2 py-1.5 text-sm" value={boxW} min="0.1" step="any" placeholder="auto" />
          </label>
          <label class="block text-xs">
            <span class="text-muted">Height</span>
            <input type="number" class="rz-in-h mt-1 w-full rounded border border-line px-2 py-1.5 text-sm" value={boxH} min="0.1" step="any" placeholder="auto" />
          </label>
          <label class="block text-xs">
            <span class="text-muted">Unit</span>
            <select class="rz-unit mt-1 w-full rounded border border-line px-2 py-1.5 text-sm">
              <option value="px" selected={unit === 'px'}>px</option>
              <option value="cm" selected={unit === 'cm'}>cm</option>
              <option value="mm" selected={unit === 'mm'}>mm</option>
              <option value="in" selected={unit === 'in'}>inch</option>
            </select>
          </label>
        </div>

        <label class="rz-dpi-wrap mt-2 block text-xs" hidden={unit === 'px'}>
          <span class="text-muted">DPI (300 is standard for print sizes)</span>
          <input type="number" class="rz-dpi mt-1 w-full rounded border border-line px-2 py-1.5 text-sm" value={dpi} min="72" step="1" />
        </label>

        <div class="mt-2 grid grid-cols-2 gap-2">
          <label class="block text-xs">
            <span class="text-muted">Min KB</span>
            <input type="number" class="rz-in-min mt-1 w-full rounded border border-line px-2 py-1.5 text-sm" value={minKB} min="0" />
          </label>
          <label class="block text-xs">
            <span class="text-muted">Max KB</span>
            <input type="number" class="rz-in-max mt-1 w-full rounded border border-line px-2 py-1.5 text-sm" value={maxKB} min="1" />
          </label>
        </div>

        <button type="button" class="rz-apply-size mt-3 w-full rounded-md bg-navy-800 px-4 py-2 text-sm font-semibold text-white">
          Use these sizes
        </button>

        <p class="mt-2 text-xs text-muted">
          Leave width and height blank to keep your image at its own size and only
          change the file size. Always check against your official notification.
        </p>
      </div>
    </div>
  )}

  <div class="p-4">

    <div class="rz-pick">
      <label class="block cursor-pointer rounded-lg border-2 border-dashed border-amber-500 bg-amber-100 px-4 py-10 text-center transition hover:bg-amber-50 active:scale-[0.99]">
        <svg viewBox="0 0 24 24" class="mx-auto h-10 w-10 fill-none stroke-amber-600" stroke-width="1.8" aria-hidden="true">
          <path d="M12 16V4m0 0L8 8m4-4 4 4" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2" stroke-linecap="round"/>
        </svg>
        <span class="mt-3 block text-base font-bold text-navy-900">Tap to choose your {label.toLowerCase()}</span>
        <span class="mt-1 block text-xs text-navy-700">JPG, PNG or HEIC from your phone</span>
        <input type="file" accept="image/*" class="rz-file sr-only" />
      </label>
      <p class="mt-3 text-center text-xs text-muted">Processed on your device, nothing is uploaded</p>
    </div>

    <div class="rz-edit" hidden>
      <p class="rz-editnote mb-2 text-sm font-semibold text-navy-900">Drag to position, then resize</p>
      <div class="relative flex justify-center rounded bg-surface p-3">
        <canvas class="rz-stage touch-none cursor-move rounded border border-line" style="max-width:100%;height:auto;"></canvas>
        <div class="rz-hint pointer-events-none absolute inset-0 flex flex-col items-center justify-center gap-2">
          <div class="rz-hint-arrow flex items-center gap-2 rounded-full bg-navy-900/85 px-4 py-2 text-xs font-bold text-white">
            <span>&#8592;</span><span>Drag to move</span><span>&#8594;</span>
          </div>
        </div>
      </div>

      <div class="mt-4 space-y-3 text-sm">
        <label class="rz-zoom-wrap block">
          <span class="text-muted">Zoom</span>
          <input type="range" class="rz-zoom mt-1 w-full" min="100" max="300" value="100" />
        </label>
        <label class="block">
          <span class="text-muted">Brightness</span>
          <input type="range" class="rz-bright mt-1 w-full" min="60" max="160" value="100" />
        </label>
        <label class="block">
          <span class="text-muted">Contrast</span>
          <input type="range" class="rz-contrast mt-1 w-full" min="60" max="160" value="100" />
        </label>
      </div>

      <p class="rz-warn mt-3 rounded bg-amber-100 px-3 py-2 text-sm" hidden></p>

      <div class="mt-4 flex gap-2">
        <button type="button" class="rz-apply flex-1 rounded-md bg-amber-600 px-5 py-3 text-sm font-semibold text-white">Resize now</button>
        <button type="button" class="rz-reset rounded-md border border-line px-4 py-3 text-sm font-semibold text-navy-700">Choose another</button>
      </div>
    </div>

    <div class="rz-done" hidden>
      <div class="grid grid-cols-2 gap-3">
        <div class="rounded border border-line p-2 text-center">
          <p class="mb-2 text-xs font-semibold text-muted">Original</p>
          <img class="rz-orig mx-auto max-h-36 w-auto rounded" alt="" />
          <p class="rz-orig-meta mt-2 text-xs text-muted"></p>
        </div>
        <div class="rounded border-2 border-pass p-2 text-center">
          <p class="mb-2 text-xs font-semibold text-pass">Ready</p>
          <img class="rz-out mx-auto max-h-36 w-auto rounded" alt="" />
          <p class="rz-out-meta mt-2 text-xs font-semibold text-pass"></p>
        </div>
      </div>

      <div class="rz-verdict mt-4 rounded px-3 py-3 text-sm"></div>

      <a class="rz-dl mt-4 block rounded-md bg-amber-600 px-5 py-3 text-center text-sm font-semibold text-white" download>Download</a>
      <button type="button" class="rz-again mt-2 w-full rounded-md border border-line px-4 py-2.5 text-sm font-semibold text-navy-700">Process another</button>
    </div>

    <p class="rz-err mt-3 rounded bg-fail-bg px-3 py-2 text-sm text-fail" hidden></p>
  </div>
</div>

<script>
  function initRz(root) {
    let W = +root.dataset.w;
    let H = +root.dataset.h;
    let MIN = +root.dataset.min;
    let MAX = +root.dataset.max;
    let UNIT = root.dataset.unit || 'px';
    let DW = +root.dataset.dw;
    let DH = +root.dataset.dh;
    let DPI = +root.dataset.dpi || 300;
    let FIXED = W > 0 && H > 0;
    const NAME = root.dataset.name || 'photo';

    const q = (s) => root.querySelector(s);
    const pick = q('.rz-pick'), edit = q('.rz-edit'), done = q('.rz-done');
    const fileIn = q('.rz-file'), stage = q('.rz-stage');
    const zoomIn = q('.rz-zoom'), zoomWrap = q('.rz-zoom-wrap');
    const brightIn = q('.rz-bright'), contrastIn = q('.rz-contrast');
    const applyBtn = q('.rz-apply'), resetBtn = q('.rz-reset'), againBtn = q('.rz-again');
    const warn = q('.rz-warn'), err = q('.rz-err');
    const origImg = q('.rz-orig'), outImg = q('.rz-out');
    const origMeta = q('.rz-orig-meta'), outMeta = q('.rz-out-meta');
    const verdict = q('.rz-verdict'), dl = q('.rz-dl');
    const target = q('.rz-target'), editnote = q('.rz-editnote');
    const hint = q('.rz-hint');

    const toggle = q('.rz-toggle'), sizePanel = q('.rz-size');
    const inW = q('.rz-in-w'), inH = q('.rz-in-h'), unitSel = q('.rz-unit');
    const dpiWrap = q('.rz-dpi-wrap'), dpiIn = q('.rz-dpi');
    const inMin = q('.rz-in-min'), inMax = q('.rz-in-max');
    const applySize = q('.rz-apply-size');

    let bmp = null, base = 1, zoom = 1, ox = 0, oy = 0;
    let origURL = null, outURL = null;

    function unitName(u) { return u === 'in' ? 'inch' : u; }

    function updateTarget() {
      if (!FIXED) {
        target.textContent = 'Any dimensions - ' + MIN + ' to ' + MAX + ' KB - JPG';
      } else if (UNIT === 'px') {
        target.textContent = W + ' x ' + H + ' px - ' + MIN + ' to ' + MAX + ' KB - JPG';
      } else {
        target.textContent = DW + ' x ' + DH + ' ' + unitName(UNIT) + ' - ' + MIN + ' to ' + MAX + ' KB - JPG';
      }
    }

    function applyMode() {
      if (FIXED) {
        stage.width = W;
        stage.height = H;
        if (editnote) editnote.textContent = 'Drag to position, then resize';
        if (zoomWrap) zoomWrap.hidden = false;
        if (hint) hint.classList.remove('gone');
        stage.classList.add('cursor-move');
      } else {
        if (bmp) { W = bmp.width; H = bmp.height; }
        stage.width = W || 1;
        stage.height = H || 1;
        if (editnote) editnote.textContent = 'Your image is kept at its own size. Adjust brightness if needed.';
        if (zoomWrap) zoomWrap.hidden = true;
        if (hint) hint.classList.add('gone');
        stage.classList.remove('cursor-move');
      }
    }

    if (toggle) {
      toggle.addEventListener('click', () => { sizePanel.hidden = !sizePanel.hidden; });
      unitSel.addEventListener('change', () => { dpiWrap.hidden = unitSel.value === 'px'; });

      applySize.addEventListener('click', () => {
        MIN = Math.max(0, +inMin.value || 0);
        MAX = Math.max(1, +inMax.value || 1);

        const rawW = +inW.value, rawH = +inH.value;

        if (!rawW || !rawH) {
          FIXED = false;
          if (bmp) { W = bmp.width; H = bmp.height; }
        } else {
          const u = unitSel.value;
          const d = +dpiIn.value || 300;
          let pxW = rawW, pxH = rawH;
          if (u === 'cm') { pxW = rawW / 2.54 * d; pxH = rawH / 2.54 * d; }
          else if (u === 'mm') { pxW = rawW / 25.4 * d; pxH = rawH / 25.4 * d; }
          else if (u === 'in') { pxW = rawW * d; pxH = rawH * d; }
          W = Math.max(1, Math.round(pxW));
          H = Math.max(1, Math.round(pxH));
          UNIT = u; DW = rawW; DH = rawH; DPI = d;
          FIXED = true;
        }

        applyMode();
        updateTarget();

        if (bmp) {
          base = FIXED ? Math.max(W / bmp.width, H / bmp.height) : 1;
          zoom = 1;
          zoomIn.value = 100;
          ox = (W - bmp.width * base) / 2;
          oy = (H - bmp.height * base) / 2;
          render();
        }
        sizePanel.hidden = true;
      });
    }

    function clamp() {
      if (!FIXED) { ox = 0; oy = 0; return; }
      const dw = bmp.width * base * zoom;
      const dh = bmp.height * base * zoom;
      ox = Math.min(0, Math.max(W - dw, ox));
      oy = Math.min(0, Math.max(H - dh, oy));
    }

    function paint(canvas) {
      const c = canvas.getContext('2d');
      c.filter = 'none';
      c.fillStyle = '#ffffff';
      c.fillRect(0, 0, W, H);
      c.filter = 'brightness(' + brightIn.value + '%) contrast(' + contrastIn.value + '%)';
      c.drawImage(bmp, ox, oy, bmp.width * base * zoom, bmp.height * base * zoom);
      c.filter = 'none';
    }

    function render() { clamp(); paint(stage); }

    fileIn.addEventListener('change', async (e) => {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      err.hidden = true;
      warn.hidden = true;

      try {
        bmp = await createImageBitmap(file);
        const origKB = file.size / 1024;
        if (origURL) URL.revokeObjectURL(origURL);
        origURL = URL.createObjectURL(file);
        origImg.src = origURL;
        origMeta.textContent = bmp.width + ' x ' + bmp.height + ' px - ' + origKB.toFixed(0) + ' KB';

        applyMode();

        base = FIXED ? Math.max(W / bmp.width, H / bmp.height) : 1;
        zoom = 1;
        zoomIn.value = 100;
        brightIn.value = 100;
        contrastIn.value = 100;
        ox = (W - bmp.width * base) / 2;
        oy = (H - bmp.height * base) / 2;
        render();

        if (FIXED && (bmp.width < W || bmp.height < H)) {
          warn.textContent = 'This image is smaller than the required size, so it may look stretched or blurry. Use a sharper original if you have one.';
          warn.hidden = false;
        }

        pick.hidden = true;
        edit.hidden = false;
        done.hidden = true;
      } catch (ex) {
        err.textContent = 'Could not read that image. Try a JPG or PNG file.';
        err.hidden = false;
      }
    });

    let drag = false, lx = 0, ly = 0;
    stage.addEventListener('pointerdown', (e) => {
      if (!FIXED) return;
      drag = true; stage.setPointerCapture(e.pointerId);
      lx = e.clientX; ly = e.clientY;
      if (hint) hint.classList.add('gone');
    });
    stage.addEventListener('pointermove', (e) => {
      if (!drag || !bmp || !FIXED) return;
      const r = stage.getBoundingClientRect();
      const k = stage.width / r.width;
      ox += (e.clientX - lx) * k;
      oy += (e.clientY - ly) * k;
      lx = e.clientX; ly = e.clientY;
      render();
    });
    stage.addEventListener('pointerup', () => { drag = false; });
    stage.addEventListener('pointercancel', () => { drag = false; });

    zoomIn.addEventListener('input', () => {
      if (!bmp || !FIXED) return;
      const prev = zoom;
      zoom = +zoomIn.value / 100;
      const cx = (W / 2 - ox) / prev;
      const cy = (H / 2 - oy) / prev;
      ox = W / 2 - cx * zoom;
      oy = H / 2 - cy * zoom;
      render();
    });

    brightIn.addEventListener('input', render);
    contrastIn.addEventListener('input', render);

    applyBtn.addEventListener('click', async () => {
      if (!bmp) return;
      const out = document.createElement('canvas');
      out.width = W; out.height = H;
      paint(out);

      const toBlob = (quality) => new Promise((res) => out.toBlob(res, 'image/jpeg', quality));

      let lo = 0.05, hi = 1, best = null;
      for (let i = 0; i < 12; i++) {
        const mid = (lo + hi) / 2;
        const blob = await toBlob(mid);
        if (blob.size / 1024 > MAX) hi = mid;
        else { best = blob; lo = mid; }
      }
      if (!best) best = await toBlob(0.05);

      const kb = best.size / 1024;
      const ok = kb <= MAX && kb >= MIN;

      if (outURL) URL.revokeObjectURL(outURL);
      outURL = URL.createObjectURL(best);
      outImg.src = outURL;

      if (!FIXED) {
        outMeta.textContent = W + ' x ' + H + ' px - ' + kb.toFixed(0) + ' KB';
      } else if (UNIT === 'px') {
        outMeta.textContent = W + ' x ' + H + ' px - ' + kb.toFixed(0) + ' KB';
      } else {
        outMeta.textContent = DW + ' x ' + DH + ' ' + unitName(UNIT) + ' - ' + kb.toFixed(0) + ' KB';
      }

      if (ok) {
        verdict.className = 'rz-verdict mt-4 rounded bg-pass-bg px-3 py-3 text-sm font-semibold text-pass';
        verdict.textContent = 'Perfect match, meets the size you set.';
      } else if (kb < MIN) {
        verdict.className = 'rz-verdict mt-4 rounded bg-amber-100 px-3 py-3 text-sm';
        verdict.textContent = 'Size is ' + kb.toFixed(0) + ' KB, below the ' + MIN + ' KB minimum. Most portals still accept this, but a sharper original would push it higher.';
      } else {
        verdict.className = 'rz-verdict mt-4 rounded bg-fail-bg px-3 py-3 text-sm text-fail';
        verdict.textContent = 'Could not get under ' + MAX + ' KB. Try a simpler background or a less detailed image.';
      }

      dl.href = outURL;
      dl.download = NAME + '.jpg';
      dl.textContent = 'Download ' + NAME + '.jpg';

      edit.hidden = true;
      done.hidden = false;
    });

    function reset() {
      bmp = null;
      fileIn.value = '';
      pick.hidden = false;
      edit.hidden = true;
      done.hidden = true;
      warn.hidden = true;
      err.hidden = true;
    }
    resetBtn.addEventListener('click', reset);
    againBtn.addEventListener('click', reset);

    applyMode();
    updateTarget();
  }

  document.querySelectorAll('.rz').forEach(initRz);
</script>

<style>
  @keyframes rzSlide {
    0%, 100% { transform: translateX(-14px); opacity: .85; }
    50% { transform: translateX(14px); opacity: 1; }
  }
  .rz-hint-arrow { animation: rzSlide 1.6s ease-in-out infinite; }
  .rz-hint { transition: opacity .4s; }
  .rz-hint.gone { opacity: 0; }
</style>